{
  "name": "port-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:content": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check:content && npm test && npm run build && npm run check:links"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
