{
  "name": "port-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/build-search-index.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check:content": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check:content && npm run check:visuals && npm run check:experiences && npm run check:cargo && npm run check:infrastructure && npm run check:risks && npm run check:vessels && npm run check:learning && npm run check:berthing && npm run check:foundations && npm run check:brands-ports && npm test && npm run build && npm run check:links",
    "check:visuals": "node scripts/check-visuals.mjs",
    "check:experiences": "node scripts/check-experiences.mjs",
    "check:cargo": "node scripts/check-cargo.mjs",
    "check:infrastructure": "node scripts/check-infrastructure.mjs",
    "check:risks": "node scripts/check-risks.mjs",
    "check:vessels": "node scripts/check-vessels.mjs",
    "check:learning": "node scripts/check-learning.mjs",
    "check:berthing": "node scripts/check-berthing.mjs",
    "test:browser": "playwright test",
    "check:foundations": "node scripts/check-foundations.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:brands-ports": "node scripts/check-brands-ports.mjs"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "parse5": "^8.1.1"
  }
}
