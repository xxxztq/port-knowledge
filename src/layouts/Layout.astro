---
import '../styles/global.css';
import LearningActions from '../components/LearningActions.astro';
import '../styles/visual.css';
import '../styles/journey.css';
import '../styles/cargo.css';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
const { title = '看懂港口', description = '从一票货、一台设备、一个岗位，读懂港口如何运转。', active = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (p = '') => base + p;
const nav = [['home','认识港口',''],['knowledge-map','知识地图','knowledge-map/'],['journey','互动旅程','shipment/'],['flows','业务流程','flows/'],['cargo','箱型与货类','cargo/'],['vessels','船型图鉴','vessels/'],['roles','角色协作','roles/'],['equipment','设备图鉴','equipment/'],['systems','港口系统','systems/'],['gate','闸口与监管','gate/'],['economics','经营逻辑','economics/'],['library','知识百科','library/']];
const pagePath = Astro.url.pathname === base || Astro.url.pathname === base.slice(0, -1)
  ? ''
  : Astro.url.pathname.startsWith(base)
    ? Astro.url.pathname.slice(base.length)
    : Astro.url.pathname.replace(/^\/+/, '');
const isNotFound = /^404(?:\.html|\/)?$/.test(pagePath);
const hasLearning = !isNotFound && !['', 'library/', 'about/', 'knowledge-map/'].includes(pagePath);
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const siteUrl = new URL(base, site);
const sectionLabels: Record<string, string> = {
  shipment: '互动旅程',
  flows: '业务流程',
  scenarios: '业务流程',
  cargo: '箱型与货类',
  roles: '角色协作',
  equipment: '设备图鉴',
  systems: '港口系统',
  gate: '闸口与监管',
  economics: '经营逻辑',
  library: '知识百科',
  knowledge: '知识百科',
  'knowledge-map': '知识地图',
  foundations: '港口基础专题',
  infrastructure: '港口基础设施',
  risks: '风险与预防',
  vessels: '船型图鉴',
  berthing: '进港与靠泊',
  documents: '单证图解',
  containers: '集装箱基础',
  brands: '箱体品牌与港航公司',
  'brands-and-ports': '港口与港航主体',
  about: '来源与范围',
};
const isHome = pagePath === '';
const pathSegments = pagePath.split('/').filter(Boolean);
const section = pathSegments[0];
const breadcrumbParents: Record<string, string> = { knowledge: 'library', scenarios: 'flows' };
const articleSections = new Set(['knowledge', 'scenarios', 'cargo', 'foundations', 'infrastructure', 'risks', 'vessels']);
const isArticle = pathSegments.length > 1 && articleSections.has(section);
const breadcrumbs = isHome || isNotFound ? [] : [
  { name: '首页', url: siteUrl.href },
  ...(pathSegments.length > 1 && sectionLabels[section] ? [{
    name: sectionLabels[section],
    url: new URL((breadcrumbParents[section] ?? section) + '/', siteUrl).href,
  }] : []),
  { name: title, url: canonical.href },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: '看懂港口',
      description: '从一票货、一台设备、一个岗位，读懂港口如何运转。',
      inLanguage: 'zh-CN',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      ...(breadcrumbs.length > 0 ? { breadcrumb: { '@id': `${canonical.href}#breadcrumb` } } : {}),
      isPartOf: { '@id': `${siteUrl.href}#website` },
      inLanguage: 'zh-CN',
    },
    ...(breadcrumbs.length > 0 ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical.href}#breadcrumb`,
      itemListElement: breadcrumbs.map((item, position) => ({
        '@type': 'ListItem',
        position: position + 1,
        name: item.name,
        item: item.url,
      })),
    }] : []),
    ...(isArticle ? [{
      '@type': 'Article',
      '@id': `${canonical.href}#article`,
      url: canonical.href,
      headline: title,
      description,
      mainEntityOfPage: { '@id': `${canonical.href}#webpage` },
      isPartOf: { '@id': `${siteUrl.href}#website` },
      articleSection: breadcrumbs[1]?.name ?? '港口知识',
      inLanguage: 'zh-CN',
    }] : []),
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
const fullTitle = title === '看懂港口' ? '看懂港口 · 从靠岸到交付' : `${title} · 看懂港口`;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#103d47"/><meta name="color-scheme" content="light"/><title>{fullTitle}</title><link rel="icon" type="image/svg+xml" href={href('favicon.svg')}/>{isNotFound ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={canonical}/>}<meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={isArticle ? "article" : "website"}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(href("brand/social-card.png"),site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="apple-touch-icon" href={href("brand/apple-touch-icon.png")}/>{!isNotFound && <script type="application/ld+json" set:html={structuredDataJson}></script>}</head><body data-base={base}>
<a class="skip" href="#main">跳到主要内容</a>
<header class="site-header">
  <div class="nav-wrap">
    <Brand/>
    <div class="nav-actions nav-actions--compact">
      <a class="icon-button" href={href('library/')} aria-label="搜索港口知识"><Icon name="search"/></a>
      <button type="button" class="icon-button mobile-toggle" aria-controls="site-navigation" aria-label="展开导航" aria-expanded="false"><Icon name="menu"/></button>
    </div>
    <nav id="site-navigation" class="main-nav" aria-label="主要导航">
      {nav.map(([key,label,url]) => <a href={href(url)} aria-current={active === key || (key === 'knowledge-map' && pagePath.startsWith('knowledge-map')) || (key === 'vessels' && section === 'vessels') ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-actions nav-actions--wide">
      <a class="icon-button" href={href('library/')} aria-label="搜索港口知识"><Icon name="search"/></a>
    </div>
  </div>
</header>
<main id="main">{hasLearning && <LearningActions path={Astro.url.pathname} title={title}/>}<slot/></main>
<footer class="site-footer"><div class="footer-inner"><div><Brand compact/><p>把复杂的港口，讲成看得懂的日常。</p></div><div class="footer-links"><a href={href('knowledge-map/')}>知识地图</a><a href={href('foundations/')}>港口基础专题</a><a href={href('cargo/')}>箱型与货类</a><a href={href('vessels/')}>船型图鉴</a><a href={href('berthing/')}>进港与靠泊</a><a href={href('cargo/minerals/')}>矿产与干散货</a><a href={href('cargo/grains/')}>粮食业务</a><a href={href('cargo/liquids/')}>液体货类</a><a href={href('shipment/')}>一票货全程</a><a href={href('documents/')}>单证图解</a><a href={href('risks/')}>风险与预防</a><a href={href('systems/')}>港口系统</a><a href={href('about/')}>来源与范围</a><a href="https://github.com/xxxztq/port-knowledge" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></div><div class="footer-bottom"><span>由 xxxztq 建立 · 中文港口知识手册</span><span>教学示意与企业案例分别标注 · 内容核查 2026.11</span></div></footer>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script>
function initNavigation(toggle: HTMLButtonElement, navigation: HTMLElement) {
  // Keep this breakpoint aligned with the collapsed navigation styles.
  const compact = window.matchMedia('(max-width: 1180px)');
  const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

  function setOpen(open: boolean, returnFocus = false) {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '收起导航' : '展开导航');
    navigation.classList.toggle('is-open', open);
    if (returnFocus) toggle.focus();
  }

  toggle.addEventListener('click', () => {
    const open = isOpen();
    if (!open && document.activeElement !== toggle) toggle.focus();
    setOpen(!open, open);
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape' || event.defaultPrevented || !isOpen()) return;
    event.preventDefault();
    setOpen(false, true);
  });
  document.addEventListener('focusin', event => {
    if (isOpen() && event.target instanceof Node && !toggle.contains(event.target) && !navigation.contains(event.target)) {
      setOpen(false);
    }
  });
  navigation.addEventListener('click', event => {
    if (isOpen() && event.target instanceof Element && event.target.closest('a')) {
      setOpen(false, navigation.contains(document.activeElement));
    }
  });
  compact.addEventListener('change', () => setOpen(false));
  window.addEventListener('pageshow', () => setOpen(false, isOpen() && navigation.contains(document.activeElement)));
}

const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle');
const navigation = document.querySelector<HTMLElement>('#site-navigation');
if (toggle && navigation) initNavigation(toggle, navigation);
</script>
</body></html>
<style>
  /* Each layout keeps its visual order and only exposes one search link to the keyboard. */
  .nav-actions--compact { display: none; }
  @media (min-width: 1181px) and (max-width: 1500px) {
    .main-nav { gap: 16px; }
  }
  @media (max-width: 1180px) {
    .nav-actions--compact { display: flex; }
    .main-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; height: auto; max-height: calc(100dvh - 88px); overflow-y: auto; overscroll-behavior: contain; background: #f8faf6; border-bottom: 1px solid var(--line); padding: 18px 30px; flex-wrap: wrap; gap: 12px 22px; }
    .main-nav.is-open { display: flex; }
    .main-nav a { height: auto; padding: 7px 0; }
    .main-nav a[aria-current]:after { bottom: 0; }
    .nav-actions--wide { display: none; }
    .main-nav.is-open { max-height: calc(100dvh - 88px); overflow-y: auto; overscroll-behavior: contain; }
    .site-header :is(a, button):focus-visible { outline-color: #365953; }
  }
  @media (max-width: 1180px) and (max-height: 420px) {
    .main-nav.is-open {
      bottom: max(8px, env(safe-area-inset-bottom));
      max-height: none;
      align-content: flex-start;
    }
  }
</style>
