---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HarborJourneyMap from '../components/HarborJourneyMap.astro';
import { importJourney, journeyExceptions } from '../data/container-journey.js';
import { equipmentVisuals } from '../data/equipment-visuals.js';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const layers=[{id:'cargo',name:'货物路线',hint:'点击地图编号或下方站点，查看集装箱的位置与交接。工厂拆箱后，货物和箱体走向不同的后续。'},{id:'equipment',name:'设备分工',hint:'点击设备标签查看结构图。岸桥、场桥、集卡与闸口设备分别承担不同环节。'},{id:'systems',name:'系统与信息',hint:'实物位置与系统记录需要对应。连线仅示意信息关系，外部状态通过适用渠道取得，不代表固定网络部署。'}];
---
<Layout title="集装箱的一程" active="journey" description="跟着一票进口机床，在可点击地图上观察集装箱、岗位、单证和系统如何交接。"><div class="container journey-page" data-journey-app><header class="journey-intro"><div><div class="eyebrow">A CONTAINER'S JOURNEY / 互动业务导览</div><h1>一只箱子，走过一座港口。</h1><p>一票进口机床，从船上到工厂；机床交付后，空箱还有自己的下一程。<br class="desktop-only"/>切换地图的三个图层，看清实物、设备与系统如何配合。</p></div><a class="journey-system-entry" href={base+'systems/'}><Icon name="grid" size={22}/><span>港口背后的系统<small>TOS、件杂货、海关与口岸 ↗</small></span></a></header>
<div class="journey-casebar"><div><span class="case-label">本次教学任务</span><strong>进口机床 / 示例箱 A</strong></div><span>普通干货整箱</span><span>公路提离</span><span class="case-demo">虚构案例 · 无真实系统连接</span><button type="button" class="journey-reset" data-journey-action="reset">从头开始 ↺</button></div>
<div class="journey-workbench"><section class="journey-map-panel" id="journey-map" aria-label="分层港口地图"><div class="journey-map-controls"><div class="journey-layer-tabs" aria-label="选择地图图层">{layers.map((l,i)=><button data-journey-layer={l.id} type="button" aria-pressed={i===0?'true':'false'}>{l.name}</button>)}</div><span class="journey-map-counter"><b data-current-number>01</b> / 07</span></div><HarborJourneyMap/><div class="journey-layer-caption" aria-live="polite">{layers.map((l,i)=><p data-layer-caption={l.id} hidden={i!==0}>{l.hint}</p>)}</div><div class="journey-status-lines" aria-label="当前场景摘要">{importJourney.steps.map((s,i)=><dl class="journey-status-panel" data-step-status={i} hidden={i!==0}><div><dt><span>01</span>实物</dt><dd>{s.cargoState}</dd></div><div><dt><span>02</span>单证</dt><dd>{s.documentState}</dd></div><div><dt><span>03</span>系统</dt><dd>{s.systemEvent}</dd></div></dl>)}</div><div class="journey-map-bottom"><span>地图展示本教学场景，非实际港区布局。</span><a href="#journey-detail">看本步说明 ↓</a></div></section>
<section class="journey-detail-panel" id="journey-detail" aria-label="当前步骤说明"><div class="journey-detail-controls"><p class="journey-live-position" aria-live="polite" aria-atomic="true">第 1 站 / 共 7 站</p><button type="button" class="journey-detail-toggle" data-toggle-detail aria-pressed="false">展开业务细节 ＋</button></div>
{importJourney.steps.map((s,i)=>{const visual=equipmentVisuals.find(v=>v.id===s.equipmentId);const exceptions=journeyExceptions.filter(e=>e.stepId===s.id);return <article class="journey-step-panel" data-journey-panel={i} hidden={i!==0}><div class="journey-location"><span class="journey-location-dot"></span>{s.location}</div><h2>{s.title}</h2><p class="journey-step-summary">{s.summary}</p><div class="journey-handoff"><div><span>谁来接手</span><strong>{s.actor}</strong></div><a href={base+'systems/#system-'+s.systemId}><span>这一站涉及的系统</span><strong>{s.systemLabel} ↗</strong></a></div><p class="journey-action">{s.action}</p><div class="journey-business-detail" hidden><dl><div><dt>收到什么</dt><dd>{s.input}</dd></div><div><dt>重点校验</dt><dd><ul>{s.checks.map(check=><li>{check}</li>)}</ul></dd></div><div><dt>交出什么</dt><dd>{s.output}</dd></div><div><dt>服务与费用</dt><dd>{s.costNote}</dd></div></dl></div>{visual&&<a class="journey-equipment-preview" href={base+'knowledge/'+visual.id+'/'}><img src={base+visual.image} width="800" height="480" alt={visual.shortName+'结构示意'} loading="lazy"/><div><span>认识这一步的设备</span><strong>{visual.shortName} ↗</strong></div></a>}
{exceptions.map(e=><div class="journey-challenge-launch"><span>这一站也可能卡住</span><button type="button" data-challenge-start={e.id}>{e.title}<span aria-hidden="true">↗</span></button></div>)}<a class="journey-related" href={base+'knowledge/'+s.articleId+'/'}>读这一环的完整知识卡 <Icon name="arrow" size={14}/></a></article>})}
{journeyExceptions.map(e=><section class="journey-challenge" data-challenge-panel={e.id} hidden aria-labelledby={'challenge-'+e.id}><div class="challenge-header"><span>异常演练</span><button type="button" data-challenge-exit>退出演练</button></div><h3 id={'challenge-'+e.id}>{e.title}</h3><p>{e.description}</p><div class="challenge-choices">{e.choices.map(c=><button type="button" data-challenge-choice={c.id} data-challenge-owner={e.id} aria-pressed="false">{c.label}</button>)}</div><div class="challenge-feedback" role="status" aria-live="polite" aria-atomic="true"></div><p class="challenge-resolution" hidden>{e.resolution}</p></section>)}
<div class="journey-navigation"><button type="button" class="button outline" data-journey-action="previous" disabled>← 上一站</button><button type="button" class="button primary" data-journey-action="next">查看下一站 <Icon name="arrow" size={16}/></button></div><p class="journey-block-reason" role="status" hidden></p><p class="journey-session-feedback" role="status" aria-live="polite" hidden></p><p class="journey-model-note">点击推进教学场景；实际作业仍需对应主体确认。涉及的系统只是本步观察重点，各项条件可并行变化。</p></section></div>
<nav class="journey-stations" aria-label="七站旅程">{importJourney.steps.map((s,i)=><button type="button" data-journey-step={i} aria-pressed={i===0?'true':'false'}><span>{String(i+1).padStart(2,'0')}</span><strong>{s.title}</strong><small>{s.location}</small></button>)}</nav>
<section class="journey-finish" hidden aria-live="polite"><span class="eyebrow">END OF THIS ROUTE / 本次旅程收尾</span><h2>货物交付了，箱体也有了去向。</h2><p>这条教学路线走到终点。你可以回看任意一站，也可以继续探索港口系统或出口流程。</p><div><a class="button primary" href={base+'systems/'}>看看信息怎样接上 <Icon name="arrow" size={16}/></a><a class="button outline" href={base+'scenarios/export-full-container/'}>继续看出口流程</a></div></section>
<noscript><section class="journey-noscript"><h2>本条路线的文字导览</h2><p>启用 JavaScript 后可以使用地图和异常选择；以下为完整步骤概要。</p><ol>{importJourney.steps.map(s=><li><strong>{s.title} · {s.actor}</strong><p>{s.action}</p><a href={base+'knowledge/'+s.articleId+'/'}>继续阅读这一环 →</a></li>)}</ol></section></noscript>
<div class="journey-followups"><a href={base+'systems/'}><span>01 / 信息怎样接力</span><h3>集装箱系统、件杂货系统与外部对接</h3><p>从业务对象到信息交换，分清各套系统的职责与边界。</p><b aria-hidden="true">↗</b></a><a href={base+'gate/'}><span>02 / 放行之后呢</span><h3>授权、抬杆、通行与回执</h3><p>继续操作闸口模拟器，看四个阶段怎样分别确认。</p><b aria-hidden="true">↗</b></a></div><details class="journey-scope"><summary>查看教学范围与参考来源</summary><p>{importJourney.scope}</p><p>{importJourney.note}</p><ul>{importJourney.sourceUrls.map((url,i)=><li><a href={url} target="_blank" rel="noopener noreferrer">参考来源 {i+1} · {new URL(url).hostname} ↗</a></li>)}</ul></details></div>
<script>
import {importJourney} from '../data/container-journey.js';
import {createJourneyState,transitionJourney,getCurrentStep,getCurrentException,canAdvance} from '../lib/journey-model.mjs';
const app=document.querySelector<HTMLElement>('[data-journey-app]')!;let state=createJourneyState();let detailed=false;
function render(){const step=getCurrentStep(state)!;const exception=getCurrentException(state);const blocked=!!exception&&!state.resolved;app.querySelectorAll<HTMLElement>('[data-journey-panel]').forEach(p=>p.hidden=Number(p.dataset.journeyPanel)!==state.stepIndex);app.querySelectorAll<HTMLElement>('[data-step-status]').forEach(p=>p.hidden=Number(p.dataset.stepStatus)!==state.stepIndex);app.querySelectorAll<HTMLButtonElement>('[data-journey-step]').forEach(b=>{const index=Number(b.dataset.journeyStep);b.setAttribute('aria-pressed',String(index===state.stepIndex));b.disabled=blocked&&index>state.stepIndex;b.classList.toggle('journey-step-past',index<state.stepIndex);});app.querySelector('[data-current-number]')!.textContent=String(state.stepIndex+1).padStart(2,'0');app.querySelector('.journey-live-position')!.textContent='第 '+(state.stepIndex+1)+' 站 / 共 '+importJourney.steps.length+' 站 · '+step.title;const point=app.querySelector<HTMLElement>('.journey-spot[data-journey-step="'+state.stepIndex+'"]');const box=app.querySelector<HTMLElement>('.journey-moving-box')!;if(point){box.style.left=point.dataset.mapX+'%';box.style.top=point.dataset.mapY+'%';}app.querySelectorAll<HTMLElement>('[data-challenge-panel]').forEach(p=>{const active=p.dataset.challengePanel===exception?.id;p.hidden=!active;if(active){p.querySelector('.challenge-feedback')!.textContent=exception?.choices.find(c=>c.id===state.choiceId)?.feedback||state.feedback||'先选择处理方式，再继续下一站。';p.classList.toggle('is-resolved',state.resolved);(p.querySelector('.challenge-resolution') as HTMLElement).hidden=!state.resolved;}});app.querySelectorAll<HTMLButtonElement>('[data-challenge-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.challengeOwner===state.exceptionId&&b.dataset.challengeChoice===state.choiceId)));app.querySelectorAll<HTMLButtonElement>('[data-challenge-start]').forEach(b=>b.disabled=!!exception);const previous=app.querySelector<HTMLButtonElement>('[data-journey-action="previous"]')!;previous.disabled=state.stepIndex===0;const next=app.querySelector<HTMLButtonElement>('[data-journey-action="next"]')!;next.disabled=!canAdvance(state)||state.completed;next.textContent=state.completed?'已到本次路线终点':state.stepIndex===importJourney.steps.length-1?'查看旅程收尾 ✓':'查看下一站 →';const reason=app.querySelector<HTMLElement>('.journey-block-reason')!;reason.hidden=!blocked;reason.textContent=blocked?'异常尚未解决。请先完成本教学分支的处理，或退出异常演练。':'';app.querySelector<HTMLElement>('.journey-finish')!.hidden=!state.completed;const sessionFeedback=app.querySelector<HTMLElement>('.journey-session-feedback')!;sessionFeedback.hidden=!!exception||!state.feedback||state.feedback.startsWith('已切换到');sessionFeedback.textContent=state.feedback;app.querySelectorAll<HTMLElement>('.journey-business-detail').forEach(p=>p.hidden=!detailed);}
function dispatch(action:Parameters<typeof transitionJourney>[1]){const oldIndex=state.stepIndex;state=transitionJourney(state,action);render();const behavior=matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth';if(state.completed)app.querySelector('.journey-finish')?.scrollIntoView({behavior,block:'center'});else if(oldIndex!==state.stepIndex&&(action.type==='next'||action.type==='previous')&&matchMedia('(max-width:950px)').matches)app.querySelector('#journey-detail')?.scrollIntoView({behavior,block:'start'});}
app.querySelectorAll<HTMLButtonElement>('[data-journey-action]').forEach(b=>b.addEventListener('click',()=>dispatch({type:b.dataset.journeyAction!})));app.querySelectorAll<HTMLButtonElement>('[data-journey-step]').forEach(b=>b.addEventListener('click',()=>dispatch({type:'select-step',index:Number(b.dataset.journeyStep)})));app.querySelectorAll<HTMLButtonElement>('[data-challenge-start]').forEach(b=>b.addEventListener('click',()=>dispatch({type:'set-exception',id:b.dataset.challengeStart!})));app.querySelectorAll<HTMLButtonElement>('[data-challenge-exit]').forEach(b=>b.addEventListener('click',()=>dispatch({type:'set-exception',id:null})));app.querySelectorAll<HTMLButtonElement>('[data-challenge-choice]').forEach(b=>b.addEventListener('click',()=>dispatch({type:'answer',choiceId:b.dataset.challengeChoice!})));app.querySelector<HTMLButtonElement>('[data-toggle-detail]')!.addEventListener('click',e=>{detailed=!detailed;const b=e.currentTarget as HTMLButtonElement;b.setAttribute('aria-pressed',String(detailed));b.textContent=detailed?'收起业务细节 −':'展开业务细节 ＋';render();});app.querySelectorAll<HTMLButtonElement>('[data-journey-layer]').forEach(b=>b.addEventListener('click',()=>{app.querySelector<HTMLElement>('[data-journey-map]')!.dataset.layer=b.dataset.journeyLayer;app.querySelectorAll('[data-journey-layer]').forEach(other=>other.setAttribute('aria-pressed',String(other===b)));app.querySelectorAll<HTMLElement>('[data-layer-caption]').forEach(p=>p.hidden=p.dataset.layerCaption!==b.dataset.journeyLayer);}));render();
</script></Layout>
