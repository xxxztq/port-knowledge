---
import BerthingEntry from '../../components/BerthingEntry.astro';
import CustomsTransitScenario from '../../components/CustomsTransitScenario.astro';
import ScenarioExplorer from '../../components/ScenarioExplorer.astro';import ReadingProgress from '../../components/ReadingProgress.astro';import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import {scenarios} from '../../data/scenarios.js';
export function getStaticPaths(){return scenarios.map(scenario=>({params:{id:scenario.id},props:{scenario}}))}
const {scenario:s}=Astro.props;const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{s.id === 'customs-transit' ? <CustomsTransitScenario/> : <Layout title={s.title} description={s.summary} active="flows"><ReadingProgress/><div class="container"><div class="breadcrumbs"><a href={base}>首页</a><Icon name="chevron" size={12}/><a href={base+'flows/'}>业务流程</a><Icon name="chevron" size={12}/><span>{s.category}</span></div><div class="article-layout"><article class="article-body"><span class="tag">{s.category} · 教学场景</span><h1 class="article-title">{s.title}</h1><p class="article-summary">{s.summary}</p><div class="tag-list">{s.actors.map(a=><span class="tag">{a}</span>)}</div>{s.id==='import-full-container'&&<div class="systems-article-entry"><h2>在地图上走一遍这条路线</h2><p>观察箱子、岗位、单证与系统的变化，尝试三个异常处理分支。</p><a href={base+'journey/'}>打开七站互动旅程 →</a><a href={base+'import-container/'}>跟一只进口箱看单证、转关、闸口与结算 →</a></div>}{s.id==='vessel-berthing-coordination'&&<BerthingEntry compact/>}<ScenarioExplorer scenario={s}/><div class="timeline">{s.steps.map((step,i)=><section class="step-card" id={'step-'+i}><span class="step-number">{String(i+1).padStart(2,'0')}</span><div><span class="tag">{step.actor}</span><h2>{step.title}</h2><p>{step.action}</p><div class="step-details"><div><strong>收到什么</strong>{step.input}</div><div><strong>怎样核对</strong>{step.check}</div>{step.system && <div><strong>关联系统与记录</strong>{step.system}</div>}<div><strong>交出什么</strong>{step.output}</div></div><div class="exception"><strong>如果卡住</strong>{step.exception}</div></div></section>)}</div><div class="notice"><strong>适用范围与流程提示</strong><br/>{s.scope}<br/>{s.note}</div><section class="article-section"><h2>相关依据</h2><ul class="source-list">{s.sourceUrls.map((url,i)=><li><a href={url} target="_blank" rel="noopener noreferrer">官方参考 {i+1} · {new URL(url).hostname} ↗</a></li>)}</ul></section></article><aside class="article-aside"><div class="aside-box"><h3>沿着流程继续探索</h3><a href={base+'roles/'}>岗位怎么协作 →</a><a href={base+'equipment/'}>认识相关设备 →</a><a href={base+'gate/'}>闸口怎样校验 →</a><a href={base+'economics/'}>费用怎样形成 →</a></div><div class="aside-box"><h3>记住四个问题</h3><p>谁接手？<br/>收到什么？<br/>凭什么继续？<br/>异常交给谁？</p></div><a class="button outline" href={base+'flows/'}>查看其他场景 <Icon name="arrow" size={17}/></a></aside></div></div></Layout>}