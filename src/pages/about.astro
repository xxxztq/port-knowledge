---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import {domains,articles,sources} from '../data/knowledge.js';import {scenarios} from '../data/scenarios.js';const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="来源与范围" active="library"><PageIntro eyebrow="SCOPE & SOURCES" title="框架要完整，边界也要清楚。" description="这是一部持续完善的中文港口入门手册。用知识域组织全貌，用场景解释交接，用来源说明哪些是通用概念、哪些只是地方或企业做法。"/><div class="container page-content"><div class="fact-grid"><div><strong>{domains.length}</strong><span>知识领域</span></div><div><strong>{articles.length}</strong><span>入门知识卡</span></div><div><strong>{scenarios.length}</strong><span>业务场景</span></div></div><div class="notice">当前为持续更新的教学版本，本轮内容更新：2026 年 11 月 22 日；各来源的实际核查日期分别标注。已有领域概览与主要场景，但不声称覆盖全部例外、港口类型或专业规范。未经过码头、海关等机构的专业审定。</div><div class="cargo-search-shortcuts"><a href={base+'knowledge-map/'}>查看主题覆盖与学习路线 →</a><a href={base+'shipment/'}>体验一票货五条业务线 →</a></div><div class="two-column"><section class="panel"><h2>怎样阅读这份手册</h2><p>从首页认识空间，再选一条业务流程。遇到术语时进入知识卡，沿岗位、设备、单证、校验与异常继续阅读。互动旅程把实物、设备和系统串在一起，港口系统专题解释信息交接。闸口和经营页面用虚构输入演示逻辑。</p></section><section class="panel"><h2>资料和现实有差异时</h2><p>具体作业以适用法规、港口公告、合同与企业规程为准。企业指南仅说明该企业做法；国外资料用于概念或案例。来源核查日期表示资料整理口径，不代表文件在所有地方具有现行效力。</p></section></div>
<div class="section-heading section-top"><div><div class="eyebrow">24 KNOWLEDGE DOMAINS</div><h2>全貌如何组织</h2></div></div><div class="domain-overview">{domains.map((d,i)=><a href={base+'library/?domain='+d.id}><span class="eyebrow">{String(i+1).padStart(2,'0')}</span><h3>{d.title}</h3><p>{d.summary}</p><small>{articles.filter(a=>a.domain===d.id).length} 篇知识卡 · 点击阅读 →</small></a>)}</div>
<section class="section"><h2>参考资料登记</h2><p class="external-note">文章按主题引用下列资料；场景页面另附相应原始链接。<a href={base+'systems/#system-sources'}>港口系统专题的官方资料与范围说明 →</a>部分资料沿用前期方案核对记录，已在范围中标明。</p><ol class="source-list source-register">{sources.map(s=><li id={s.id}><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a><small>{s.org} · 整理／核查 {s.checked}</small><p>{s.scope}</p></li>)}</ol></section><div class="two-column"><section class="panel"><h2>后续深化方向</h2><p>补充专业人员校审、地方差异对照、异常案例细分、可核对的业务术语解释，以及更多农产品、液体化工介质、普通件杂货与客运场景。新增资料先归入知识域，再连接到对应流程和岗位。</p></section><section class="panel"><h2>本地数据与隐私</h2><p>收藏和已读标记只保存在当前浏览器，不会上传到本站服务器。本站没有登录、后端业务接口或生产数据接入。清除浏览器站点数据后，收藏和已读会消失。</p></section></div></div></Layout>
