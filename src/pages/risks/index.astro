---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import KnowledgeCheck from '../../components/KnowledgeCheck.astro';
import {portRisks,riskSources} from '../../data/port-risks.js';
import {riskCases} from '../../data/risk-learning.js';
import '../../styles/risks.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const categories=['全部风险',...new Set(portRisks.map(r=>r.category))];
---
<Layout title="港口风险与预防" active="risks" description="从风叶、木材与卷钢的交接出发，认识港口作业、货物、环境、数据与经营风险，以及预防、处理和恢复的责任链。">
<div class="container risk-page">
<div class="breadcrumbs"><a href={base}>首页</a><Icon name="chevron" size={12}/><span>港口风险与预防</span></div>
<header class="risk-hero"><div><span class="eyebrow">RISK FIELD GUIDE / 港口风险与预防</span><h1>货在移动，<br/>风险也在<span>换位置。</span></h1><p class="risk-lead">到港、堆存、装卸、出场，每一次交接都要回答：<br/>什么会出问题，谁先看见，下一棒交给谁？</p><div class="risk-hero-actions"><a class="button primary" href="#risk-atlas">查看 {portRisks.length} 类风险 <Icon name="arrow" size={17}/></a><a class="text-link" href="#risk-cases">从一票货开始 →</a></div><p class="risk-note">教学框架，不设统一危险分数；实际条件需结合货物、场地、设备及适用规则评估。</p></div><figure><img src={base+'illustrations/risk-overview.svg'} alt="港区风险观察图：车流、吊装、堆存、天气、水边与控制室" width="720" height="360"/><figcaption>同一票货经过多个区域，也需要多方一起识别和管理风险。</figcaption></figure></header>
<nav class="cargo-local-nav" aria-label="风险专题目录"><a href="#risk-atlas">风险地图</a><a href="#risk-cases">三票货的判断</a><a href="#risk-handoff">处理与恢复</a><a href="#risk-sources">资料与范围</a></nav>
<section class="risk-section" id="risk-atlas"><div class="risk-section-heading"><div><span class="eyebrow">01 / FIND THE RISK</span><h2>从发生位置，找到预防重点。</h2></div><p>点开一张卡，继续看异常信号、责任人和记录。</p></div>
<div class="risk-atlas-tools"><div class="filter-bar" aria-label="按风险领域筛选">{categories.map((c,i)=><button class="filter-chip" data-risk-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><p id="risk-count" role="status" aria-live="polite">显示 {portRisks.length} 类风险</p></div>
<div class="risk-atlas">{portRisks.map((r,i)=><a class="risk-card" data-risk-category={r.category} href={base+'risks/'+r.id+'/'}><div class="risk-card-top"><span>{String(i+1).padStart(2,'0')}</span><small>{r.category}</small></div><h3>{r.title} <span aria-hidden="true">↗</span></h3><p>{r.summary}</p><div class="risk-where"><span>重点看</span>{r.where.slice(0,3).join(' · ')}</div><div class="risk-owner"><span>谁接这一棒</span><strong>{r.owner}</strong></div></a>)}</div>
</section>
<section class="risk-section risk-case-section" id="risk-cases"><span class="eyebrow">02 / FOLLOW THREE SHIPMENTS</span><h2>看懂一个异常，比记住一串名词更有用。</h2><p class="risk-section-intro">选一票货，先判断，再看看现场、业务和系统怎样接力。情景均为教学假设。</p>
<div data-choice-scope><nav class="cargo-choice-nav" aria-label="选择风险学习情景">{riskCases.map(c=><a href={'#case-'+c.id} data-choice={'case-'+c.id}>{c.name}</a>)}</nav><p class="sr-only" data-choice-status role="status" aria-live="polite"></p>
{riskCases.map(c=><article class="risk-case-panel" id={'case-'+c.id} data-choice-panel><div class="risk-case-scene"><div><span class="eyebrow">交接现场 · 教学假设</span><h3>{c.name}</h3><p>{c.scene}</p><a class="text-link" href={base+c.cargoPath}>先看这类货的完整业务 →</a></div><img src={base+'illustrations/cargo/'+c.image+'.svg'} alt={c.name+'货物线稿'} width="720" height="360" loading="lazy"/></div><KnowledgeCheck quiz={c.quiz}/><details class="risk-trace"><summary>展开这一票货的处理与记录链</summary><ol>{c.trace.map(t=><li>{t}</li>)}</ol><div class="risk-related-tags">{c.riskIds.map(id=>portRisks.find(r=>r.id===id)).filter(Boolean).map(r=><a href={base+'risks/'+r.id+'/'}>{r.title} ↗</a>)}</div></details></article>)}
</div></section>
<section class="risk-section" id="risk-handoff"><span class="eyebrow">03 / CLOSE THE LOOP</span><h2>“有人修好了”之后，还要把哪几棒接完？</h2><p class="risk-section-intro">以下是理解部门协作的通用教学线索。现场按本单位制度、应急预案与责任权限执行；部门名称可能不同。</p><div class="risk-loop">{[
['01','发现并报告','现场、司机、理货或监测发现异常，报告对象、位置、时间和观察到的事实。','异常记录／监测告警'],
['02','控制受影响任务','相关负责人组织停止或隔离受影响作业，中控和计划协调关联任务；紧急情况进入相应应急程序。','受影响范围／任务变化'],
['03','专业核实与处置','工程、安全、货物专业方及相关外部主体按职责核实。检修结论、监管决定和客户确认分别记录。','检查结论／处置记录'],
['04','确认恢复并同步','按权限确认恢复条件，交接给生产组织；系统、现场、班组记录保持一致，后续复盘预防重复发生。','恢复确认／计划与交接更新']
].map(([no,title,text,record])=><article><span>{no}</span><h3>{title}</h3><p>{text}</p><small>{record}</small></article>)}</div><div class="risk-boundary"><strong>三个容易混淆的状态</strong><p>技术故障已处理，仍需确认生产恢复条件；系统重新上线，仍需核对中断期间的实物与任务；货物身份匹配，仍需确认货况、适用监管状态和交付授权。</p><div><a href={base+'roles/'}>部门怎样交接 →</a><a href={base+'gate/'}>闸口为什么不抬杆 →</a><a href={base+'infrastructure/it-room/'}>系统如何保持运行 →</a></div></div></section>
<section class="risk-section cargo-source-section" id="risk-sources"><span class="eyebrow">SOURCES & SCOPE</span><h2>资料依据与适用范围</h2><p>本站把资料归纳为面向初学者的风险框架，不声称覆盖所有货种和港区。各风险详情页标出对应来源及适用范围；国际指导、海外监管资料和国内规定需分别理解。现场操作、专业评估和应急处置以适用要求为准。</p><p>本页的三票货是教学假设，可结合对应的<a href={base+'cargo/wind-blade/#cargo-sources'}>叶片</a>、<a href={base+'cargo/timber/#cargo-sources'}>木材</a>和<a href={base+'cargo/steel-coil/#cargo-sources'}>卷钢</a>资料理解。</p><details class="cargo-disclosure"><summary>查看本专题引用的 {riskSources.length} 项资料</summary><ol class="source-list">{riskSources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>{s.org} · 核查 {s.checked} · {s.scope}</small></li>)}</ol></details></section>
</div><script src="../../scripts/cargo-choices.ts"></script><script>
const riskCards=[...document.querySelectorAll<HTMLElement>('[data-risk-category]')];
document.querySelectorAll<HTMLButtonElement>('[data-risk-filter]').forEach(button=>button.addEventListener('click',()=>{
 let count=0;const category=button.dataset.riskFilter;
 riskCards.forEach(card=>{const show=category==='全部风险'||category===card.dataset.riskCategory;card.hidden=!show;if(show)count++});
 document.querySelectorAll('[data-risk-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
 document.querySelector('#risk-count')!.textContent='显示 '+count+' 类风险';
}));
</script></Layout>
