---
import Layout from '../layouts/Layout.astro';
import { coverageDimensions, coverageGroups, interactionNames, caseKindLabels, knowledgeCoverage, learningPaths, rolePaths } from '../data/knowledge-coverage.js';
import '../styles/knowledge-map.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (path: string) => base + path;
type Domain = (typeof knowledgeCoverage)[number];
const views: { id: string; title: string; matches: (domain: Domain) => boolean; noEntries?: string }[] = [
  { id: 'all', title: '全部主题', matches: () => true },
  { id: 'interactive', title: '查看有交互', matches: (domain) => domain.coverage.interactive.links.length > 0 },
  { id: 'practice', title: '可作答练习', matches: (domain) => domain.coverage.interactive.links.some((entry) => entry.kind === 'exercise') },
  { id: 'missing-entry', title: '缺维度入口', matches: (domain) => domain.development.missingEntry, noEntries: '当前所有知识域的四个维度都有入口' },
  { id: 'dedicated-case', title: '有独立案例', matches: (domain) => domain.caseStudy.kind === 'dedicated' },
  { id: 'related-case', title: '相关案例可借读', matches: (domain) => domain.caseStudy.kind === 'related' },
  { id: 'deepen', title: '需要深化', matches: (domain) => domain.development.canDeepen },
];
const practiceDomainCount = knowledgeCoverage.filter((domain) => domain.coverage.interactive.links.some((entry) => entry.kind === 'exercise')).length;
const dedicatedCaseCount = knowledgeCoverage.filter((domain) => domain.caseStudy.kind === 'dedicated').length;
const relatedCaseCount = knowledgeCoverage.filter((domain) => domain.caseStudy.kind === 'related').length;
const deepenDomainCount = knowledgeCoverage.filter((domain) => domain.development.canDeepen).length;
const summaryStats = [
  { id: 'domains', value: knowledgeCoverage.length, label: '知识领域', hint: '覆盖港口从船到岸的完整目录' },
  { id: 'groups', value: coverageGroups.length, label: '知识大类', hint: '按船舶、岗位、货类等主题浏览' },
  { id: 'practice', value: practiceDomainCount, label: '有可作答练习的领域', hint: '通过判断和异常选择检验理解' },
  { id: 'dedicated-case', value: dedicatedCaseCount, label: '有独立案例', hint: '各领域核对过的代表案例，不代表穷尽' },
  { id: 'related-case', value: relatedCaseCount, label: '相关案例可借读', hint: '可借邻近场景学习，仍有独立专题空间' },
];
const quickTasks = [
  { view: 'all', label: '从全图开始', description: `先浏览 ${knowledgeCoverage.length} 个领域，建立港口全貌`, value: knowledgeCoverage.length },
  { view: 'practice', label: '先做可作答练习', description: `查看含练习的 ${practiceDomainCount} 个领域，检验自己是否读懂`, value: practiceDomainCount },
  { view: 'dedicated-case', label: '看有独立案例的领域', description: '直接进入已核对的领域代表案例', value: dedicatedCaseCount },
  { view: 'related-case', label: '看相关案例可借读的领域', description: '区分借读内容与尚待补充的独立专题', value: relatedCaseCount },
  { view: 'deepen', label: '查看可继续深化', description: '从已有基础出发，选择下一步专题', value: deepenDomainCount },
];
---
<Layout title="知识覆盖地图与学习路线" description="按九大类浏览二十四个知识域，分别查看基础介绍、业务流程、交互演示和异常案例的已有入口与待深化项，并选择适合自己的学习路线。" active="library">
  <div class="km-page" data-knowledge-map>
    <div class="km-wrap">
      <div class="km-breadcrumb"><a href={base}>首页</a><span aria-hidden="true">/</span><span>知识覆盖地图</span></div>
      <header class="km-hero">
        <div class="km-hero-copy">
          <p class="km-kicker">PORT KNOWLEDGE / 学习导航</p>
          <h1>把港口知识，<br /><em>连成自己的路线。</em></h1>
          <p class="km-lead">先看已有的入口，再选下一步。用四个独立维度，读懂这份手册讲到了哪里、还可以往哪里深入。</p>
          <div class="km-hero-actions"><a class="km-primary" href="#coverage-map">打开覆盖地图 <span aria-hidden="true">↓</span></a><a class="km-text-link" href="#learning-paths">选择学习路线 <span aria-hidden="true">↗</span></a></div>
          <p class="km-scope">{knowledgeCoverage.length} 个既有知识域 · {coverageGroups.length} 大类 · 有入口不等于知识完备</p>
        </div>
        <figure class="km-harbor">
          <div class="km-drawing-caption"><span>从船到岸，从事到人</span><span aria-hidden="true">FIG. 01</span></div>
          <svg viewBox="0 0 560 300" fill="none" role="img" aria-label="船舶、岸桥、堆场和车辆以虚线相连的港口线稿">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 220H539M22 251c17 8 27-8 44 0s27-8 44 0 27-8 44 0 27-8 44 0 27-8 44 0M35 267c17 8 27-8 44 0s27-8 44 0 27-8 44 0 27-8 44 0" />
              <path d="M32 190h166l-19 30H54zM49 190v-37h22v37M54 153v-16h11v16M59 137v-15M77 172h31v18H77zM110 172h31v18h-31zM143 172h31v18h-31zM110 153h31v19h-31z" />
              <path d="M222 220V73h16v147M203 220l26-91 28 91M145 73h158v-9H145zM160 64l70-39 69 39M230 25v39M230 73l70 54M278 73v68M269 141h19M264 144h29v20h-29zM237 220h305M317 220v-51l63-29 63 29v51M327 177h106M330 187h26v33M370 187h26v33M410 187h24v33M451 204h59v16h-59zM474 204v-21h-23v21M478 190h23l11 14M461 211h13M492 211h9" />
              <path d="M86 98H348v25M368 114h131v48" stroke-dasharray="4 7" />
              <circle cx="86" cy="98" r="4" fill="currentColor"/><circle cx="348" cy="123" r="4" fill="currentColor"/><circle cx="499" cy="162" r="4" fill="currentColor"/>
              <path d="M108 89l9 9-9 9M478 105l9 9-9 9M298 256h76m-12-7 12 7-12 7" />
              <circle cx="459" cy="224" r="5" fill="#fbf8f1"/><circle cx="502" cy="224" r="5" fill="#fbf8f1"/>
            </g>
            <g fill="currentColor" font-family="system-ui, sans-serif" font-size="13"><text x="51" y="114">船</text><text x="212" y="244">岸</text><text x="367" y="242">场</text><text x="479" y="249">车</text></g>
          </svg>
          <figcaption><span>基础 → 流程 → 交互 → 异常</span><small>四个观察角度，不是完成度评分</small></figcaption>
        </figure>
      </header>

      <section class="km-snapshot" id="km-snapshot" aria-labelledby="km-snapshot-title">
        <div class="km-section-head km-snapshot-head"><div><p class="km-kicker">AT A GLANCE / 先看全貌</p><h2 id="km-snapshot-title">这张地图现在覆盖到哪里？</h2></div><p>摘要数字是入口统计，不是知识完备度评分。</p></div>
        <div class="km-summary-grid" aria-label="知识地图摘要">
          {summaryStats.map((stat) => <div class:list={['km-summary-card', { 'is-alert': stat.id === 'related-case' }]} data-km-summary={stat.id}>
            <span class="km-summary-number" aria-hidden="true">{String(stat.value).padStart(2, '0')}</span>
            <div><strong>{stat.label}</strong><p>{stat.hint}</p></div>
          </div>)}
        </div>
        <div class="km-task-panel">
          <div class="km-task-intro"><p class="km-kicker">LEARNING TASKS / 快捷入口</p><h3>今天先完成哪一件？</h3><p>点击任务会清除原有搜索和大类筛选，并跳到任务结果。</p></div>
          <div class="km-task-list" aria-label="学习任务入口">
            {quickTasks.map((task) => <a class="km-task" href="#coverage-map" data-km-quick-view={task.view} aria-controls="coverage-map">
              <span class="km-task-copy"><strong>{task.label}</strong><small>{task.description}</small></span><span class="km-task-count">{task.value}<small>个域</small><span aria-hidden="true">↗</span></span>
            </a>)}
          </div>
        </div>
      </section>

      <section class="km-learning" id="learning-paths" aria-labelledby="km-learning-title">
        <div class="km-section-head"><div><p class="km-kicker">START SOMEWHERE / 从这里出发</p><h2 id="km-learning-title">三条路线，选一个起点。</h2></div><p>按顺序读，也可以回到地图自由探索。</p></div>
        <div class="km-path-grid">
          {learningPaths.map((route) => (
            <article class="km-path" id={'route-' + route.id}>
              <span class="km-route-number" aria-hidden="true">{route.number}</span>
              <h3>{route.title}</h3><p class="km-route-purpose">{route.purpose}</p>
              <details class="km-route-details">
                <summary>{route.id === 'by-role' ? '选择岗位，展开路线' : route.branches ? '选择进口箱、大豆或 LNG 路线' : `展开 ${route.steps.length} 步路线`}<span aria-hidden="true">＋</span></summary>
                {route.id === 'by-role' ? (
                  <div>
                    <div class="km-role-picker" data-km-role-picker hidden><label for="km-role">选择你的岗位</label><select id="km-role" aria-controls="km-role-guides">{rolePaths.map((role) => <option value={role.id}>{role.title}</option>)}</select></div>
                    <div id="km-role-guides">{rolePaths.map((role, index) => <details class="km-role-guide" data-km-role={role.id} open={index === 0}><summary>{role.title} · 4 步</summary><ol class="km-steps">{role.steps.map((item, i) => <li><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><a href={href(item.path)}>{item.title}<span aria-hidden="true"> ↗</span></a><p>{item.purpose}</p></div></li>)}</ol></details>)}</div>
                  </div>
                ) : route.branches && route.comparisons ? (
                  <div class="km-shipment-routes">
                    <p class="km-shipment-hint">从一只虚构进口箱 A-01 开始，先读同一票货上的交接，再选择进口箱、大豆或 LNG 路线继续。线路锚点是导航，不另计已读步数。</p>{route.featuredCase && <article class="km-featured-case"><div><strong>{route.featuredCase.title}</strong><p>{route.featuredCase.purpose}</p></div><a href={href(route.featuredCase.path)}>开始六站案例 ↗</a></article>}
                    {route.branches.map((branch) => <details class="km-shipment-branch" data-km-shipment={branch.id}>
                      <summary>{branch.title}</summary>
                      <p>{branch.description} <a href={href(branch.profile.path)}>{branch.profile.label} ↗</a></p>
                      <ol class="km-shipment-steps" aria-label={`${branch.title}：按顺序阅读`}>
                        {branch.steps.map((item) => <li>
                          <a href={href(item.path)}>{item.title}<span aria-hidden="true"> ↗</span></a>
                          {item.hasExercise && <small>含异常练习</small>}
                          <p>{item.purpose}</p>
                        </li>)}
                      </ol>
                    </details>)}
                    <details class="km-shipment-branch km-shipment-comparison" data-km-comparison>
                      <summary>选读对照 · 不计入路线</summary>
                      <ul>{route.comparisons.map((item) => <li><a href={href(item.path)}>{item.title} ↗</a><p>{item.purpose}</p></li>)}</ul>
                    </details>
                  </div>
                ) : <ol class="km-steps">{route.steps.map((item, i) => <li><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><a href={href(item.path)}>{item.title}<span aria-hidden="true"> ↗</span></a><p>{item.purpose}</p></div></li>)}</ol>}
                <p class="km-route-outcome"><strong>读完试着说：</strong>{route.outcome}</p>
                {route.nextStep && <p class="km-route-next"><strong>续读建议 · </strong><a href={href(route.nextStep.path)}>{route.nextStep.title} ↗</a><span>（不计入本路线步数）</span></p>}
              </details>
            </article>
          ))}
        </div>
      </section>

      <section class="km-map" id="coverage-map" aria-labelledby="km-map-title">
        <div class="km-section-head"><div><p class="km-kicker">KNOWLEDGE ATLAS / 已有与待深化</p><h2 id="km-map-title">一张地图，四种覆盖。</h2></div><a class="km-text-link" href="#km-method">怎样判断覆盖 <span aria-hidden="true">↓</span></a></div>
        <div class="km-legend" aria-label="覆盖维度说明">
          {coverageDimensions.map((dimension) => <div><span class="km-dimension-number">{dimension.symbol}</span><div><strong>{dimension.title}</strong><p>{dimension.explanation}</p></div></div>)}
        </div>
        <p class="km-map-note"><span class="km-status-mark" aria-hidden="true">↗</span> 有入口 <span class="km-pending-mark" aria-hidden="true">○</span> 缺维度入口 · 有独立案例 / 相关案例可借读 · 可继续深化。案例状态已逐域核对，但只代表所列代表案例，不表示覆盖全部业务。</p>

        <form class="km-controls" data-km-controls role="search" aria-label="筛选知识覆盖地图" hidden>
          <div class="km-search-row"><div class="km-search-field"><label for="km-search">按主题搜索</label><div><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg><input id="km-search" name="q" type="search" maxlength="100" placeholder="试试：大豆、LNG、闸口、计量…" autocomplete="off" aria-describedby="km-filter-help" /></div></div><div class="km-group-select"><label for="km-group">知识大类</label><select id="km-group" name="group"><option value="all">全部 {coverageGroups.length} 大类</option>{coverageGroups.map((group) => <option value={group.id}>{group.title}</option>)}</select></div><button class="km-reset" type="reset">重置筛选</button></div>
          <fieldset class="km-views"><legend class="km-sr-only">按覆盖情况筛选</legend>{views.map((view, i) => {
            const total = knowledgeCoverage.filter(view.matches).length;
            return <label><input type="radio" name="view" value={view.id} checked={i === 0} data-km-empty-title={total === 0 ? view.noEntries : undefined}/><span>{view.title}<small>{total}</small></span></label>;
          })}</fieldset>
          <p id="km-filter-help">搜索、大类和覆盖条件共同生效。按钮显示全站知识域数；「需要深化」表示已有具体后续建议，与缺入口、缺独立案例可以重叠。</p>
          <p class="km-share-note">筛选条件会同步到地址栏；复制当前页面链接即可分享相同结果。</p>
        </form>
        <noscript><p class="km-noscript">当前显示全部知识域。搜索和筛选需启用 JavaScript；目录、内容链接和展开详情仍可使用。</p></noscript>
        <div class="km-map-layout">
          <nav class="km-index" aria-label="知识大类目录"><p class="km-kicker">地图目录</p>{coverageGroups.map((group, index) => <a href={'#group-' + group.id} data-km-index={group.id}><span class="km-index-number">{String(index + 1).padStart(2, '0')}</span><span>{group.title}</span><small>{group.domains.length}</small></a>)}<a class="km-index-top" href="#learning-paths">↑ 回到学习路线</a></nav>
          <div class="km-results">
            <p class="km-result-status" id="km-results-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1">显示 {knowledgeCoverage.length} 个知识域 / {coverageGroups.length} 大类</p>
            <div class="km-empty" data-km-empty hidden><span aria-hidden="true">⌕</span><h3 data-km-empty-title>暂时没有匹配的主题</h3><p>试试更短的词，或放宽大类与覆盖条件。</p><button type="button" data-km-clear>清除筛选，查看全部</button></div>
            {coverageGroups.map((group, index) => <section class="km-group" id={'group-' + group.id} data-km-group={group.id} aria-labelledby={'group-title-' + group.id}>
              <header class="km-group-heading"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3 id={'group-title-' + group.id}>{group.title}</h3><p>{group.hint}</p></div><small data-km-group-count>{group.domains.length} 个域</small></header>
              <div class="km-domain-grid">{knowledgeCoverage.filter((domain) => domain.groupId === group.id).map((domain) => <article class="km-domain" id={domain.id} data-km-domain data-km-search={domain.searchText} data-km-group-id={domain.groupId} data-km-views={views.filter((view) => view.matches(domain)).map((view) => view.id).join(' ')}>
                <div class="km-domain-meta"><span>{domain.id.toUpperCase()}</span><span>{domain.development.missingEntry ? `缺维度入口 · ${domain.gaps.length} 项` : '四维均有入口'}</span></div>
                <h4>{domain.title}</h4><p class="km-domain-summary">{domain.summary}</p><p class="km-case-status" data-case-kind={domain.caseStudy.kind}><strong>{caseKindLabels[domain.caseStudy.kind as keyof typeof caseKindLabels]}</strong><span>{domain.caseStudy.note}</span><a href={href(domain.caseStudy.path)}>{domain.caseStudy.label} ↗</a></p>
                <dl class="km-coverage-grid">{coverageDimensions.map((dimension) => {
                  const item = domain.coverage[dimension.id];
                  return <div class:list={['km-coverage-cell', { 'km-is-pending': !item.links.length }]}>
                    <dt>{dimension.title}</dt>
                    <dd>{item.links.length ? item.links.map((entry) => <a href={href(entry.path)} aria-label={`${domain.title} · ${dimension.title}：${entry.label}${'kind' in entry ? `（${interactionNames[entry.kind as keyof typeof interactionNames]}）` : ''}`}>
                      <span>{entry.label}{'kind' in entry && <small class="km-interaction-kind">{interactionNames[entry.kind as keyof typeof interactionNames]}</small>}</span><span aria-hidden="true">↗</span>
                    </a>) : <span class="km-pending"><span aria-hidden="true">○</span> 缺入口</span>}</dd>
                  </div>;
                })}</dl>
                <details class="km-domain-details"><summary>覆盖依据与继续深入<span aria-hidden="true">＋</span></summary>
                  <dl class="km-evidence">{coverageDimensions.map((dimension) => <div><dt>{dimension.title}</dt><dd>{domain.coverage[dimension.id].note}</dd></div>)}</dl>
                  <p class="km-next"><strong>{caseKindLabels[domain.caseStudy.kind as keyof typeof caseKindLabels]} · {domain.caseStudy.label}</strong>{domain.caseStudy.note}</p>{domain.development.canDeepen && <p class="km-next"><strong>可以继续深化</strong>{domain.next}</p>}
                  {domain.topics.length > 0 && <div class="km-related"><strong>本领域专题</strong><div>{domain.topics.map((topic) => <a href={href(topic.path)}>{topic.label}<span aria-hidden="true"> ↗</span></a>)}</div></div>}
                </details>
              </article>)}</div>
            </section>)}
          </div>
        </div>
      </section>

      <section class="km-method" id="km-method" aria-labelledby="km-method-title"><div><p class="km-kicker">READ THE MAP / 阅读这张地图</p><h2 id="km-method-title">记录入口，保留边界。</h2><p>四个维度独立判断。一个领域即使四维均有入口，也只代表这里链接的内容已经存在，不代表所有货类、地区与实务问题均已覆盖。</p></div><div><ul><li><strong>尊重现有概览。</strong>24 个领域的基础介绍都来自既有知识卡；粮食归入干散货，油品、化学品、LNG 与 LPG 归入液体散货与气体业务。</li><li><strong>以实际内容为依据。</strong>业务流程对应步骤或交接链；交互按实际玩法标注类型；异常案例对应具体变化与处理，不拿常见误区充数。</li><li><strong>不作完成度评分。</strong>案例分为有独立案例和相关案例可借读；这只是代表案例核对，不表示完整覆盖。缺入口与已有深化建议分别标记。</li></ul><a class="km-text-link" href={href('about/')}>查看手册的来源与适用范围 <span aria-hidden="true">↗</span></a></div></section>
      <div class="km-end"><span>从一个问题出发，沿着交接继续走。</span><a href="#coverage-map">回到地图 ↑</a></div>
    </div>
  </div>
</Layout>
<script>
  import '../scripts/knowledge-map';
  import '../scripts/learning-state';
</script>

<style is:global>.route-progress{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;padding:10px 0;color:var(--teal);font-size:13px}.route-progress a{font-weight:700}.km-steps li.is-read>span{background:var(--teal);color:white}.km-steps a[data-completed=true]::after{content:" · 已读";font-size:11px;color:var(--teal)}</style>

<style>
  .km-shipment-hint, .km-shipment-branch p { font-size: 12px; }
  .km-shipment-branch { margin-top: 10px; }
  .km-shipment-branch > summary { font-weight: 700; }
  .km-shipment-branch > summary::after { content: '+'; }
  .km-shipment-branch[open] > summary::after { content: '−'; }
  .km-shipment-branch a { color: #285653; text-decoration: underline; text-underline-offset: 3px; }
  .km-shipment-branch ol, .km-shipment-branch ul { padding-inline-start: 22px; margin: 8px 0 15px; }
  .km-shipment-branch li { padding: 8px 0; border-top: 1px solid #e6e9df; font-size: 13px; }
  .km-shipment-branch li p { margin: 4px 0 0; }
  .km-shipment-steps small, .km-interaction-kind { display: block; margin-top: 2px; color: #475e50; font-size: 10px; }
  .km-page .km-case-gap { margin: 0 0 12px; color: #634a23; font-size: 12px; }
</style>
