---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import KnowledgeCheck from '../../components/KnowledgeCheck.astro';
import {cargoProfiles,cargoSources} from '../../data/cargo-business.js';
import {cargoQuizzes} from '../../data/cargo-learning.js';
import '../../styles/cargo.css';
export function getStaticPaths(){return cargoProfiles.map(profile=>({params:{id:profile.id},props:{profile}}));}
const {profile:p}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const references=cargoSources.filter(s=>p.sources.includes(s.id));
const quiz=cargoQuizzes[p.id];
const stageTitle=(title:string)=>title.replace(/^\d+\s*[·.]\s*/, '');
---
<Layout title={p.name+'业务'} description={p.summary} active="cargo"><div class="container cargo-page">
<div class="breadcrumbs"><a href={base}>首页</a><Icon name="chevron" size={12}/><a href={base+'cargo/'}>箱型与货类</a><Icon name="chevron" size={12}/><span>{p.name}</span></div>
<header class="cargo-profile-hero"><div><span class="eyebrow">CARGO FILE / {p.category}</span><h1>{p.name}</h1><p class="cargo-lead">{p.subtitle}</p><p>{p.summary}</p><div class="cargo-identity"><span>先识别谁</span><strong>{p.identity}</strong></div></div>{p.visual&&<figure><img src={base+p.visual.replace(/^\//,'')} alt={p.name+'业务原创线稿'} width="720" height="360"/><figcaption>结构与业务关系示意 · 不按实际比例 · 不作为作业图纸</figcaption></figure>}</header>
<nav class="cargo-local-nav" aria-label="专题目录"><a href="#distinctions">先分清</a><a href="#transport">怎样运</a><a href="#business-chain">业务链</a><a href="#handoffs">谁交给谁</a><a href="#gate-checks">闸口校验</a><a href="#cargo-economics">收入与成本</a><a href="#cargo-sources">依据与范围</a></nav>
<section class="cargo-section" id="distinctions"><span class="eyebrow">START WITH THE DIFFERENCES</span><h2>先分清这些差别。</h2><div class="cargo-distinction-grid">{p.distinctions.map(d=><div><h3>{d.title}</h3><p>{d.text}</p></div>)}</div></section>
<section class="cargo-section" id="transport"><span class="eyebrow">TRANSPORT OPTIONS</span><h2>换一种运输方式，关注点也会改变。</h2><p>点击一种方式，查看适用思路、系统记录与核对重点。实际方案需由相应责任方确认。</p><div data-choice-scope><nav class="cargo-choice-nav" aria-label="选择运输方式">{p.modes.map((m,i)=><a href={'#mode-'+i} data-choice={'mode-'+i}>{m.name}</a>)}</nav><p class="sr-only" data-choice-status role="status" aria-live="polite"></p>{p.modes.map((m,i)=><article class="cargo-mode-panel" id={'mode-'+i} data-choice-panel><span class="cargo-panel-index">MODE / 0{i+1}</span><h3>{m.name}</h3><dl><div><dt>什么时候考虑</dt><dd>{m.when}</dd></div><div><dt>系统要记录什么</dt><dd>{m.system}</dd></div><div><dt>重点核对什么</dt><dd>{m.checks}</dd></div></dl></article>)}</div></section>
<section class="cargo-section" id="business-chain"><div class="cargo-heading"><div><span class="eyebrow">FOLLOW ONE SHIPMENT</span><h2>沿着业务链，看看这一棒谁来接。</h2></div><span>教学主线；部分条件会并行确认</span></div><div data-choice-scope><nav class="cargo-stage-nav" aria-label="选择业务节点">{p.stages.map((s,i)=><a href={'#stage-'+s.id} data-choice={'stage-'+s.id}><span>{String(i+1).padStart(2,'0')}</span><strong>{stageTitle(s.title)}</strong></a>)}</nav><p class="sr-only" data-choice-status role="status" aria-live="polite"></p>{p.stages.map((s,i)=><article id={'stage-'+s.id} data-choice-panel class="cargo-stage-panel"><header><span class="cargo-panel-index">STEP / {String(i+1).padStart(2,'0')}</span><h3>{stageTitle(s.title)}</h3><p>{s.action}</p></header><div class="cargo-stage-facts"><div><span>谁负责这一棒</span><p>{s.actor}</p></div><div><span>系统怎样跟上</span><p>{s.system}</p></div><div><span>交出去的结果</span><p>{s.output}</p></div></div><div class="cargo-stage-checks"><div><h4>带着哪些记录来</h4><ul>{s.records.map(x=><li>{x}</li>)}</ul></div><div><h4>先把什么核对清楚</h4><ul>{s.checks.map(x=><li>{x}</li>)}</ul></div></div><div class="cargo-exception-line"><strong>对不上时 →</strong><p>{s.exception}</p></div><a class="text-link" href={base+'systems/'}>对照港口系统图谱 <Icon name="arrow" size={16}/></a></article>)}</div><noscript><p class="notice">当前脚本未启用，所有节点已按顺序展开，可直接阅读。</p></noscript></section>
<section class="cargo-section" id="handoffs"><span class="eyebrow">HANDOFFS / 交的是信息，也是责任</span><h2>部门之间，具体交接什么？</h2><div class="cargo-handoff-list">{p.handoffs.map((h,i)=><article><div><span>0{i+1}</span><strong>{h.from}</strong><i aria-hidden="true">↓</i><strong>{h.to}</strong></div><dl><dt>交接记录</dt><dd>{h.record}</dd><dt>接手前核对</dt><dd>{h.check}</dd></dl></article>)}</div></section>
<section class="cargo-section" id="gate-checks"><span class="eyebrow">AT THE GATE / 识别到，不等于可以放行</span><h2>这一票货进出港，要查什么？</h2><div class="cargo-gate-grid">{p.gateChecks.map((g,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{g.label}</h3><p>{g.text}</p></article>)}</div><div class="cargo-authorization"><strong>三个条件分别确认</strong><p>适用的监管状态 → 商业交付或承运授权 → 码头本次作业与通行条件。它们相互关联，各有决定主体；平台传来消息、识别成功、道闸抬起也分别是不同事件。</p><a href={base+'gate/'}>到闸口模拟器看看 →</a></div></section>
{quiz&&<KnowledgeCheck quiz={quiz}/>}
<section class="cargo-section" id="cargo-economics"><span class="eyebrow">SERVICES & COSTS</span><h2>做了哪些服务，为什么产生成本？</h2><p>下面是理解业务的计量维度，不是报价表。收费项目、计费单位、付费方和免费期以实际服务合同及适用规则为准。</p><div class="cargo-table-scroll" tabindex="0" role="region" aria-label="服务、计量与成本对照，可横向滚动"><table class="cargo-table"><thead><tr><th scope="col">可能提供的服务</th><th scope="col">可能的计量维度</th><th scope="col">主要成本动因</th><th scope="col">收入边界</th></tr></thead><tbody>{p.economics.map(e=><tr><th scope="row">{e.service}</th><td>{e.unit}</td><td>{e.cost}</td><td>{e.boundary}</td></tr>)}</tbody></table></div><a class="text-link" href={base+'economics/'}>继续看收入、成本与利润的关系 →</a></section>
<section class="cargo-section"><span class="eyebrow">EXCEPTIONS / 找到下一位责任人</span><h2>如果流程停住了呢？</h2><div class="cargo-exception-grid">{p.exceptions.map(e=><details class="cargo-disclosure"><summary>{e.symptom}</summary><p><strong>谁来协调：</strong>{e.owner}</p><p>{e.response}</p></details>)}</div></section>
<section class="cargo-section cargo-source-section" id="cargo-sources"><h2>依据与适用范围</h2><p>{p.limits}</p><p>业务链为本站教学归纳；以下资料分别支持货物特征、运输方式与适用要求，并不意味着所有港口采用相同的部门名称、字段或顺序。</p><ol class="source-list">{references.map(s=><li id={s.id}><a href={s.url} target="_blank" rel="noopener noreferrer">{stageTitle(s.title)} ↗</a><small>{s.org} · 核查 {s.checked} · {s.scope}</small></li>)}</ol></section>
<section class="cargo-section"><h2>顺着关系继续看</h2><div class="cargo-crosslinks">{p.links.map(l=><a href={base+l.path.replace(/^\//,'')}>{l.label}<span>继续探索 →</span></a>)}</div><a class="text-link" href={base+'cargo/'}>← 回到箱型与货类全景</a></section>
</div><script src="../../scripts/cargo-choices.ts"></script></Layout>
