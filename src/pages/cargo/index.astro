---
import LearningEntry from '../../components/LearningEntry.astro';
import VesselEntry from '../../components/VesselEntry.astro';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import RiskEntry from '../../components/RiskEntry.astro';
import Icon from '../../components/Icon.astro';
import {cargoProfiles} from '../../data/cargo-business.js';
import {cargoCoverage} from '../../data/cargo-learning.js';
import '../../styles/cargo.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="箱型与货类" active="cargo" description="从箱型、船型到货类，看懂新能源汽车、重大件、木材、卷钢、矿产、粮食与液体货类的港口业务。">
<PageIntro eyebrow="CARGO ATLAS / 换一种货，换一套业务逻辑" title="港口搬运的，从来不只是一只箱。" description="一辆车、一支风电叶片、一船铁矿石：货物的身份、运输方式和交接条件，决定了港口怎样安排人、设备与系统。"/>
<div class="container cargo-page">
<div class="cargo-inline-grid" aria-label="相关图鉴与港口案例">
<a class="cargo-inline-entry" href={base+'brands/'}><strong>想看懂箱体上的公司名字和颜色？</strong><p>认识马士基、中远海运、OOCL、MSC、ONE、达飞、赫伯罗特和中集；分清船公司、箱主、制造商，理解熊猫图案与 ONE 洋红箱 →</p></a>
<a class="cargo-inline-entry" href={base+'brands-and-ports/'}><strong>港口名称背后，具体是谁在作业？</strong><p>对照上海外高桥集装箱码头和宁波舟山鼠浪湖铁矿石码头 →</p></a>
</div>
<section class="cargo-atlas-intro"><div><span class="eyebrow">先分清三个问题</span><h2>是什么货？<br/>用什么载体？<br/>怎样完成这一程？</h2><p>箱型、货物特性、业务场景是三个维度。冷藏箱是一种箱，冷链是一套保管要求；储能设备长得像箱子，也需要先确认它的产品与运输属性。</p><a class="button primary" href={base+'containers/'}>打开 12 种箱型图鉴 <Icon name="arrow" size={17}/></a></div><div class="cargo-axes" aria-label="货物、运输载体、业务组织三个维度"><div><span>01 / 货物</span><strong>车 · 电池设备 · 叶片</strong><p>识别身份、外廓、重量与保管条件</p></div><i aria-hidden="true">×</i><div><span>02 / 载体</span><strong>干货箱 · 框架箱 · 船舶甲板</strong><p>核对载体能力与运输适配</p></div><i aria-hidden="true">×</i><div><span>03 / 场景</span><strong>进口 · 出口 · 中转</strong><p>串起任务、单证、监管和交付</p></div></div></section>
<LearningEntry compact/><VesselEntry/><section class="cargo-section" id="profiles"><div class="cargo-heading"><div><span class="eyebrow">{cargoProfiles.length} BUSINESS FILES</span><h2>沿着一种货，认识一套业务。</h2></div><span>每个专题都有交接、系统、校验与费用</span></div><div class="cargo-profile-grid">{cargoProfiles.map((p,i)=><a class:list={['cargo-profile-card',{'cargo-featured':i<3}]} href={base+'cargo/'+p.id+'/'}><div class="cargo-card-drawing">{p.visual?<img src={base+p.visual.replace(/^\//,'')} alt={p.name+'原创教学线稿'} loading="lazy" width="720" height="360"/>:<div class="cargo-card-symbol"><Icon name={i===3?'crane':i===4?'grid':'ship'} size={76}/><span>{p.category}</span></div>}<span class="cargo-sheet-no">FILE / {String(i+1).padStart(2,'0')}</span></div><div class="cargo-card-body"><span class="eyebrow">{p.category}</span><h3>{p.name}</h3><p>{p.summary}</p><div><span>{p.stages.length} 个业务节点</span><span>打开业务档案 ↗</span></div></div></a>)}</div></section>
<section class="cargo-section cargo-coverage" id="coverage"><span class="eyebrow">COVERAGE MAP / 可继续生长的知识框架</span><h2>每一种货，都沿这六条线展开。</h2><div class="cargo-six-lines">{['货物身份与载体','运输方式与业务链','部门与外部主体','设备、场地与系统','单证、校验与异常','服务、计费与成本'].map((x,i)=><div><span>0{i+1}</span><strong>{x}</strong></div>)}</div><p>下面明确区分业务专题和基础入口。基础入口能帮你建立概念，细分品种与地区操作规则还需要继续展开。</p><div class="cargo-coverage-grid">{cargoCoverage.map(x=><a href={base+x.path}><span class:list={['cargo-coverage-level',{'is-expanded':x.level==='业务专题'}]}>{x.level}</span><h3>{x.name} <span aria-hidden="true">↗</span></h3><p>{x.focus}</p></a>)}</div><details class="cargo-disclosure"><summary>哪些细分内容仍待深化？</summary><p>例如成套设备的细分交接、其他粮食品种与加工产品、不同液体化工介质、活体货物及不同木材品种的具体检疫要求、各地区的业务接口。本页不把一个基础概述等同于已覆盖全部操作细则。</p></details></section>
<RiskEntry riskIds={['lifting','stack','identity']}/><div class="cargo-crosslinks"><a href={base+'systems/'}>系统怎样接力 <span>生产、闸口、外部协同 →</span></a><a href={base+'gate/'}>进出港核对什么 <span>授权、执行与通行分开看 →</span></a><a href={base+'economics/'}>港口怎样赚钱 <span>从具体服务追踪收入与成本 →</span></a></div>
</div></Layout>
