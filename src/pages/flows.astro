---
import VesselEntry from '../components/VesselEntry.astro';
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import {scenarios} from '../data/scenarios.js';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');const categories=['全部',...new Set(scenarios.map(s=>s.category))];
---
<Layout title="业务全流程" active="flows"><PageIntro eyebrow="FOLLOW THE FLOW / 业务全流程" title="跟着业务走，看懂每一次交接。" description="从船到岸，从场内到场外。选择一条业务，逐步查看参与者、输入信息、校验条件与异常去向。"/><div class="container page-content"><div class="topic-entry-banner"><div><h2>先跟着一只进口箱走一遍</h2><p>七个节点、三个地图图层，边走边看岗位、单证与系统。</p></div><a class="button primary" href={base+'journey/'}>打开互动旅程 <Icon name="arrow" size={16}/></a></div><div class="notice">箱体和箱内货物有各自的周转过程。这里的流程为教学简化，保留并行条件和地区差异，不把所有业务硬排成同一条直线。</div><div class="cargo-search-shortcuts"><a href={base+'cargo/'}>新能源汽车、储能柜与风电业务 →</a><a href={base+'containers/'}>先认箱型，再看作业 →</a></div><div class="filter-bar" aria-label="按货类筛选">{categories.map((c,i)=><button class="filter-chip" data-category={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><p class="search-count" id="flow-count" aria-live="polite">共 {scenarios.length} 个业务场景</p><div class="scenario-grid">{scenarios.map((s,i)=><a class="scenario-card" href={base+'scenarios/'+s.id+'/'} data-scenario-category={s.category}><div class="card-top"><span class="tag">{s.category}</span><span class="card-number">{String(i+1).padStart(2,'0')}</span></div><h3>{s.title}</h3><p>{s.summary}</p><div class="card-bottom"><span>{s.steps.length} 个节点 · {s.actors.length} 类参与者</span><Icon name="arrow" size={18}/></div></a>)}</div></div><script>
const btns=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];const cards=[...document.querySelectorAll<HTMLElement>('[data-scenario-category]')];btns.forEach(b=>b.addEventListener('click',()=>{const category=b.dataset.category;let count=0;cards.forEach(c=>{c.hidden=category!=='全部'&&category!==c.dataset.scenarioCategory;if(!c.hidden)count++});btns.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelector('#flow-count')!.textContent='共 '+count+' 个业务场景'}));
</script><div class="container"><VesselEntry compact/></div></Layout>