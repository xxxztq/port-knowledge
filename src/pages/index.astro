---
import BerthingEntry from '../components/BerthingEntry.astro';
import LearningEntry from '../components/LearningEntry.astro';
import VesselEntry from '../components/VesselEntry.astro';
import Layout from '../layouts/Layout.astro';
import RiskEntry from '../components/RiskEntry.astro';
import {cargoProfiles} from '../data/cargo-business.js';
import Icon from '../components/Icon.astro';
import PortMap from '../components/PortMap.astro';
import EquipmentCard from '../components/EquipmentCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles, domains } from '../data/knowledge.js';
import { scenarios } from '../data/scenarios.js';
import '../styles/brands.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const entries=[{no:'01',icon:'route',title:'跟着一只箱子，走完整个港口',text:'点击地图，让设备、岗位、单证与系统一起接力。',href:'journey/',tag:'业务流程',tone:'teal'},{no:'02',icon:'people',title:'谁在让港口运转？',text:'操作、中控、工程与外部机构，怎样交接。',href:'roles/',tag:'角色协作',tone:'cream'},{no:'03',icon:'crane',title:'认出港口里的大家伙',text:'设备的位置、用途、配合与故障影响。',href:'equipment/',tag:'设备图鉴',tone:'blue'},{no:'04',icon:'ship',title:'箱体品牌与港航公司',text:'马士基、COSCO、OOCL、MSC、ONE，以及箱主、制造商和港口的区别。',href:'brands/',tag:'主体图鉴',tone:'teal'}];
const questions=[['箱子到了，为什么还不能提？','gate/','货到了，还需要核对监管、交付授权与作业条件。'],['道闸为什么有时不抬杆？','gate/','跟着一辆集卡，逐项检查本次任务的通行条件。'],['转关箱到站了，为什么还不能直接提货？','scenarios/customs-transit/','分清转关放行、实到反馈、转关核销和进口放行。'],['港口靠什么赚钱？','economics/','把服务收入、成本消耗和利润分开来看。'],['设备坏了，谁来协调？','roles/','从现场发现到维修恢复，串起各岗位的交接。']];
const learningPaths=[{no:'01',icon:'route',title:'第一次认识港口',text:'从一只进口箱出发，先看船、岸桥、堆场、闸口怎样接力。',href:'journey/',action:'从一只箱子出发',tone:'teal'},{no:'02',icon:'ship',title:'跟一票货',text:'沿着一票货的单证、状态、实物和交付，理解全程怎样闭环。',href:'shipment/',action:'看一票货全程',tone:'sand'},{no:'03',icon:'people',title:'按岗位学习',text:'从操作部、中控、工程部到货代与监管方，看清谁在什么时候接手。',href:'roles/',action:'看岗位如何交接',tone:'blue'}];
const portLines=[['实物线','船、箱、车在哪里','从靠泊、装卸、堆场到闸口'],['岗位线','谁在接手','操作、中控、工程与外部机构'],['信息线','系统记录什么','任务、箱号、位置、状态与时间'],['授权监管线','凭什么继续','放行、预约、核验与异常拦截'],['费用线','港口如何结算','装卸、堆存、运输与增值服务']];
---
<Layout><section class="hero container"><div class="hero-copy"><div class="eyebrow"><span></span>从进港到交付 · 一起看懂港口</div><h1>一座港口，<br/>怎样<span class="serif-word">运转</span>？</h1><p class="hero-lede">跟着船、货、车，走进港口的每个环节。<br class="desktop-only"/>把设备、岗位、信息和交接，连成一张看得懂的图。</p><div class="hero-actions"><a class="button primary" href={base+'journey/'}>跟着箱子出发 <Icon name="arrow" size={19}/></a><a class="text-link" href={base+'knowledge-map/'}>浏览知识地图 <Icon name="chevron" size={16}/></a></div><div class="hero-proof"><span class="tiny-avatars"><i>船</i><i>货</i><i>车</i></span><span>零基础友好 · 按问题探索 · 来源可追溯</span></div></div><div class="hero-visual"><PortMap/><div class="map-note"><Icon name="map" size={16}/><span>一个节点，一条线索。点击地图开始。</span></div></div></section>
<section class="home-start container" aria-labelledby="home-start-title">
  <div class="home-start-heading">
    <div><span class="eyebrow"><span></span>CHOOSE YOUR START / 选择一个入口</span><h2 id="home-start-title">你想从哪一种方式看懂港口？</h2></div>
    <p>不用先记住所有术语。选一条你最关心的线，先看到完整关系，再回头补设备、系统、监管和经营细节。</p>
  </div>
  <div class="home-start-grid">
    {learningPaths.map(path=><a class:list={["home-path-card",path.tone]} href={base+path.href}>
      <div class="home-path-top"><span class="home-path-icon"><Icon name={path.icon} size={23}/></span><span class="home-path-number">{path.no}</span></div>
      <h3>{path.title}</h3>
      <p>{path.text}</p>
      <span class="home-path-action">{path.action} <Icon name="arrow" size={16}/></span>
    </a>)}
  </div>
  <div class="port-lines" aria-labelledby="port-lines-title">
    <div class="port-lines-heading"><span class="eyebrow">THE FIVE LINES / 港口五条线</span><h3 id="port-lines-title">每个业务节点，都同时回答五个问题</h3><p>看实物怎么走，也看信息、责任、授权和费用怎样一起闭环。</p></div>
    <ol class="port-lines-grid">
      {portLines.map(([label,title,detail],i)=><li><span class="port-line-index">0{i+1}</span><strong>{label}</strong><span>{title}</span><small>{detail}</small></li>)}
    </ol>
  </div>
</section>
<section class="stats-strip container" aria-label="知识库概览"><div><strong>{domains.length}<small>个</small></strong><span>知识领域</span></div><div><strong>{articles.length}<small>篇</small></strong><span>入门知识卡</span></div><div><strong>{scenarios.length}<small>条</small></strong><span>业务场景</span></div><div class="stats-message"><Icon name="book" size={25}/><span>先看全景，再懂细节。<small>同一份知识，从不同入口发现。</small></span></div></section>
<section class="container"><BerthingEntry/><LearningEntry/><div class="foundation-entry"><div><span class="eyebrow">PORT FOUNDATIONS / 补上港口的全局逻辑</span><h3>谁来决定、怎样建设、如何连接城市？</h3><p>五个案例，串起航线腹地、治理分工、资产生命周期、环境协同与空间层级。</p></div><a class="text-link" href={base+'foundations/'}>打开基础专题 →</a></div></section>
<section class="section container"><div class="journey-home-banner"><div><span class="eyebrow">NEW / 从图解到一段旅程</span><h2>箱子往前走，信息怎样跟上？</h2><p>在七个节点之间切换，看看实物在哪里、谁接手、系统记录了什么。还可以试着处理三种常见的教学异常。</p><a class="button primary" href={base+'journey/'}>开始进口箱旅程 <Icon name="arrow" size={17}/></a></div><div class="journey-banner-route" aria-label="船舶、集装箱、闸口到内陆的教学路线"><div><Icon name="ship" size={36}/>船舶</div><i></i><div><div class="journey-box-mini" aria-hidden="true"></div>示例箱 A</div><i></i><div><Icon name="gate" size={36}/>闸口与内陆</div></div></div><div class="systems-home-strip"><Icon name="grid" size={26}/><div><span class="eyebrow">THE SYSTEMS BEHIND THE PORT</span><h3>集装箱系统、件杂货系统，分别管什么？</h3><p>认识生产、闸口与设备控制，再看海关、口岸平台及外部业务方如何交换信息。</p></div><a class="text-link" href={base+'systems/'}>打开港口系统图谱 <Icon name="arrow" size={17}/></a></div></section>
<section class="container"><div class="cargo-home-entry"><div><span class="eyebrow">NEW / 从一种箱，看到不同的货</span><h3>风叶、木材、卷钢，怎样经过港口？</h3><p>打开 12 种箱型图鉴与 {cargoProfiles.length} 个货类专题，看清不同货物的运输方式、岗位接力、闸口校验和费用来源。</p><a class="button primary" href={base+'cargo/'}>打开箱型与货类 <Icon name="arrow" size={17}/></a></div><div class="cargo-home-miniatures">{[['wind-blade','风电叶片'],['timber','木材'],['steel-coil','卷钢']].map(([id,label])=><a href={base+'cargo/'+id+'/'}><img src={base+'illustrations/cargo/'+id+'.svg'} alt={label+'教学线稿'} width="720" height="360" loading="lazy"/>{label} ↗</a>)}</div></div></section><section class="container"><VesselEntry/></section><section class="container"><RiskEntry compact riskIds={['traffic','lifting','identity']}/></section><section class="section container"><div class="section-heading"><div><div class="eyebrow muted">EXPLORE THE PORT</div><h2>从你感兴趣的地方开始</h2></div><a class="text-link" href={base+'library/'}>查看全部主题 <Icon name="arrow" size={18}/></a></div><div class="entry-grid">{entries.map(e=><a href={base+e.href} class:list={['entry-card',e.tone]}><div class="entry-top"><span class="entry-icon"><Icon name={e.icon} size={30}/></span><span>{e.no}</span></div><span class="entry-tag">{e.tag}</span><h3>{e.title}</h3><p>{e.text}</p><span class="entry-go"><Icon name="arrow" size={20}/></span></a>)}</div></section>
<section class="section container equipment-feature"><div class="section-heading"><div><div class="eyebrow muted">LOOK CLOSER / 港口设备观察</div><h2>认出这些轮廓，港口就近了一步。</h2></div><a class="text-link" href={base+'equipment/'}>打开设备图册 <Icon name="arrow" size={18}/></a></div><div class="article-grid equipment-grid">{['eq-sts','eq-rtg','eq-reachstacker'].map(id=><EquipmentCard article={articles.find(a=>a.id===id)} compact/>)}</div><a class="document-banner" href={base+'documents/'}><span class="document-banner-icon" aria-hidden="true">▤</span><div><span class="eyebrow muted">READ THE DOCUMENTS</span><h3>单证里的每一栏，在说明什么？</h3><p>点开一份教学样张，分清对象、委托、记录和授权。</p></div><span class="document-banner-arrow" aria-hidden="true">↗</span></a></section>
<section class="question-band"><div class="container question-layout"><div class="question-heading"><div class="eyebrow">FOLLOW THE QUESTION</div><h2>那些你想问的<br/>“为什么”</h2><p>从一个真实的疑问出发，<br/>顺着业务关系找到答案。</p><a class="text-link" href={base+'gate/'}>体验闸口业务 <Icon name="arrow" size={18}/></a></div><div class="question-list">{questions.map(([title,url,text],i)=><a href={base+url}><span class="question-number">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div><Icon name="arrow" size={21}/></a>)}</div></div></section>
<section class="section container"><div class="section-heading"><div><div class="eyebrow muted">A GOOD PLACE TO START</div><h2>先认识这些关键概念</h2></div><a class="text-link" href={base+'library/'}>全部知识卡 <Icon name="arrow" size={18}/></a></div><div class="article-grid">{articles.filter(a=>a.level==='入门').slice(0,3).map((a,i)=><ArticleCard article={a} number={i+1}/>)}</div></section>
<section class="learning-banner container"><div><span class="eyebrow">你的港口学习路线</span><h2>看懂一个节点，再连成完整的一程。</h2><p>从全景到岗位，从作业到交接。每个主题都能继续追问。</p></div><a class="button light" href={base+'knowledge-map/'}>选择学习路线 <Icon name="arrow" size={18}/></a></section></Layout>

<style>
  .home-start { margin-top: -8px; margin-bottom: 24px; }
  .home-start-heading { display:flex; align-items:end; justify-content:space-between; gap:30px; margin-bottom:20px; }
  .home-start-heading h2 { font-size:clamp(25px,3vw,34px); margin:12px 0 0; }
  .home-start-heading > p { max-width:390px; margin:0; font-size:13px; line-height:1.85; color:#526862; }
  .home-start-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
  .home-path-card { display:flex; flex-direction:column; min-height:194px; padding:22px; border:1px solid var(--line); border-radius:14px; background:#fff; transition:transform .2s,border-color .2s,box-shadow .2s; }
  .home-path-card:hover { transform:translateY(-3px); border-color:#9ab1a7; box-shadow:0 12px 26px #24463d12; }
  .home-path-card.teal { background:#eef4ef; }
  .home-path-card.sand { background:#f6f1e7; }
  .home-path-card.blue { background:#edf2f2; }
  .home-path-top { display:flex; align-items:center; justify-content:space-between; color:#416d65; }
  .home-path-icon { display:grid; place-items:center; width:39px; height:39px; border:1px solid #b8ccc0; border-radius:10px; background:#ffffffa8; }
  .home-path-number { font:13px Georgia,serif; color:#6f837a; letter-spacing:1px; }
  .home-path-card h3 { margin:18px 0 8px; font-size:21px; }
  .home-path-card p { margin:0; font-size:13px; line-height:1.8; color:#536a63; }
  .home-path-action { display:inline-flex; align-items:center; gap:8px; margin-top:auto; padding-top:18px; color:var(--deep); font-size:12px; font-weight:650; }
  .port-lines { display:grid; grid-template-columns:minmax(230px,.82fr) minmax(0,2fr); gap:24px; align-items:center; margin-top:15px; padding:20px 22px; border:1px solid #d3dfd6; border-radius:14px; background:#f0f4ee; }
  .port-lines-heading h3 { margin:9px 0 5px; font-size:18px; }
  .port-lines-heading p { margin:0; font-size:12px; line-height:1.75; color:#526862; }
  .port-lines-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:0; list-style:none; padding:0; margin:0; }
  .port-lines-grid li { min-width:0; padding:2px 14px; border-left:1px solid #d0dcd3; }
  .port-lines-grid li:first-child { border-left:0; }
  .port-line-index { display:block; margin-bottom:8px; color:#789087; font:11px Georgia,serif; letter-spacing:1px; }
  .port-lines-grid strong { display:block; margin-bottom:3px; font-size:13px; color:var(--ink); }
  .port-lines-grid li > span:not(.port-line-index) { display:block; font-size:11px; line-height:1.55; color:#405c55; }
  .port-lines-grid small { display:block; margin-top:7px; font-size:11px; line-height:1.55; color:#667a73; }
  @media (max-width:950px) {
    .home-start-heading { align-items:flex-start; flex-direction:column; gap:10px; }
    .home-start-heading > p { max-width:620px; }
    .port-lines { grid-template-columns:1fr; gap:18px; }
    .port-lines-grid { grid-template-columns:repeat(5,minmax(0,1fr)); }
    .port-lines-grid li { padding-inline:10px; }
  }
  @media (max-width:700px) {
    .home-start { margin-top:0; margin-bottom:18px; }
    .home-start-heading h2 { font-size:26px; }
    .home-start-grid { grid-template-columns:1fr; gap:10px; }
    .home-path-card { min-height:0; padding:19px; }
    .home-path-card h3 { font-size:19px; }
    .port-lines { padding:18px; }
    .port-lines-grid { grid-template-columns:1fr; gap:0; }
    .port-lines-grid li,
    .port-lines-grid li:first-child { padding:12px 0; border-left:0; border-top:1px solid #d0dcd3; }
    .port-lines-grid li:first-child { padding-top:0; border-top:0; }
  }
  @media (prefers-reduced-motion:reduce) {
    .home-path-card:hover { transform:none; }
  }

  .hero-proof,
  .map-note,
  .eyebrow.muted {
    color: #465c55;
    font-size: 12px;
  }
  .hero-proof .tiny-avatars i { color: #35564e; }
</style>
