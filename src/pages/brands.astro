---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import LearningActions from '../components/LearningActions.astro';
import Icon from '../components/Icon.astro';
import { brandCategories, brandHandoffs, brandSources, portBrands } from '../data/brand-guide.js';
import '../styles/brands.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sourceById = Object.fromEntries(brandSources.map((source) => [source.id, source]));
---

<Layout title="箱体品牌与港航公司" active="cargo" description="看懂马士基、中远海运、OOCL、MSC、ONE、熊猫船长和宁波舟山港、上海港；分清承运人、箱体资产方、制造商与码头运营者。">
  <PageIntro eyebrow="CONTAINER BRANDS / 箱体品牌与港航公司" title="认涂装，也要认清背后的主体。" description="马士基、COSCO、OOCL、MSC、ONE 的字样能给你线索；港口、船公司、箱体产权人和制造商，却不是同一类角色。">
    <a class="text-link" href={base + 'containers/'}>← 回到集装箱箱型图鉴</a>
  </PageIntro>

  <div class="container brand-guide">
    <section class="brand-open" aria-label="箱体品牌识别示意">
      <div class="brand-open-copy">
        <span class="eyebrow">FIRST CLUE / 先看它是什么线索</span>
        <h2>箱子上的名字，<br/>不等于箱子的全部身份。</h2>
        <p>一个箱体可能有品牌涂装、箱号、制造铭牌和本票运输信息。它们分别告诉你不同的事。</p>
        <div class="brand-open-links"><a href="#company-roles">按公司角色浏览 <Icon name="arrow" size={16}/></a><a href="#read-a-container">如何核实一只箱 <Icon name="arrow" size={16}/></a></div>
      </div>
      <div class="brand-box-showcase" aria-label="船公司涂装示意，不代表真实箱体或所有权">
        <div class="brand-box box-maersk"><div class="box-ribs" aria-hidden="true">{Array.from({length: 13}, () => <i/>)}</div><strong>MAERSK</strong><small>品牌字样 / 示例</small><span class="box-code">MSKU 123456 7</span></div>
        <div class="brand-box box-one"><div class="box-ribs" aria-hidden="true">{Array.from({length: 13}, () => <i/>)}</div><strong>ONE</strong><small>洋红色 / 企业品牌色</small><span class="box-code">ONEU 234567 8</span></div>
        <p>涂装示意 · 箱号为虚构教学示例</p>
      </div>
    </section>

    <section class="brand-role-map" id="company-roles">
      <div class="brand-section-heading"><div><span class="eyebrow muted">WHO DOES WHAT</span><h2>一只箱背后，四类主体接力。</h2></div><p>同一企业集团可能经营多类业务，但每个业务环节仍要看具体公司和委托关系。</p></div>
      <div class="brand-handoff-flow" aria-label="箱体运输相关主体关系示意">
        {brandHandoffs.map((item, index) => <>
          <article class="brand-handoff"><span>0{index + 1}</span><h3>{item.label}</h3><p>{item.text}</p></article>
          {index < brandHandoffs.length - 1 && <Icon name="arrow" size={19} />}
        </>)}
      </div>
      <div class="brand-parallel-checks"><strong>另有并行状态，不是“船公司说了算”：</strong><span>监管状态</span><i>＋</i><span>商业放箱</span><i>＋</i><span>码头作业与提箱条件</span><b>→</b><span>共同决定这一票业务下一步是否可做</span></div>
    </section>

    <section class="brand-finder" aria-label="公司与主体分类">
      <div class="brand-section-heading"><div><span class="eyebrow muted">COMPANY FIELD GUIDE</span><h2>按它在港口里做什么来认识。</h2></div><span class="brand-filter-count" id="brand-filter-count" aria-live="polite">共 {portBrands.length} 个主体示例</span></div>
      <div class="filter-bar brand-filters" aria-label="按港航业务角色筛选">
        {brandCategories.map((category, index) => <button type="button" class="filter-chip" data-brand-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}
      </div>
      <div class="brand-card-grid" id="brand-card-grid">
        {portBrands.map((brand, index) => <article class="brand-card" data-brand-card data-brand-category={brand.category} id={'brand-' + brand.id}>
          <div class:list={['brand-card-visual', 'tone-' + brand.tone]} aria-label={brand.name + ' 品牌文字示意'}>
            <span class="brand-sheet-no">FIELD NOTE / {String(index + 1).padStart(2, '0')}</span>
            <div class="brand-mini-container"><div class="mini-ribs" aria-hidden="true">{Array.from({length: 11}, () => <i/>)}</div><strong>{brand.mark}</strong><span>BOX / LIVERY STUDY</span></div>
          </div>
          <div class="brand-card-body">
            <div class="brand-card-title"><div><span class="brand-role-tag">{brand.category}</span><h3>{brand.name}</h3><p class="brand-english">{brand.english}</p></div><a class="brand-card-anchor" href={'#brand-' + brand.id} aria-label={'定位到' + brand.name}><Icon name="arrow" size={18}/></a></div>
            <p>{brand.summary}</p>
            <dl class="brand-facts"><div><dt>识别线索</dt><dd>{brand.clue}</dd></div><div><dt>别混淆</dt><dd>{brand.distinction}</dd></div></dl>
            <div class="brand-source-links"><span>参考：</span>{brand.sources.map((id) => <a href={'#source-' + id}>{sourceById[id]?.org ?? id}</a>)}</div>
          </div>
        </article>)}
      </div>
    </section>

    <section class="brand-feature-pair" id="pink-and-panda">
      <article class="brand-feature one-feature" id="pink-container">
        <div class="feature-container-art" aria-hidden="true"><div class="feature-ribs">{Array.from({length: 12}, () => <i/>)}</div><strong>ONE</strong><span>MAGENTA</span></div>
        <div><span class="eyebrow">THE PINK CONTAINER / 粉色箱</span><h2>大概率是 ONE 的洋红色箱。</h2><p>ONE 官方页面说明选择洋红色作为企业品牌色，并明确展示洋红色集装箱。它是醒目的涂装识别，不是一种箱型；不同批次、箱东或特殊宣传箱也可能有其他颜色。</p><a class="text-link" href="#source-one-color">看 ONE 官方品牌说明 <Icon name="arrow" size={16}/></a></div>
      </article>
      <article class="brand-feature panda-feature" id="panda-container">
        <div class="panda-container-art" aria-hidden="true"><div class="panda-art-lines"></div><strong>熊猫船长</strong><span>COSCO SHIPPING / MASCOT</span></div>
        <div><span class="eyebrow">THE PANDA / 熊猫箱</span><h2>“熊猫船长”是吉祥物，不是箱型。</h2><p>中远海运官方活动报道把“熊猫船长”作为活动形象介绍。这个说法不能证明所有熊猫图案箱都属于中远海运，也不能证明有一种标准“熊猫箱”。如果看到具体箱体，先核对箱号、当前承运信息和业务单证。</p><a class="text-link" href="#source-panda">看中远海运官方活动报道 <Icon name="arrow" size={16}/></a></div>
      </article>
    </section>

    <section class="brand-read-box" id="read-a-container">
      <div class="brand-section-heading"><div><span class="eyebrow muted">READ THE MARKS</span><h2>现场遇到一只箱，按这个顺序看。</h2></div><span>颜色用于初筛；编号和业务记录用于核对</span></div>
      <div class="brand-check-grid">
        <article><span>01</span><h3>先记完整箱号</h3><p>常见箱号由 3 位字母代码、设备类别代码、6 位数字和 1 位校验码组成。前三位是登记代码，供查找登记的箱体所有人或主要运营者。</p><a href="#source-bic">BIC 箱号说明 ↗</a></article>
        <article><span>02</span><h3>确认这票由谁承运</h3><p>核对订舱确认、提单及承运人记录。箱体涂装、品牌网站和船舶挂靠都不能代替本票运输单证。</p><a href={base + 'documents/'}>继续看运输单证 →</a></article>
        <article><span>03</span><h3>不要把箱号当产权证</h3><p>登记代码有助于识别箱体，但不一定等于当前法律产权人；要核实资产关系，应结合租赁、购买或设备管理记录。</p><a href="#source-bic-cir">了解登记信息的范围 ↗</a></article>
        <article><span>04</span><h3>落到实际港区与码头</h3><p>“上海港”或“宁波舟山港”是港口范围名称；实际作业位置要继续查港区、码头、泊位与对应运营主体。</p><a href={base + 'berthing/'}>了解船舶靠泊 →</a></article>
      </div>
    </section>

    <details class="brand-open-questions">
      <summary>为什么不能只看箱子的颜色和大字？</summary>
      <p>箱体可以出租、转售、调拨、换涂装或用于临时宣传；运输承运人、箱体运营者、法律产权人、制造商和当前码头是不同问题。先拍全箱号及箱门标识，再对照船公司和港口记录，才更接近本票业务的真实关系。</p>
    </details>

    <section class="brand-source-section" id="brand-sources">
      <div class="brand-section-heading"><div><span class="eyebrow muted">PRIMARY REFERENCES</span><h2>企业和行业组织资料</h2></div><span>已核对页面：2026-11-23</span></div>
      <p class="brand-source-note">企业介绍用于说明其自身公开的业务定位，不是中立排名或服务评价。照片/涂装可能随时间变化；业务归属、法律产权及实际办理要求仍以本票合同、单证和对应港区资料为准。</p>
      <ol class="brand-source-list">{brandSources.map((source) => <li id={'source-' + source.id}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a><small>{source.org} · {source.date}</small><p>{source.scope}</p></li>)}</ol>
    </section>

    <nav class="brand-crosslinks" aria-label="继续学习相关专题">
      <a href={base + 'containers/'}><strong>集装箱箱型</strong><span>结构、箱号与交接信息 →</span></a>
      <a href={base + 'brands-and-ports/'}><strong>上海港与宁波舟山港</strong><span>从港口名称追到具体码头和现场作业 →</span></a>
      <a href={base + 'systems/'}><strong>港口系统</strong><span>船公司、码头与监管信息如何衔接 →</span></a>
      <a href={base + 'gate/'}><strong>闸口与监管</strong><span>到港后如何核验放行与提箱条件 →</span></a>
    </nav>
  </div>

  <script>
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-brand-filter]')];
    const brandCards = [...document.querySelectorAll<HTMLElement>('[data-brand-card]')];
    const count = document.querySelector<HTMLElement>('#brand-filter-count');
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      const category = button.dataset.brandFilter ?? '全部';
      let visible = 0;
      brandCards.forEach((card) => {
        const show = category === '全部' || card.dataset.brandCategory === category;
        card.hidden = !show;
        if (show) visible += 1;
      });
      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      if (count) count.textContent = category === '全部' ? `共 ${visible} 个主体示例` : `${category} · ${visible} 个主体示例`;
    }));
  </script>
</Layout>
