---
import RiskEntry from '../components/RiskEntry.astro';
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const inputs=[['volume','月作业量','次',10000,100000,1000,40000],['rate','平均装卸收入','元／次',100,900,10,400],['extraPerUnit','平均其他服务收入','元／次',0,300,5,50],['variablePerUnit','平均变动成本','元／次',50,700,10,180],['fixedCost','月固定经营成本','万元',100,1500,10,600],['depreciation','月折旧','万元',0,500,10,150]];
---
<Layout title="经营逻辑" active="economics" description="区分码头、港口集团与船公司的收入，通过假设测算理解作业量、费率、成本和利润的关系。"><div class="container"><PageIntro eyebrow="PORT ECONOMICS" title="港口的利润，从哪里来？" description="先看是谁提供服务、向谁收费，再把收入减去匹配的成本。吞吐量增长，不代表利润一定增长。"/><div class="page-content">
<div class="three-panels"><div class="panel"><span class="pill">码头运营主体</span><h2>围绕实际服务</h2><p>按合同取得装卸、堆存、仓储及适用配套服务收入。并非每个码头都提供所有服务，也不能把整条物流链费用计入自己收入。</p></div><div class="panel"><span class="pill">港口集团／港口管理方</span><h2>看资产与经营边界</h2><p>可能包括码头经营、租赁、物流等不同业务。集团合并报表与单个码头的收入、成本和利润不是同一口径。</p></div><div class="panel"><span class="pill">船公司／其他服务商</span><h2>收费归属另行辨认</h2><p>海运费、适用的集装箱使用费、代理费和陆运费可能属于不同主体。码头堆存与箱体使用收费应分开判断。</p></div></div>
<section class="profit-simulator section-top" aria-labelledby="profit-title"><div class="sim-top"><div><span class="eyebrow">A FICTIONAL TERMINAL</span><h2 id="profit-title">算一笔码头经营账</h2></div><button id="reset-profit" class="button outline">恢复假设</button></div><div class="notice warning">纯教学假设 · 所有数值为虚构、金额按人民币展示，不是费率报价、行业平均或投资预测。统一使用“作业次”，不等同于 TEU；假设月内服务均已确认收入。</div><div class="profit-grid"><div class="profit-inputs">{inputs.map(([id,label,unit,min,max,step,value])=><label class="range-row" for={'profit-'+id}><span><strong>{label}</strong><output id={'output-'+id}>{value}</output><small>{unit}</small></span><input type="range" id={'profit-'+id} data-key={id} min={min} max={max} step={step} value={value}/></label>)}</div><div class="profit-results" aria-live="polite" aria-atomic="true"><span class="eyebrow">MONTHLY OPERATING RESULT</span><p class="result-label">简化经营结果</p><div class="profit-big"><strong id="profit-value">—</strong><span>万元／月</span></div><div id="profit-chart" class="profit-bars"></div><dl class="profit-breakdown"><div><dt>经营利润率</dt><dd id="profit-margin">—</dd></div><div><dt>单次边际贡献</dt><dd id="profit-contribution">—</dd></div><div><dt>盈亏平衡作业量</dt><dd id="profit-break-even">—</dd></div></dl><p id="profit-explain" class="small-copy"></p></div></div><p class="formula">（平均装卸收入 + 平均其他服务收入 − 平均变动成本）× 作业量 − 固定经营成本 − 折旧</p><p class="small-copy">固定经营成本假设不含折旧；未纳入财务费用、所得税、投资收益及其他调整，因此不是净利润。折旧不是当期现金支出，设备购置也不能在本模型里直接作为当月经营成本扣完。</p></section>
<div class="section-heading section-top"><div><div class="eyebrow">READ THE NUMBERS</div><h2>数字背后的运营问题</h2></div></div><div class="two-column"><div class="panel"><h2>为什么箱多，也可能不赚钱？</h2><p>要看单次服务收入能否覆盖变动成本，以及剩下的贡献能否覆盖固定成本和折旧。低价增量、翻箱、拥堵和故障都可能改变成本；本模型未模拟产能和费率联动。</p></div><div class="panel"><h2>为什么堆得久，也不一定更好？</h2><p>堆存可能产生合同收入，但占用空间、增加搬倒和拥堵也有成本。应结合堆场容量、停留时间、吞吐效率和服务承诺理解，不能单凭堆存天数判断经营质量。</p></div><div class="panel"><h2>从生产实绩到收费凭证</h2><p>实际提供了什么服务 → 谁承担费用 → 合同规定怎样计量 → 实绩是否可核对 → 计费审核、结算与收款。财务不能用未完成的计划直接替代收费事实。</p><a class="text-link" href={base+'roles/#collaboration-completion-settlement'}>看部门交接 <Icon name="arrow"/></a></div><div class="panel"><h2>继续了解费用与经营指标</h2><p>费用名称、免费期、结算安排和收款主体须结合合同与当地规则。知识卡区分经营分析与教学例子，并列出原始资料。</p><a class="text-link" href={base+'library/?kind=经营'}>查看经营知识卡 <Icon name="arrow"/></a><ul class="source-list"><li><a href="https://www.portofrotterdam.com/en/about-port-authority/finance/annual-reports" target="_blank" rel="noopener noreferrer">鹿特丹港年度报告：港口管理方实例</a></li><li><a href="https://terms.maersk.com/dnd" target="_blank" rel="noopener noreferrer">马士基 D&amp;D 条款：承运人收费实例</a></li></ul></div></div>
</div></div><div class="container"><RiskEntry compact riskIds={["commercial","weather","continuity"]}/></div></Layout>
<script>
import {calculateEconomics} from '../lib/economics-model.mjs';const fields=[...document.querySelectorAll<HTMLInputElement>('[data-key]')];const fmt=(v:number)=>new Intl.NumberFormat('zh-CN',{maximumFractionDigits:1}).format(v);const set=(id:string,text:string)=>{document.getElementById(id)!.textContent=text;};function update(){const data:Record<string,number>={};fields.forEach(i=>{const key=i.dataset.key!;data[key]=Number(i.value)*(['fixedCost','depreciation'].includes(key)?10000:1);set('output-'+key,fmt(Number(i.value)));});const r=calculateEconomics(data as any);set('profit-value',fmt(r.operatingProfit/10000));document.getElementById('profit-value')!.classList.toggle('negative',r.operatingProfit<0);set('profit-margin',r.margin===null?'无收入时不计算':fmt(r.margin*100)+'%');set('profit-contribution',fmt(r.contribution)+' 元／次');set('profit-break-even',r.breakEven===null?'无法达到（边际贡献 ≤ 0）':fmt(Math.ceil(r.breakEven))+' 次／月');set('profit-explain',r.breakEven===null?'每增加一次作业也无法贡献足够金额，单靠增量不能覆盖固定成本。':r.breakEven>100000?'在当前参数下，盈亏平衡点高于滑块上限；模型未对实际产能作承诺。':'假设其他条件不变，达到该作业量可覆盖本模型内的成本。');const chart=document.getElementById('profit-chart')!;chart.replaceChildren();const bars=[['服务收入',r.revenue,'income'],['变动成本',r.variableCost,'cost'],['固定成本',data.fixedCost,'cost'],['折旧',data.depreciation,'depreciation']];const max=Math.max(...bars.map(b=>b[1] as number),1);bars.forEach(([label,value,kind])=>{const row=document.createElement('div');row.className='profit-bar-row';const head=document.createElement('span');head.textContent=label+' · '+fmt((value as number)/10000)+' 万元';const track=document.createElement('div');const bar=document.createElement('i');bar.className=kind as string;bar.style.width=((value as number)/max*100)+'%';track.append(bar);row.append(head,track);chart.append(row);});}fields.forEach(i=>i.addEventListener('input',update));document.getElementById('reset-profit')!.addEventListener('click',()=>{fields.forEach(i=>i.value=i.defaultValue);update();});update();
</script>
