---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import {documentExamples} from '../data/document-examples.js';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const types=[{title:'运输单证',text:'连接运输合同与交付安排。先看它在什么运输关系中使用。',note:'不能用来代替所有监管和现场条件。',article:'k18-overview'},{title:'舱单信息',text:'服务运输工具及所载货物信息报送，强调对象与信息的对应。',note:'收到报文，不等于已作出放行决定。',article:'gate-messages'},{title:'作业委托',text:'向执行方说明要做什么，帮助形成具体作业任务。',note:'请求已接收，不等于实物作业已完成。',article:'k18-overview'},{title:'交接记录',text:'留下实际交接对象、观察结果、时间和参与方等线索。',note:'现场观察与最终责任判断需要区分。',article:'k17-overview'}];
---
<Layout title="单证图解" active="library" description="点开教学样张，理解任务标识、参与方、作业请求、实际交接和并行状态。"><div class="container"><PageIntro eyebrow="READ THE DOCUMENTS / 单证观察手册" title="一份资料，到底在说明什么？" description="不急着背缩写。先看谁提供、给谁使用、对应什么对象，以及它能证明哪一件事。点击样张中的编号，逐栏理解。"/><div class="page-content"><div class="filter-bar" aria-label="选择教学样张">{documentExamples.map((d,i)=><button class="filter-chip" data-document-select={d.id} aria-pressed={i===0?'true':'false'} aria-controls={'document-'+d.id}>{d.name}</button>)}</div>{documentExamples.map((d,di)=><section class="document-example" id={'document-'+d.id} hidden={di!==0}><div class="documents-layout"><div class="document-sheet"><div class="sheet-top"><div><span class="eyebrow">{d.english}</span><h2>{d.name}</h2></div><span>DEMO / 0{di+1}</span></div><p class="sheet-meta">示意编号 DEMO-{String(di+1).padStart(2,'0')} · 点击下方信息区</p><div>{d.fields.map((f,i)=><button class="doc-field" data-doc-field={i} aria-pressed={i===0?'true':'false'} aria-controls={'doc-detail-'+d.id+'-'+i}><span class="doc-field-header"><b>{String(i+1).padStart(2,'0')}</b>{f.label}</span><strong>{f.value}</strong><small>{f.small}</small></button>)}</div></div><div class="doc-explanation"><span class="eyebrow">{d.title}</span><p>{d.intro}</p><div aria-live="polite">{d.fields.map((f,i)=><div class="doc-detail-panel" id={'doc-detail-'+d.id+'-'+i} hidden={i!==0}><h2>{f.title}</h2><p>{f.description}</p><dl><div><dt>信息从哪里来</dt><dd>{f.source}</dd></div><div><dt>重点核对什么</dt><dd>{f.check}</dd></div></dl><div class="document-detail">{f.limit}</div></div>)}</div></div></div></section>)}<noscript><p>交互解释需要 JavaScript；下方相关知识文章提供完整的文字说明。</p></noscript><div class="notice">样张内的主体、编号、箱名与时间均为虚构。页面展示信息关系，不是正式单证模板、全国统一字段表或真实接口格式。</div><section class="section-top"><div class="section-heading"><div><span class="eyebrow muted">FOUR DIFFERENT QUESTIONS</span><h2>名字相近，解决的问题不同。</h2></div></div><div class="document-types">{types.map((t,i)=><article class="document-type"><svg class="paper-icon" viewBox="0 0 60 76" fill="none" aria-hidden="true"><path d="M7 2h32l14 14v58H7z" stroke="currentColor" stroke-width="1.5"/><path d="M39 2v15h14M16 29h27M16 37h27M16 45h17" stroke="currentColor"/><text x="16" y="65" fill="currentColor" font-size="11" font-family="Georgia">0{i+1}</text></svg><h3>{t.title}</h3><p>{t.text}</p><small>{t.note}</small><a class="text-link" href={base+'knowledge/'+t.article+'/'}>继续看知识图解 <Icon name="arrow" size={15}/></a></article>)}</div></section><div class="learning-banner"><div><h2>有资料，为什么还过不了闸口？</h2><p>把对象、授权、现场通行和回执放到一次任务里看。</p></div><a class="button light" href={base+'gate/'}>体验闸口任务 <Icon name="arrow"/></a></div></div></div>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-document-select]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-document-select]').forEach(other=>other.setAttribute('aria-pressed',String(other===b)));document.querySelectorAll<HTMLElement>('.document-example').forEach(panel=>panel.hidden=panel.id!=='document-'+b.dataset.documentSelect);}));document.querySelectorAll<HTMLElement>('.document-example').forEach(root=>root.querySelectorAll<HTMLButtonElement>('[data-doc-field]').forEach(b=>b.addEventListener('click',()=>{root.querySelectorAll('[data-doc-field]').forEach(other=>other.setAttribute('aria-pressed',String(other===b)));root.querySelectorAll<HTMLElement>('.doc-detail-panel').forEach(panel=>panel.hidden=panel.id!==b.getAttribute('aria-controls'));})));
</script></Layout>