---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BerthingMap from '../components/BerthingMap.astro';
import {berthingSteps,berthingRoles,berthingGlossary,berthingAftercare,berthingMisconceptions,berthingSources} from '../data/berthing-learning.js';
import {readinessChecks,readinessCases} from '../data/berthing-exercises.js';
import '../styles/berthing.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tracks=[['ship','船上做什么'],['shore','岸上谁接手'],['records','信息怎样传'],['conditions','凭什么继续'],['handoff','交给下一环节']];
---
<Layout title="船舶进港与靠泊" active="flows" description="从到港预报、锚地候泊、引航和航道，到拖轮协助、靠泊系缆与装卸准备，用九个节点看懂船到泊位前的业务。">
<div class="container berthing-page">
<div class="breadcrumbs"><a href={base}>首页</a><Icon name="chevron" size={12}/><a href={base+'flows/'}>业务流程</a><Icon name="chevron" size={12}/><span>船舶进港与靠泊</span></div>
<header class="berth-hero"><div><span class="eyebrow">BEFORE THE BERTH / 从海上，到岸边</span><h1>船到港了，<br/><em>为什么还没靠岸？</em></h1><p>到港、进港、靠妥、开工，是不同的事。沿着一艘船的进港旅程，看清水域、岗位和每一次条件确认。</p><div class="berth-actions"><a class="button primary" href="#arrival-journey">跟船走九站 <Icon name="arrow" size={17}/></a><a class="text-link" href="#readiness-lab">试试：这艘船还在等什么？ ↓</a></div></div><aside><span>先记住四个时刻</span><ol><li><b>到港</b><small>到达约定的港口到达位置</small></li><li><b>进港</b><small>按实际安排驶入相关水域</small></li><li><b>靠妥</b><small>靠泊系缆状态由责任方确认</small></li><li><b>开工</b><small>装卸所需条件另行核对</small></li></ol><p>具体时间点的记录口径依港口、系统与合同约定。</p></aside></header>
<nav class="berth-section-nav" aria-label="船舶进港专题目录"><a href="#arrival-journey">水域与九站旅程</a><a href="#berth-roles">谁与谁协作</a><a href="#readiness-lab">等待条件演示</a><a href="#berth-glossary">术语与时间</a><a href="#after-berthing">移泊与离港</a></nav>
<section class="berth-section" id="arrival-journey"><div class="berth-section-head"><div><span class="eyebrow">01 / FOLLOW THE SHIP</span><h2>先认位置，再看业务怎样接力。</h2></div><p>节点是阅读顺序。预报、手续、资源准备常常并行；候泊也不只有一种安排。</p></div>
<BerthingMap/>
<nav class="berth-stops" aria-label="船舶进港九个教学节点">{berthingSteps.map((s,i)=><a href={'#stage-'+s.id} data-berth-step={s.id}><span>{String(i+1).padStart(2,'0')}</span><strong>{s.title}</strong></a>)}</nav>
<div class="berth-controls" data-berth-controls hidden><button type="button" data-berth-prev>← 上一站</button><p role="status" data-berth-position>第 1 站 / 共 {berthingSteps.length} 站</p><button type="button" data-berth-next>下一站 →</button></div>
<div class="berth-stages">{berthingSteps.map((s,i)=><article class="berth-stage" id={'stage-'+s.id} data-berth-panel={s.id}><header><span class="berth-stage-number">{String(i+1).padStart(2,'0')}</span><div><span class="eyebrow">{s.place}</span><h3>{s.title}</h3><p>{s.summary}</p></div></header><dl class="berth-tracks">{tracks.map(([key,label],n)=><div><dt><span>0{n+1}</span>{label}</dt><dd>{s[key]}</dd></div>)}</dl><div class="berth-hold"><strong>如果这里发生变化</strong><p>{s.exception}</p></div><footer><div class="berth-terms">{s.terms.map(t=><span>{t}</span>)}</div><div class="berth-step-sources">依据：{s.sourceIds.map(id=><a href={'#berth-source-'+id}>{berthingSources.find(x=>x.id===id)?.org ?? id}</a>)}</div></footer></article>)}</div>
<noscript><p>未启用脚本时，九个节点完整展开，可点击编号跳到相应内容。</p></noscript></section>
<section class="berth-section" id="berth-roles"><div class="berth-section-head"><div><span class="eyebrow">02 / PEOPLE & HANDOFFS</span><h2>一艘船靠岸，需要哪些人？</h2></div><p>码头排泊位、海事管理通航、引航提供专业服务，船上与岸上各自承担职责。</p></div><div class="berth-role-grid">{berthingRoles.map((r,i)=><article><span class="berth-card-number">{String(i+1).padStart(2,'0')} / 协作角色</span><h3>{r.name}</h3><p>{r.does}</p><dl><dt>收到</dt><dd>{r.receives}</dd><dt>交出</dt><dd>{r.handsOff}</dd></dl><details><summary>这个岗位的职责边界</summary><p>{r.boundary}</p></details></article>)}</div><div class="berth-note"><b>系统怎样配合？</b><p>船代传递预报与申报资料，交通服务提供航行相关信息，码头计划维护泊位安排，生产系统接收靠泊实绩和开工条件。消息送达、计划更新、责任方确认分别留痕；AIS上的船位也不能替代这些业务记录。</p><a href={base+'systems/'}>继续看港口系统与接口 →</a></div></section>
<section class="berth-section berth-lab" id="readiness-lab"><div class="berth-section-head"><div><span class="eyebrow">03 / WHAT IS THE SHIP WAITING FOR?</span><h2>换一个条件，看看交接卡在哪里。</h2></div><p>仅模拟资料核对。勾选不代表真实许可，也不产生通航或作业指令。</p></div><div data-readiness-ui hidden><label class="berth-case-label">选择一个教学情景<select data-readiness-case>{readinessCases.map(c=><option value={c.id}>{c.title}</option>)}</select></label><p class="berth-case-story" data-readiness-story></p><div class="berth-lab-layout"><div class="berth-check-groups">{[['arrival','A / 进港靠泊相关条件'],['work','B / 靠妥后的装卸条件']].map(([phase,title])=><fieldset><legend>{title}</legend>{readinessChecks.filter(c=>c.phase===phase).map(c=><label class="berth-condition"><input type="checkbox" value={c.id} data-readiness-check/><span><strong>{c.label}</strong><small>{c.detail}</small></span></label>)}</fieldset>)}</div><aside class="berth-result"><span class="eyebrow">教学观察 / 尚需核对</span><div role="status" aria-live="polite" aria-atomic="true" data-readiness-result></div><p data-readiness-lesson></p><button class="button outline" type="button" data-readiness-reset>恢复当前情景</button><small>真实是否继续，由有职责的主体根据实时条件确认。</small></aside></div></div><noscript><div class="berth-static-cases">{readinessCases.map(c=><article><h3>{c.title}</h3><p>{c.story}</p><p>{c.lesson}</p></article>)}</div></noscript></section>
<section class="berth-section" id="berth-glossary"><div class="berth-section-head"><div><span class="eyebrow">04 / WORDS THAT MATTER</span><h2>把容易混淆的词，放在一起看。</h2></div><p>水深与吃水、锚地与登轮区、预计时间与实际时间，各自回答不同问题。</p></div><div class="berth-glossary">{berthingGlossary.map(t=><details><summary>{t.term}<span aria-hidden="true">＋</span></summary><p>{t.meaning}</p><small>{t.distinction}</small></details>)}</div></section>
<section class="berth-section" id="after-berthing"><div class="berth-section-head"><div><span class="eyebrow">05 / THE NEXT MOVEMENT</span><h2>靠泊以后，还有移泊和离港。</h2></div><p>每次移动，都需要重新衔接实际条件与相关服务。</p></div><div class="berth-after-grid">{berthingAftercare.map(c=><article id={'after-'+c.id}><h3>{c.title}</h3><p>{c.text}</p><ul>{c.checks.map(t=><li>{t}</li>)}</ul></article>)}</div></section>
<section class="berth-section"><span class="eyebrow">CHECK YOUR UNDERSTANDING / 常见误解</span><h2>这些“看起来可以”，还需要再分清。</h2><div class="berth-myths">{berthingMisconceptions.map(m=><article><h3>{m.claim}</h3><p>{m.correction}</p></article>)}</div></section>
<div class="berth-continue"><div><span class="eyebrow">NEXT / 船靠好之后</span><h2>再跟着货物，走进装卸和交付。</h2></div><a class="button primary" href={base+'shipment/'}>进入一票货全程 <Icon name="arrow" size={17}/></a><a class="text-link" href={base+'vessels/'}>对照不同船型 →</a></div>
<section class="berth-section berth-sources" id="berth-sources"><h2>资料与适用范围</h2><p>面向初学者的业务与空间示意，不按真实比例，不提供操船、拖带或系缆操作参数。九站是教学归纳，具体航路、引航、报告、服务与船岸条件以本船、本港和适用要求为准。海关货物监管与船舶通航、码头作业分开理解。</p><ol>{berthingSources.map(s=><li id={'berth-source-'+s.id}><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>{s.org} · 核查 {s.checked}</small><p>{s.scope}</p></li>)}</ol></section>
</div><script>import '../scripts/berthing';</script></Layout>
