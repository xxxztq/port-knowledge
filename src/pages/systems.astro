---
import InfrastructureEntry from '../components/InfrastructureEntry.astro';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import SystemNetwork from '../components/SystemNetwork.astro';
import { systemSources } from '../data/port-systems.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const systemHref = (id: string) => `${base}systems/#system-${id}`;
const sourceNumber = (id: string) => systemSources.findIndex(s => s.id === id) + 1;
const evidence = (id: string) => `#system-source-${id}`;
const checks = [
  { id: 'customs', index: '01', title: '监管放行', owner: '海关按职责处理', detail: '对应货物的监管状态是否满足当前业务要求？收到申报或运抵数据，不代表已经作出放行决定。', result: '监管结果／相关要求' },
  { id: 'carrier', index: '02', title: '商业放箱', owner: '船公司或其授权代理', detail: '运输单证、商业交付授权及相关手续是否齐备？船公司侧可以提货，不等于海关和码头条件都满足。', result: '有效的提货／放箱指令' },
  { id: 'gate', index: '03', title: '码头执行', owner: '码头按现场规则核验', detail: '任务、箱货身份、有效状态及现场条件是否一致？生产系统形成任务后，还需要完成作业与交接。', result: '作业与交接实绩' },
];
const compare = [
  ['识别对象', '箱号与箱属性，并关联提单、航次等业务对象', '货票、批次及包装／件标，并关联船次和委托'],
  ['库存单位', '箱数、箱型、空重状态；箱内货物另有单证信息', '件数、重量，以及业务所需的体积、规格等'],
  ['位置表达', '箱区、贝位、排、层等箱位表达，依码头规则', '库区、库位、垛位或作业区域，依货类和库场规则'],
  ['作业记录', '装卸一箱、移箱、进出场与交接实绩', '分批收货、理货、称重、拆分或合并作业、部分交付'],
  ['常见差异', '箱号不符、箱位不符、计划与实绩不同步', '短溢、混批、件重不符、货损或交付数量差异'],
];
const messageSteps = [
  { number: '01', title: '准备业务对象', route: '货主／货代 ↔ 船公司、申报代理', body: '把运输单证、箱号或货票、委托及所办业务关联起来。不同业务使用的标识不完全相同，不能只凭一个箱号套用所有结果。', state: '资料齐备 ≠ 已获许可', system: 'forwarder' },
  { number: '02', title: '分别提交与接收', route: '有资格的主体 → 对应服务入口／业务系统', body: '监管申报与商业提货申请分属不同流程。入口可以是单一窗口、企业服务或当地指定方式；技术回执先说明消息是否接收。', state: '已接收 ≠ 已放行', system: 'single-window' },
  { number: '03', title: '各自处理并反馈', route: '海关／船公司 → 对应业务办理方', body: '监管部门按职责处理监管事项，船公司按其交付手续处理商业放箱。两个结果可先后或并行到达，没有全国统一的固定顺序。', state: '监管结果与商业结果分别记录', system: 'customs' },
  { number: '04', title: '核对有效状态', route: '获授权的信息 → 码头业务与生产系统', body: '通过适用渠道核对业务对象、结果来源、版本和有效状态。缺消息、对象不符或收到更正时先核实，不沿用过期的“可提”状态。', state: '状态可见 ≠ 条件全部满足', system: 'data-exchange' },
  { number: '05', title: '组织作业与交接', route: '车队 ↔ 闸口、TOS、现场岗位', body: '依本场站规则办理预约、身份核验、提箱任务与过闸交接；这里只归纳职责，实际先后和办理入口以当地业务为准。', state: '已下发任务 ≠ 已完成提箱', system: 'gate' },
  { number: '06', title: '返回实绩并对账', route: '现场 → 生产记录、客户服务、计费', body: '用真实交接和作业记录更新库存、进度与费用依据。发现差异时保留原记录、责任主体和更正结果，避免用计划覆盖实绩。', state: '以实际完成记录闭合业务', system: 'finance' },
];
---
<Layout title="港口系统" active="systems" description="从集装箱 TOS、件杂货生产到海关与单一窗口，分清货物流、信息流和权限，读懂系统协作与异常处理。">
  <div class="container systems-page">
    <PageIntro eyebrow="PORT SYSTEMS / 看懂系统与协作" title="货物在移动，信息也在交接。" description="一个港口没有包办一切的系统。先看谁掌握什么信息、谁有权作出什么决定，再理解一只箱或一票货为什么能继续向前。" />
    <div class="page-content">
      <InfrastructureEntry/>
      <nav class="systems-index" aria-label="本页目录"><a href="#system-network">系统关系图</a><a href="#system-authority">三种独立判断</a><a href="#system-cargo-compare">两类生产管理</a><a href="#system-window-guide">分清三个窗口概念</a><a href="#system-message-chain">消息如何交接</a><a href="#system-sources">官方来源</a></nav>

      <section class="flow-lens" aria-label="货物流、信息流与权限的区别">
        <div><span class="lens-label">01 / 货物流</span><h2>货物实际在哪里？</h2><p>船边 → 堆场或仓库 → 交接点。位置变化要有现场作业与实绩支持。</p><div class="lens-line physical" aria-hidden="true"><i></i><span></span><i></i><span></span><i></i></div></div>
        <div><span class="lens-label">02 / 信息流</span><h2>谁收到什么消息？</h2><p>委托、计划、申报、回执与实绩在不同主体之间交换，可能先于或晚于实物。</p><div class="lens-line information" aria-hidden="true"><i></i><span></span><i></i><span></span><i></i></div></div>
        <div><span class="lens-label">03 / 权限</span><h2>谁能作出这个决定？</h2><p>看得到状态，不等于可以修改状态；收到消息，不等于拥有放行或交付权限。</p><div class="authority-stamps" aria-hidden="true"><span>监管</span><span>商业</span><span>执行</span></div></div>
      </section>
      <p class="reading-note">本页是基于官方资料整理的教学职责模型，不是某个港口的系统架构图。产品名称、模块划分、对接渠道与岗位权限会因港口、货类和业务而异。</p>

      <SystemNetwork />

      <section class="systems-section" id="system-authority" aria-labelledby="authority-title">
        <div class="section-heading-local"><span class="section-kicker">02 / INDEPENDENT DECISIONS</span><h2 id="authority-title">三种判断，各自成立。</h2><p>以进口提箱为教学场景。三类条件需要分别确认，下面的编号不表示办理顺序。</p></div>
        <div class="authority-grid">{checks.map(check => <article class="authority-card"><span class="card-number">{check.index}</span><h3>{check.title}</h3><small>{check.owner}</small><p>{check.detail}</p><div class="decision-output">{check.result}</div><a href={systemHref(check.id)}>查看职责与边界 ↗</a></article>)}</div>
        <div class="key-message"><strong>已接收，不等于已放行。</strong><p>消息接收、业务处理、作业执行是不同层次；“待处理”“无回执”“已撤销”都不能当作有效通过。海关放行、商业放箱、码头执行条件应分别核实，任一结果都不替其他主体作决定。</p></div>
        <p class="evidence-line">依据：海关舱单办事指南 <a href={evidence('customs-manifest')}>[{sourceNumber('customs-manifest')}]</a>、状态订阅通知 <a href={evidence('window-status')}>[{sourceNumber('window-status')}]</a>、Maersk 进口放箱案例 <a href={evidence('maersk-release')}>[{sourceNumber('maersk-release')}]</a>。具体提箱条件依当地业务。</p>
      </section>

      <section class="systems-section" id="system-cargo-compare" aria-labelledby="cargo-compare-title">
        <div class="section-heading-local"><span class="section-kicker">03 / DIFFERENT CARGO, DIFFERENT RECORDS</span><h2 id="cargo-compare-title">箱号箱位，与货票批次。</h2><p>两类生产系统都组织作业，但库存对象与记录方式不同。以下字段是教学归纳，不是数据库规范。</p></div>
        <div class="comparison-wrap" role="region" aria-label="集装箱与件杂货生产对比，可横向滚动" tabindex="0"><table><caption>集装箱 TOS 与件杂货生产系统的管理侧重点</caption><thead><tr><th scope="col">观察点</th><th scope="col"><a href={systemHref('container-tos')}>集装箱 TOS ↗</a></th><th scope="col"><a href={systemHref('general-cargo')}>件杂货生产系统 ↗</a></th></tr></thead><tbody>{compare.map(row => <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div>
        <div class="example-pair"><article><span>虚构示例 / 集装箱</span><h3>教学箱 A → 箱区 02 · 贝 06 · 排 03 · 层 02</h3><p>一次移箱改变箱位，作业回报更新实绩。计划移到新位置，不等于现场已完成移箱。</p></article><article><span>虚构示例 / 件杂货</span><h3>教学货票 B → 批次 01 · 120 件 · 24 吨</h3><p>先交付 40 件、实测 8 吨，剩余 80 件、16 吨留在对应库位。真实业务中件数与重量需分别核实，不能总按比例推算。</p></article></div>
        <p class="evidence-line">功能例子来自 Kaleris 的 TOS 与多货类产品 <a href={evidence('kaleris-tos')}>[{sourceNumber('kaleris-tos')}]</a> <a href={evidence('kaleris-cargo')}>[{sourceNumber('kaleris-cargo')}]</a>；这些功能不代表所有港口部署一致。</p>
      </section>

      <section class="systems-section" id="system-window-guide" aria-labelledby="window-title">
        <div class="section-heading-local"><span class="section-kicker">04 / THREE CONCEPTS TO KEEP APART</span><h2 id="window-title">都连接多方，但不是同一个“窗口”。</h2><p>比较服务对象与用途，不能仅凭“单一入口”或“信息共享”就把三者混称。</p></div>
        <div class="window-grid">
          <article><span class="window-code">CHINA INTERNATIONAL TRADE</span><h3>中国国际贸易单一窗口</h3><p>面向国际贸易相关业务，提供申报、反馈及相关服务。监管部门依法处理各自事项，服务入口不取得这些部门的全部权限。</p><a href={systemHref('single-window')}>电子口岸与单一窗口的关系 ↗</a><p class="window-citation">官方制度与业务说明 <a href={evidence('window-framework')}>[{sourceNumber('window-framework')}]</a> <a href={evidence('window-status')}>[{sourceNumber('window-status')}]</a> <a href={evidence('eport-access')}>[{sourceNumber('eport-access')}]</a></p></article>
          <article><span class="window-code">PORT COMMUNITY SYSTEM / PCS</span><h3>港口社区系统</h3><p>连接港口社区中的公私主体，支持物流业务与信息协作。可以与单一窗口衔接，但不是中国国际贸易单一窗口的另一种名称，也不能假设每港都有独立 PCS。</p><p class="window-citation">协会原始指南 <a href={evidence('ipcsa-pcs')}>[{sourceNumber('ipcsa-pcs')}]</a>；与其他机制协同参见 IMO <a href={evidence('imo-msw')}>[{sourceNumber('imo-msw')}]</a></p></article>
          <article><span class="window-code">MARITIME SINGLE WINDOW / MSW</span><h3>海事单一窗口</h3><p>IMO 语境下，重点是船舶抵港、在港及离港时向公共主管部门提交所需信息。它不是码头箱位管理系统，也不能据此断言货物的商业提箱已获批准。</p><p class="window-citation">IMO 官方说明 <a href={evidence('imo-msw')}>[{sourceNumber('imo-msw')}]</a></p></article>
        </div>
        <p class="reading-note"><strong>电子口岸与单一窗口：</strong>相关制度中，电子口岸为跨部门共享等提供支撑，单一窗口承载相关业务入口与服务；企业入网可从官方指定入口办理。不要据此把所有地方平台、数据交换服务和海关业务系统画成一条固定链路。<a href={evidence('smart-port')}>[{sourceNumber('smart-port')}]</a></p>
      </section>

      <section class="systems-section" id="system-message-chain" aria-labelledby="message-title">
        <div class="section-heading-local"><span class="section-kicker">05 / A TEACHING MESSAGE CHAIN</span><h2 id="message-title">一条消息，到哪里才算完成？</h2><p>以下是进口提箱的信息交接教学示意。用自然语言描述业务，不提供真实 API、报文字段或接口协议；编号表示理解顺序，不规定各港口办理先后。</p></div>
        <ol class="message-chain">{messageSteps.map(step => <li><span class="step-number">{step.number}</span><article><span class="message-route">{step.route}</span><h3>{step.title}</h3><p>{step.body}</p><div class="message-bottom"><strong>{step.state}</strong><a href={systemHref(step.system)}>对应系统 ↗</a></div></article></li>)}</ol>
        <div class="message-exceptions" id="system-message-exceptions"><h3>消息出了问题，先判断是哪一种。</h3><p>展开查看处置思路。下述是教学原则；超时阈值、重试方式和更正权限按真实业务约定执行。</p>
          <details data-message-case="timeout"><summary><span>01</span> 超时／无回执 <small>结果未知，不自动通过</small></summary><div><p><strong>发生了什么：</strong>发送方等不到结果，可能是传输失败、接收方处理延迟，也可能是回执没有关联回来。</p><p><strong>先做什么：</strong>保留原业务标识和发送记录，查询接收方是否收到、是否处理，再按约定补发或重试；避免重复创建业务或重复下发设备任务。</p><p><strong>找谁：</strong>信息运维查传输，业务经办人查处理状态。超时不能自动视为放行，也不能直接判定业务失败。</p></div></details>
          <details data-message-case="cancel"><summary><span>02</span> 撤销／失效 <small>旧结果不能继续当依据</small></summary><div><p><strong>发生了什么：</strong>有权主体撤销相关指令或状态失效。不是任意参与方都能撤销，也不是所有业务都允许任意阶段撤销。</p><p><strong>先做什么：</strong>核实来源、对象及撤销是否生效，停止基于失效状态的新执行，通知受影响岗位重新核验；实物已移动时，要由有权岗位处置，系统消息不能倒转现场事实。</p><p><strong>找谁：</strong>原签发／办理主体确认业务效力，码头生产与闸口确认现场进度，信息人员核对状态传播。</p></div></details>
          <details data-message-case="correct"><summary><span>03</span> 更正／版本变化 <small>留痕并重新核验关联任务</small></summary><div><p><strong>发生了什么：</strong>箱号、货票、数量或其他业务资料需要更正；有些事项须先取得相应主管部门或业务主体确认。</p><p><strong>先做什么：</strong>关联原记录、说明更正内容并保留版本，按有权主体确认的结果重算关联状态；旧回执晚到不能覆盖已确认的新版本，重复消息不应重复形成作业或费用。</p><p><strong>找谁：</strong>资料提供方与申报／业务经办人先核对，必要时向主管海关、承运人等办理，再与码头对账。</p></div></details>
        </div>
        <p class="evidence-line">状态与变更概念依据 <a href={evidence('customs-manifest')}>[{sourceNumber('customs-manifest')}]</a> <a href={evidence('window-status')}>[{sourceNumber('window-status')}]</a>；超时、撤销、更正的演示为本站教学归纳，不是监管办理指令。</p>
      </section>

      <section class="systems-section sources-section" id="system-sources" aria-labelledby="sources-title">
        <div class="section-heading-local"><span class="section-kicker">06 / PRIMARY SOURCES</span><h2 id="sources-title">来源、核查日期与适用边界</h2><p>核查日期：2026 年 11 月 21 日。制度文件用于解释职责，企业材料用于说明明确列出的功能；教学归纳不作为统一行业标准、真实接口文档或现场操作规程。</p></div>
        <ol class="systems-sources">{systemSources.map((source, index) => <li id={`system-source-${source.id}`}><span class="source-number">{String(index + 1).padStart(2, '0')}</span><div><h3><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span><span class="external-accessible">（在新标签页打开）</span></a></h3><span class="source-meta">{source.org} · 核查 {source.checked}</span><p>{source.scope}</p></div></li>)}</ol>
        <div class="next-reading"><span>继续沿着业务理解系统</span><a href={`${base}flows/`}>业务流程 ↗</a><a href={`${base}gate/`}>闸口与监管 ↗</a><a href={`${base}documents/`}>单证图解 ↗</a></div>
      </section>
    </div>
  </div>
</Layout>

<style>
