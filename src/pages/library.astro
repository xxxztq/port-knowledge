---
import EquipmentCard from '../components/EquipmentCard.astro';import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import ArticleCard from '../components/ArticleCard.astro';import {articles,domains} from '../data/knowledge.js';import {cargoSearchEntries} from '../data/cargo-search.js';import {riskSearchEntries} from '../data/risk-learning.js';import {infrastructureSearchEntries} from '../data/infrastructure.js';
import {vesselSearchEntries} from '../data/vessel-learning.js';
import {learningSearchEntries} from '../data/learning-search.js';
const extraEntries=[...learningSearchEntries,...vesselSearchEntries,...cargoSearchEntries,...infrastructureSearchEntries,...riskSearchEntries];
// Build the text-only index here so the browser does not download the source profiles.
const searchIndex=[
  ...articles.map(a=>[a.id,[a.title,a.subtitle,a.summary,...a.tags,...a.sections.map(s=>s.title+' '+s.body)].join(' ').toLowerCase()]),
  ...extraEntries.map(e=>[e.id,e.searchText])
];
const searchIndexJson=JSON.stringify(searchIndex).replace(/</g,'\\u003c');
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="知识百科" active="library"><PageIntro eyebrow="KNOWLEDGE ATLAS / 知识地图" title="从一个词，读懂一整条业务。" description="按问题搜索，按主题探索。24 个知识域连接岗位、设备、流程与经营逻辑。"><label class="search-box"><Icon name="search"/><input id="knowledge-search" type="search" placeholder="搜索：大豆、LNG、滚装船、铁矿石、风险……" aria-label="搜索知识百科" autocomplete="off"/></label></PageIntro><div class="container page-content"><div class="cargo-search-shortcuts"><a href={base+'knowledge-map/'}>知识地图与学习路线 →</a><a href={base+'shipment/'}>一票货全程交互 →</a><a href={base+'cargo/grains/'}>粮食业务 →</a><a href={base+'cargo/liquids/'}>液体货类 →</a><a href={base+'vessels/'}>14 种船型图鉴 →</a><a href={base+'cargo/minerals/'}>矿产与干散货 →</a><a href={base+'containers/'}>12 种箱型图鉴 →</a><a href={base+'cargo/'}>货类业务与覆盖地图 →</a><a href={base+'infrastructure/'}>贝位、堆场与 IT 机房 →</a><a href={base+'risks/'}>港口风险与预防 →</a></div><div class="filter-bar" aria-label="知识类型">{['全部','基础','设备','岗位','业务','监管','经营','箱型','货类','船型','专题','风险','我的收藏'].map((kind,i)=><button class="filter-chip" data-kind-filter={kind} aria-pressed={i===0?'true':'false'}>{kind}</button>)}</div><p class="search-count" id="search-count" aria-live="polite">共 {articles.length+extraEntries.length} 个知识卡与专题入口</p><div class="library-layout"><aside class="domain-list" aria-label="知识领域"><h2>按知识领域浏览</h2><button class="domain-button" data-domain-filter="all" aria-pressed="true">全部领域</button>{domains.map((d,i)=><button class="domain-button" data-domain-filter={d.id} aria-pressed="false"><span>{String(i+1).padStart(2,'0')}</span>{d.title}</button>)}</aside><div><div class="article-grid library-grid" id="knowledge-results">{articles.map(a=>a.kind==='设备'?<EquipmentCard article={a} compact/>:<ArticleCard article={a}/>)}{extraEntries.map(e=><a class="article-card" href={base+e.path} data-search-card data-id={e.id} data-kind={e.kind} data-domain={e.domain}><div class="card-top"><span class="tag">{e.kind}</span></div><h3>{e.title}</h3><p>{e.summary}</p><div class="card-bottom"><span>图解 · 业务说明</span><Icon name="arrow" size={18}/></div></a>)}</div><div class="empty-state" id="empty-results" hidden><Icon name="search" size={32}/><h3>暂时没有匹配的知识卡</h3><p>试试缩短关键词，或切换到“全部”与“全部领域”。收藏只保存在当前浏览器。</p><button class="button outline" id="reset-search">清除筛选</button></div></div></div><div class="notice">这里是可追溯的入门知识库。行业概念、企业案例与教学假设分别标注；专业规范和具体操作细节仍需以适用来源为准。</div></div><script type="application/json" id="knowledge-search-index" set:html={searchIndexJson}/><script>
const input = document.querySelector<HTMLInputElement>('#knowledge-search')!;
const cards = [...document.querySelectorAll<HTMLElement>('[data-search-card]')];
const fullText = new Map<string,string>(JSON.parse(document.querySelector('#knowledge-search-index')!.textContent||'[]'));
let kind='全部',domain='all';
const bookmarks=()=>{try{const value=JSON.parse(localStorage.getItem('port-bookmarks')||'[]');return Array.isArray(value)?value:[]}catch{return []}};
function refresh(){let count=0;const words=input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);const saved=bookmarks();cards.forEach(card=>{const text=fullText.get(card.dataset.id!)||'';const show=words.every(w=>text.includes(w))&&(kind==='全部'||(kind==='我的收藏'?saved.includes(card.dataset.id):card.dataset.kind===kind))&&(domain==='all'||card.dataset.domain===domain);card.hidden=!show;if(show)count++});document.querySelector('#search-count')!.textContent='找到 '+count+' 个知识卡与专题入口';(document.querySelector('#empty-results') as HTMLElement).hidden=count!==0;document.querySelectorAll('[data-kind-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b.getAttribute('data-kind-filter')===kind)));document.querySelectorAll('[data-domain-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b.getAttribute('data-domain-filter')===domain)));}
input.addEventListener('input',refresh);document.querySelectorAll<HTMLButtonElement>('[data-kind-filter]').forEach(b=>b.addEventListener('click',()=>{kind=b.dataset.kindFilter!;refresh()}));document.querySelectorAll<HTMLButtonElement>('[data-domain-filter]').forEach(b=>b.addEventListener('click',()=>{domain=b.dataset.domainFilter!;refresh()}));document.querySelector('#reset-search')?.addEventListener('click',()=>{input.value='';kind='全部';domain='all';refresh();input.focus()});const params=new URLSearchParams(location.search);input.value=params.get('q')||'';if([...document.querySelectorAll<HTMLElement>('[data-domain-filter]')].some(b=>b.dataset.domainFilter===params.get('domain')))domain=params.get('domain')!;if([...document.querySelectorAll<HTMLElement>('[data-kind-filter]')].some(b=>b.dataset.kindFilter===params.get('kind')))kind=params.get('kind')!;refresh();
</script></Layout>