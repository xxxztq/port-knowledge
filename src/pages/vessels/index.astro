---
import BerthingEntry from '../../components/BerthingEntry.astro';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import KnowledgeCheck from '../../components/KnowledgeCheck.astro';
import VesselEntry from '../../components/VesselEntry.astro';
import {vesselProfiles,vesselGroups,vesselSources,supportVessels} from '../../data/vessel-types.js';
import {vesselQuiz} from '../../data/vessel-learning.js';
import '../../styles/vessels.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href=(p:string)=>base+p.replace(/^\//,'');
const groups=new Map(vesselGroups.map(g=>[g.id,g.name]));
---
<Layout title="船型图鉴" active="cargo" description="认识14种货运船型与港作船舶，从滚装、散货到重吊和半潜，理解船舶、货物与码头的配合。"><div class="container vessel-page">
<div class="breadcrumbs"><a href={base}>首页</a><Icon name="chevron" size={12}/><a href={base+'cargo/'}>箱型与货类</a><Icon name="chevron" size={12}/><span>船型图鉴</span></div>
<header class="vessel-hero"><div><span class="eyebrow">VESSEL ATLAS / 从船的轮廓，读懂岸的分工</span><h1>船不一样，<br/><span>装卸的方式也不同。</span></h1><p>箱子吊上去，车辆滚进去，大件可能浮上去。先认识船型，再看码头需要怎样的设备、场地、计划和交接。</p><div class="vessel-hero-actions"><a class="button primary" href="#vessel-atlas">认识 {vesselProfiles.length} 种船型 <Icon name="arrow" size={17}/></a><a class="text-link" href="#compare">并排比较两种船 →</a></div></div><div class="vessel-hero-board"><span>THREE DIFFERENT INTERFACES / 三种交接界面</span>{[['bulk-carrier','散货船','舱口 → 卸船设备 → 料流'],['pctc','汽车运输船','跳板 → 车道 → 车辆交接'],['semi-submersible','半潜运输船','浮装条件 → 运输甲板']].map(([id,name,text])=><a href={base+'vessels/'+id+'/'}><img src={base+'illustrations/vessels/'+id+'.svg'} alt={name+'结构教学线稿'} width="720" height="360"/><div><strong>{name} ↗</strong><small>{text}</small></div></a>)}</div></header>
<nav class="cargo-local-nav" aria-label="船型专题目录"><a href="#dimensions">先分清</a><a href="#vessel-atlas">船型图鉴</a><a href="#compare">船型对照</a><a href="#support">港作与辅助船</a><a href="#vessel-sources">资料与范围</a></nav>
<section class="vessel-section" id="dimensions"><span class="eyebrow">01 / THREE QUESTIONS</span><h2>船型名称，可能在回答不同的问题。</h2><div class="vessel-lenses"><article><span class="eyebrow">货物用途</span><h3>主要运什么？</h3><p>集装箱、干散货、汽车、液货或冷藏货。货物形态改变了舱室、保管和交接要求。</p></article><article><span class="eyebrow">装卸方式</span><h3>怎样上下船？</h3><p>吊装、滚装、泵送或浮装是不同的接口。滚装不只运能自己开动的汽车，也可能用专用载具运输设备。</p></article><article><span class="eyebrow">专门能力</span><h3>为哪种任务设计？</h3><p>多用途、重吊、半潜、甲板运输强调不同能力；这些分类可以重叠，不是彼此排斥的船舶目录。</p></article></div><p class="vessel-type-note">图鉴是认识业务的入口。载重吨、总吨、箱位数、车位数或液货容积描述不同维度；单个数值和船型名称都不能直接证明某票货适装。</p></section>
<section class="vessel-section" id="vessel-atlas"><span class="eyebrow">02 / IDENTIFY THE VESSEL</span><h2>认出一艘船，接着看它需要怎样的码头。</h2><div class="vessel-tools"><div class="filter-bar" aria-label="按船型分组筛选"><button class="filter-chip" data-vessel-filter="all" aria-pressed="true">全部船型</button>{vesselGroups.map(g=><button class="filter-chip" data-vessel-filter={g.id} aria-pressed="false">{g.name}</button>)}</div><p data-vessel-count role="status" aria-live="polite">显示 {vesselProfiles.length} 种船型</p></div><div class="vessel-grid">{vesselProfiles.map(p=><a class="vessel-card" data-vessel-group={p.group} href={base+'vessels/'+p.id+'/'}><img src={href(p.visual)} alt={p.name+'结构教学线稿'} width="720" height="360" loading="lazy"/><div class="vessel-card-body"><span>{groups.get(p.group)} / {p.english}</span><h3>{p.name} ↗</h3><p>{p.summary}</p><small>典型货物：{p.cargo.join(' · ')}</small></div></a>)}</div></section>
<section class="vessel-section vessel-compare" id="compare"><span class="eyebrow">03 / SIDE BY SIDE</span><h2>名字相近，业务差在哪里？</h2><p>选两种船，对照货物、装卸方式与岸侧条件。相同船型也可有不同设计，具体能力仍看本船资料。</p><div class="vessel-compare-controls">{['left','right'].map((side,i)=><label>对照{ i===0?'左侧':'右侧'}船型<select data-vessel-select={side} aria-label={i===0?'左侧船型':'右侧船型'}>{vesselProfiles.map(p=><option value={p.id} selected={p.id===(i===0?'roro':'pctc')}>{p.name}</option>)}</select></label>)}</div><div class="vessel-compare-grid">{['left','right'].map(side=><div class="vessel-compare-slot" data-compare-side={side}>{vesselProfiles.map(p=><article data-compare-profile={p.id}><img src={href(p.visual)} alt={p.name+'对照示意'} width="720" height="360" loading="lazy"/><h3>{p.name}</h3><dl><dt>主要运什么</dt><dd>{p.cargo.join('、')}</dd><dt>怎样装卸</dt><dd>{p.method}</dd><dt>岸上怎样配合</dt><dd>{p.portFit}</dd></dl><a href={base+'vessels/'+p.id+'/'}>打开船型业务档案 →</a></article>)}</div>)}</div><p data-compare-status class="vessel-reference-note" role="status" aria-live="polite">可对照滚装船与汽车运输船，也可以换成重吊船与半潜运输船。</p><noscript><p>浏览器未启用脚本，保留全部对照内容，也可通过图鉴逐一打开。</p></noscript></section>
<KnowledgeCheck quiz={vesselQuiz}/>
<section class="vessel-section" id="support"><span class="eyebrow">04 / THE SHIPS AROUND THE SHIP</span><h2>港口里出现的船，不全是主运输船。</h2><p>这些船可能承担协助、转运、建设或海工作业。用途和承担的服务须分别理解。</p><div class="vessel-support-grid">{supportVessels.map(p=><article><h3>{p.name}</h3><p>{p.text}</p><small>{p.distinction}</small></article>)}</div></section>
<BerthingEntry compact/><VesselEntry compact/>
<section class="vessel-section" id="vessel-sources"><h2>资料与适用范围</h2><p>船型图示为原创教学示意，不按实际比例；图中的舱形、罐形和设备是代表性设计，不能单凭外观判定船舶证书、能力或适装性。业务链为教学归纳，具体港口、船舶和货物另行确认。</p><ol class="vessel-source-list">{vesselSources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>{s.org} · 核查 {s.checked} · {s.scope}</small></li>)}</ol></section>
</div></Layout>
<script>
const filterButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-vessel-filter]')];const cards=[...document.querySelectorAll<HTMLElement>('[data-vessel-group]')];filterButtons.forEach(button=>button.addEventListener('click',()=>{const group=button.dataset.vesselFilter;let count=0;cards.forEach(card=>{card.hidden=group!=='all'&&card.dataset.vesselGroup!==group;if(!card.hidden)count++});filterButtons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelector('[data-vessel-count]')!.textContent='显示 '+count+' 种船型'}));
const selects=[...document.querySelectorAll<HTMLSelectElement>('[data-vessel-select]')];function compare(){selects.forEach(select=>{document.querySelectorAll<HTMLElement>('[data-compare-side="'+select.dataset.vesselSelect+'"] [data-compare-profile]').forEach(panel=>panel.hidden=panel.dataset.compareProfile!==select.value)});const names=selects.map(s=>s.options[s.selectedIndex].textContent);document.querySelector('[data-compare-status]')!.textContent=selects[0].value===selects[1].value?'两侧是同一种船型；可选择另一种查看差别。':'正在对照：'+names.join(' 与 ')}selects.forEach(s=>s.addEventListener('change',compare));compare();
</script>
