---
import Layout from '../layouts/Layout.astro';
import { shipmentCases, shipmentLanes, shipmentExceptions, shipmentSources } from '../data/shipment-learning.js';
import '../styles/shipment.css';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const number = (i: number) => String(i + 1).padStart(2, '0');
---
<Layout title="一票货全程" active="journey" description="跟随进口大豆与 LNG 的七站教学案例，同步观察实物、岗位协作、单证系统、监管与交付条件、服务与费用。">
  <div class="container shipment-page" data-shipment-app>
    <header class="shipment-intro">
      <div><span class="eyebrow">ONE SHIPMENT / 五条线，看懂一次交接</span><h1>一票货，怎样走完全程？</h1><p>沿着货物走，也沿着证据走。<br/>从船边到交付点，看看每一站谁接手、凭什么继续、服务如何发生。</p></div>
      <a class="shipment-legacy" href={base + 'journey/'}><span>还想看集装箱？</span><strong>进口集装箱七站旅程 ↗</strong><small>机床进口 · 提箱 · 还空箱</small></a>
    </header>
    <div class="shipment-scope"><span class="shipment-demo">虚构教学案例</span><p>不连接真实海关或生产系统，不生成作业指令、审核结果或放行状态。图中顺序是教学归纳。</p><a href="#shipment-sources">范围与来源 ↓</a></div>
    <nav class="shipment-cases" aria-label="选择一票货教学案例">
      {shipmentCases.map((lesson, i) => <a href={'#case-' + lesson.id} data-case-select={lesson.id}><span>{number(i)} / {lesson.id === 'soybeans' ? 'DRY BULK' : 'LIQUEFIED GAS'}</span><strong>{lesson.title}</strong><small>{lesson.subtitle}</small></a>)}
    </nav>
    <p class="shipment-instructions">选案例，再选编号节点。五条信息线一起更新；异常演练只检验理解，不替代任何业务确认。<span data-shipment-interactive hidden> 节点可用 Tab、Enter 操作，方向键切换，Home / End 跳至首末节点。</span></p>
    <noscript><p class="shipment-noscript">当前未运行脚本：以下保留两个案例的全部节点、五条信息线、异常影响、待办与恢复条件。点击节点编号可跳转正文，交互演练需启用 JavaScript。</p></noscript>
    <p class="shipment-live shipment-sr-only" data-shipment-live role="status" aria-live="polite" aria-atomic="true"></p>
    {shipmentCases.map(lesson => <section class="shipment-case" id={'case-' + lesson.id} data-shipment-case={lesson.id} aria-labelledby={'case-title-' + lesson.id}>
      <header class="shipment-case-heading"><div><span class="eyebrow">{lesson.code} / 7 NODES · 5 THREADS</span><h2 id={'case-title-' + lesson.id}>{lesson.title}</h2><p>{lesson.identity}</p></div><a href={base + 'cargo/' + lesson.profile + '/'}>查看货物档案 ↗</a></header>
      <p class="shipment-premise">{lesson.premise}</p>
      <div class="shipment-map" aria-label={lesson.shortTitle + '原创路线示意'}>
        <div class="shipment-map-top"><span>船边 → 储存 → 交付</span><span>原创结构示意 · 非工程布置图</span></div>
        <svg class="shipment-landscape" viewBox="0 0 960 300" role="img" aria-labelledby={'map-title-' + lesson.id}>
          <title id={'map-title-' + lesson.id}>{lesson.id === 'soybeans' ? '大豆从散粮船，经卸粮与输送系统进入筒仓，再经交付核验、装车与计量交给汽车运输。' : 'LNG 从运输船，经船岸接收确认进入低温储罐，再经气化、计量进入管网。'}</title>
          <defs><pattern id={'water-' + lesson.id} width="44" height="20" patternUnits="userSpaceOnUse"><path d="M3 12 Q11 5 19 12 T35 12" fill="none" stroke="#b5d2d0" stroke-width="1"/></pattern></defs>
          <path d="M0 0H300L252 300H0Z" fill="#deedeb"/><path d="M0 0H300L252 300H0Z" fill={'url(#water-' + lesson.id + ')'}/><path d="M300 0 252 300" stroke="#bac9b8" stroke-width="8"/>
          <g fill="none" stroke="#d7ded0" stroke-width="1"><path d="M330 45H935M320 95H935M312 145H935M302 195H935M294 245H935"/><path d="M360 25V270M440 25V270M520 25V270M600 25V270M680 25V270M760 25V270M840 25V270M920 25V270"/></g>
          <text x="28" y="34" class="shipment-svg-label">海侧 / 船货</text><text x="345" y="34" class="shipment-svg-label">港区 / 业务交接</text>
          <g stroke="#426b67" stroke-width="2.3" stroke-linejoin="round">
            <path d="M44 154H202L183 182H67Z" fill="#345e60"/><path d="M65 123H89V153H65Z" fill="#fafbf1"/><path d="M73 113H84V123H73Z" fill="#e9dcb3"/>
            {lesson.id === 'soybeans' ? <>
              <path d="M100 135H185V154H100Z" fill="#d5bd80"/><path d="M105 129 113 135M126 127 134 135M148 128 156 135M170 128 178 135"/>
              <path d="M248 147V74H197V130M239 74 220 98H197" fill="none" stroke-width="5"/><path d="M228 147H264M234 143V155M259 143V155"/>
              <path d="M255 120 377 88 427 88" fill="none" stroke="#78966f" stroke-width="9"/><path d="M255 120 377 88 427 88" fill="none" stroke="#d7e0c1" stroke-width="4"/>
              {[376, 416, 456].map(x => <g><path d={'M' + x + ' 153V79L' + (x + 16) + ' 66L' + (x + 32) + ' 79V153Z'} fill="#f1ead5"/><path d={'M' + x + ' 79H' + (x + 32) + 'M' + x + ' 144H' + (x + 32)}/></g>)}
              <path d="M527 75H570V135H527Z" fill="#fffdf3"/><path d="M537 88H561M537 99H561M537 110H553" stroke="#b49b61"/>
              <path d="M610 155V100H687V155M600 100H697" fill="none" stroke-width="4"/><path d="M639 100V130H656" fill="none" stroke="#ba9a5c" stroke-width="7"/>
              <path d="M696 221H787V234H696Z" fill="#d3d9c8"/><path d="M720 207H771V221H720Z" fill="#f7f7ec"/><path d="M705 243H783" stroke-dasharray="5 5"/>
              <g transform="translate(801 117)"><path d="M0 0H51V36H0Z" fill="#c9d3a4"/><path d="M51 13H71L82 25V36H51Z" fill="#fffdf3"/><path d="M57 17H69L77 25H57Z" fill="#bad6d4"/><circle cx="15" cy="38" r="8" fill="#345e60"/><circle cx="65" cy="38" r="8" fill="#345e60"/></g>
              <text x="337" y="208" class="shipment-svg-label">输送 / 筒仓</text><text x="597" y="220" class="shipment-svg-label">装车 / 计量</text>
            </> : <>
              {[112, 145, 178].map(x => <path d={'M' + (x - 14) + ' 153V138Q' + x + ' 112 ' + (x + 14) + ' 138V153Z'} fill="#d7e6cd"/>)}
              <path d="M203 141H230V112H265V145" fill="none" stroke="#809a82" stroke-width="7"/><path d="M261 135H367" fill="none" stroke="#9db290" stroke-width="8"/>
              {[370, 443].map(x => <g><path d={'M' + x + ' 151V99Q' + (x + 30) + ' 64 ' + (x + 60) + ' 99V151Z'} fill="#ecedd9"/><ellipse cx={x + 30} cy="151" rx="30" ry="8" fill="#d7dfc6"/><path d={'M' + (x + 7) + ' 106H' + (x + 53)} stroke="#a0b397"/></g>)}
              <path d="M503 135H559M559 135V165H669" fill="none" stroke="#78968a" stroke-width="8"/>
              {[570, 587, 604, 621].map(x => <path d={'M' + x + ' 151V87H' + (x + 8) + 'V151'} fill="none" stroke-width="3"/>)}
              <path d="M562 82H637M562 157H637" stroke-width="4"/>
              <path d="M668 121H784V136H668Z" fill="#c6d9c4"/>
              <circle cx="720" cy="121" r="18" fill="#fffdf1"/><path d="M720 121 727 111M720 103V98"/>
              <path d="M784 128H848V82M848 128H922M848 128V184H922" fill="none" stroke="#819b79" stroke-width="10"/>
              <path d="M784 128H848V82M848 128H922M848 128V184H922" fill="none" stroke="#d7e3cd" stroke-width="4"/>
              <text x="349" y="251" class="shipment-svg-label">低温储存</text><text x="553" y="210" class="shipment-svg-label">液态 → 气态</text><text x="832" y="233" class="shipment-svg-label">管网</text>
            </>}
          </g>
          <polyline points={lesson.stages.map(s => s.point.join(',')).join(' ')} fill="none" stroke="#c68f42" stroke-width="3" stroke-dasharray="5 7"/>
          {lesson.stages.map((s, i) => <g data-map-point={i} transform={'translate(' + s.point.join(' ') + ')'}><circle r="15" fill="#fffdf5" stroke="#286365" stroke-width="2"/><text text-anchor="middle" dy="5" fill="#244c4c" font-size="13" font-weight="700">{i + 1}</text></g>)}
        </svg>
        <nav class="shipment-stations" aria-label={lesson.shortTitle + '七站路线'}>
          {lesson.stages.map((s, i) => <a href={'#' + lesson.id + '-' + s.id} data-step-select={i} aria-controls={lesson.id + '-' + s.id}><span class="shipment-station-number">{number(i)}</span><strong>{s.title}</strong><small data-station-status>查看节点</small></a>)}
        </nav>
      </div>
      <div class="shipment-controls" data-shipment-interactive hidden><button type="button" data-shipment-action="previous">← 上一节点</button><div><strong data-position></strong><span>阅读位置 · 非作业进度</span><progress data-shipment-progress max="7" value="1" aria-label="当前阅读位置">1 / 7</progress></div><button type="button" data-shipment-action="next">下一节点 →</button></div>
      <aside class="shipment-pending" data-pending hidden><strong>本例有异常演练记录</strong><p data-pending-text></p><button type="button" data-return-exception>返回异常节点</button></aside>
      <div class="shipment-detail-stack">
        {lesson.stages.map((s, i) => {
          const exception = shipmentExceptions.find(e => e.caseId === lesson.id && e.stepId === s.id);
          return <article class="shipment-step" id={lesson.id + '-' + s.id} data-shipment-step={i} aria-labelledby={'title-' + lesson.id + '-' + s.id}>
            <header class="shipment-step-header"><div class="shipment-step-no">{number(i)}<small> / 07</small></div><div><p class="shipment-location">{s.location}</p><h3 id={'title-' + lesson.id + '-' + s.id}>{s.title}</h3><p>{s.summary}</p></div><span class="shipment-position-badge" data-shipment-interactive hidden>当前阅读节点</span></header>
            <div class="shipment-thread-heading"><h4>同一节点，五条线同时看</h4><span>左侧交出 → 右侧接手 / 形成依据</span></div>
            <ol class="shipment-threads" aria-label="当前节点的五条同步信息线">
              {shipmentLanes.map((lane, laneIndex) => <li class="shipment-thread" data-lane={lane.id} style={'--lane-color:' + lane.color}><div class="shipment-thread-label"><span>{number(laneIndex)}</span><div><h4>{lane.name}</h4><small>{lane.tag}</small></div><em data-lane-impact hidden>受异常影响</em></div><div class="shipment-thread-content"><div class="shipment-handoff"><strong>{s.lines[laneIndex].from}</strong><span aria-label="交接至">→</span><strong>{s.lines[laneIndex].to}</strong></div><p>{s.lines[laneIndex].note}</p></div></li>)}
            </ol>
            {exception && <section class="shipment-exception" data-exception={exception.id} aria-labelledby={'exception-' + exception.id}>
              <div class="shipment-exception-heading"><div><span class="eyebrow">WHEN THE CHAIN PAUSES / 异常演练</span><h4 id={'exception-' + exception.id}>{exception.title}</h4></div><button type="button" data-start-exception={exception.id} data-shipment-interactive hidden aria-expanded="false" aria-controls={'exercise-' + exception.id}>模拟此异常</button></div>
              <p>{exception.description}</p>
              <div class="shipment-exception-detail" id={'exercise-' + exception.id} data-exception-detail>
                <p class="shipment-operational-status"><strong>业务状态：待责任方确认</strong> · 网页不能解除此状态</p>
                <div class="shipment-exception-columns"><div><h5>会影响什么</h5><p>{exception.impact}</p><h5>由谁接手，待办是什么</h5><ol>{exception.tasks.map(task => <li>{task}</li>)}</ol></div><div class="shipment-recovery"><h5>何时才可恢复业务</h5><p>{exception.recovery}</p><strong>阅读、勾选或答题都不是有效业务凭据。</strong></div></div>
                <div class="shipment-exercise" data-shipment-interactive hidden>
                  <fieldset><legend>01 / 阅读理解清单</legend><p>这里只记录你理解了哪些条件，不是勾选真实条件已满足。</p>{exception.evidence.map(item => <label><input type="checkbox" data-evidence={item.id}/><span>{item.label}</span></label>)}</fieldset>
                  <fieldset><legend>02 / 选择处理方向</legend><label><input type="radio" name={'response-' + exception.id} value="unsafe" data-response="unsafe"/><span>{exception.unsafe}</span></label><label><input type="radio" name={'response-' + exception.id} value="safe" data-response="safe"/><span>{exception.safe}</span></label></fieldset>
                  <div class="shipment-exercise-footer"><button type="button" data-shipment-action="review">核对理解</button><p data-review-status>尚未完成理解核对；后续节点暂锁定。</p></div>
                  <p class="shipment-exercise-feedback" data-exercise-feedback></p>
                </div>
              </div>
            </section>}
            {i === lesson.stages.length - 1 && <p class="shipment-end-note">已读到本例最后一个交接节点。这里只是教学范围的终点，不代表真实货物已交付、异常已解除或费用已结清。</p>}
          </article>;
        })}
      </div>
      <div class="shipment-case-footer"><nav aria-label={lesson.shortTitle + '关联知识'}><a href={base + 'cargo/' + lesson.profile + '/'}>{lesson.shortTitle}档案 ↗</a><a href={base + lesson.topic}>{lesson.topicTitle} ↗</a><a href={base + 'knowledge-map/'}>知识地图 ↗</a></nav><button type="button" data-shipment-action="reset-case" data-shipment-interactive hidden>重开本例教学假设 ↺</button></div>
    </section>)}
    <section class="shipment-sources" id="shipment-sources" aria-labelledby="shipment-source-title"><span class="eyebrow">SCOPE & SOURCES / 阅读边界</span><h2 id="shipment-source-title">把业务关系讲清楚，把边界留在页面上。</h2><div class="shipment-scope-grid"><p><strong>案例是虚构的。</strong>货批代号、节点划分、岗位称谓和协作路径均为教学编排；五条线并不代表五个统一部署的系统，也不表示所有工作严格顺序发生。</p><p><strong>状态来自有效依据。</strong>本页不连接海关或企业生产系统，不生成通用放行码。恢复条件由适用规则、合同和责任方核实决定，答题只改变学习记录。</p><p><strong>费用来自具体约定。</strong>仅解释接卸、保管、装载、气化、运输等服务的归集关系。没有固定费率、通用损耗率或必然产生的等待费用。</p></div><p>以下一手资料支持货物特征、安全背景与业务关系，不逐字定义这两票虚构案例的全部节点，也不构成法律、工程或现场操作指引。来源可用性与支持范围逐项列示。</p><ol class="shipment-source-list">{shipmentSources.map(source => <li id={'shipment-source-' + source.id}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a><small>{source.org} · {source.checked ? '核查 ' + source.checked : '链接待复核'} · {source.scope}</small></li>)}</ol><a class="shipment-about" href={base + 'about/'}>网站来源与范围说明 ↗</a></section>
  </div>
  <script src="../scripts/shipment.ts"></script>
</Layout>
