---
import InfrastructureEntry from '../components/InfrastructureEntry.astro';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import KnowledgeCheck from '../components/KnowledgeCheck.astro';
import {containerTypes,containerConcepts,containerSources} from '../data/container-types.js';
import {containerQuiz} from '../data/cargo-learning.js';
import '../styles/cargo.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const groups=['全部',...new Set(containerTypes.map(t=>t.group))];
---
<Layout title="集装箱箱型图鉴" active="cargo" description="用12种原创线稿认识干货箱、高箱、冷藏箱、开顶箱、框架箱、罐箱等，以及箱号、尺寸类型码、箱重和VGM。">
<PageIntro eyebrow="CONTAINER FIELD GUIDE / 集装箱箱型图鉴" title="看轮廓认箱型，看条件懂业务。" description="20 尺、40 尺、高箱描述尺寸；冷藏、开顶、框架描述结构与功能。选箱既要看货物装不装得下，也要看运输和作业条件能否满足。"><a class="text-link" href={base+'cargo/'}>← 回到箱型与货类全景</a></PageIntro>
<div class="container cargo-page">
<div class="container-field-note"><span>12 / TYPES</span><p>线稿用于辨认结构，不按统一比例绘制。简称会因公司与场景而异；实际箱体规格、铭牌、检验状态及承运要求需要另行核对。</p></div>
<section id="container-explorer" data-choice-scope data-choice-scroll><div class="cargo-heading"><h2>挑一种箱，翻开它的业务说明。</h2><a href="#container-markings">先读懂箱门上的信息 ↓</a></div><div class="filter-bar" aria-label="按箱型用途筛选">{groups.map((g,i)=><button class="filter-chip" data-container-group={g} aria-pressed={i===0?'true':'false'}>{g}</button>)}</div><p id="container-filter-status" class="cargo-small" aria-live="polite">共 {containerTypes.length} 种箱型</p><nav class="container-type-grid" aria-label="选择集装箱类型">{containerTypes.map((t,i)=><a href={'#'+t.id} data-choice={t.id} data-type-group={t.group}><span>{String(i+1).padStart(2,'0')}</span><img src={base+t.visual.replace(/^\//,'')} alt="" width="480" height="280" loading={i<4?'eager':'lazy'}/><strong>{t.name}</strong><small>{t.code.split('（')[0].split('；')[0]}</small></a>)}</nav><p class="cargo-selection-status" data-choice-status role="status" aria-live="polite">正在查看：{containerTypes[0].name}</p>
{containerTypes.map(t=><article class="container-type-detail" id={t.id} data-choice-panel><div class="container-detail-top"><figure><img src={base+t.visual.replace(/^\//,'')} alt={t.name+'结构教学示意图'} width="480" height="280"/><figcaption>原创结构示意 · 不作为装载或吊装设计图</figcaption></figure><div><span class="eyebrow">{t.group}</span><h2>{t.name}</h2><p class="container-common-code">{t.code}</p><p>{t.summary}</p><div class="container-size-note"><strong>尺寸与规格怎么看</strong><p>{t.sizeNote}</p></div><div class="container-use-tags">{t.uses.map(u=><span>{u}</span>)}</div></div></div><div class="container-feature-grid">{t.features.map(f=><div><h3>{f.label}</h3><p>{f.text}</p></div>)}</div><div class="container-business-grid"><div><h3>到港以后，业务有什么不同？</h3>{t.operations.map(o=><div><h4>{o.title}</h4><p>{o.text}</p></div>)}</div><div><h3>交接时核对什么？</h3><ul>{t.checks.map(c=><li>{c}</li>)}</ul><div class="cargo-misconception"><strong>容易弄错</strong><p>{t.misconception}</p></div></div></div><div class="container-related"><a href="#container-explorer">↑ 选择另一种箱型</a>{t.links.map(l=><a href={base+l.path.replace(/^\//,'')}>{l.label} →</a>)}<span>依据：{t.sources.map(id=><a class="container-source-link" href={'#'+id}>{containerSources.find(s=>s.id===id)?.org||id}</a>)}</span></div></article>)}
</section>
<InfrastructureEntry compact/><section class="cargo-section" id="container-markings"><span class="eyebrow">READ THE BOX / 同一扇箱门，不同的信息</span><h2>箱号、箱型、重量、封志，各自回答什么？</h2><p>识别码帮助确认对象，技术资料说明能力与状态，业务记录描述这一次运输。它们需要互相对应。</p><div class="container-concept-grid">{containerConcepts.map((c,i)=><article id={'concept-'+c.id}><span>{String(i+1).padStart(2,'0')}</span><h3>{c.title}</h3><p>{c.text}</p>{c.example&&<div>{c.example}</div>}</article>)}</div></section>
<KnowledgeCheck quiz={containerQuiz}/>
<section class="cargo-section cargo-source-section"><h2>箱型图鉴的参考资料</h2><p>规格资料用于认识常见结构，不保证任何一只实际箱体具有完全相同的内部尺寸、门洞或载荷。装货前以实际箱体及适用资料为准。</p><ol class="source-list">{containerSources.map(s=><li id={s.id}><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>{s.org} · 核查 {s.checked} · {s.scope}</small></li>)}</ol></section><div class="cargo-crosslinks"><a href={base+'cargo/energy-storage/'}>像箱子的储能设备<span>先分清产品与运输载体 →</span></a><a href={base+'cargo/wind-blade/'}>超长叶片怎么运<span>从框架箱继续认识项目货 →</span></a><a href={base+'journey/'}>跟着一只箱走完港口<span>设备、单证与系统怎样接力 →</span></a></div>
</div><script src="../scripts/cargo-choices.ts"></script><script>
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-container-group]')];
const items=[...document.querySelectorAll<HTMLAnchorElement>('[data-type-group]')];
function filterTypes(group:string){
  let count=0;
  items.forEach(item=>{item.hidden=group!=='全部'&&item.dataset.typeGroup!==group;if(!item.hidden)count++});
  buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.containerGroup===group)));
  document.querySelector('#container-filter-status')!.textContent=group+' · '+count+' 种箱型';
}
buttons.forEach(button=>button.addEventListener('click',()=>{
  filterTypes(button.dataset.containerGroup!);
  const selected=items.find(i=>i.hasAttribute('aria-current'));
  if(selected?.hidden)items.find(i=>!i.hidden)?.click();
}));
document.querySelector('#container-explorer')?.addEventListener('choicechange',()=>{
  if(items.find(i=>i.hasAttribute('aria-current'))?.hidden)filterTypes('全部');
});
</script></Layout>
