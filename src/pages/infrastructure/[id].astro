---
import HardwareSymbol from '../../components/HardwareSymbol.astro';
import Layout from '../../layouts/Layout.astro';
import BayExplorer from '../../components/BayExplorer.astro';
import YardLab from '../../components/YardLab.astro';
import {infrastructureTopics,infrastructureSources,yardModes,hardware} from '../../data/infrastructure.js';
import '../../styles/infrastructure.css';
export function getStaticPaths(){return infrastructureTopics.map(topic=>({params:{id:topic.id},props:{topic}}));}
const {topic:t}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const chapterTitle=(title:string)=>title.replace(/^\d+\s*[/.·]\s*/, '');
const sources=infrastructureSources.filter(s=>t.sources.includes(s.id));
---
<Layout title={t.title} active="systems" description={t.summary}><div class="container infra-page"><div class="breadcrumbs"><a href={base+'systems/'}>港口系统</a><span>／</span><a href={base+'infrastructure/'}>运行基础</a><span>／</span><span>{t.title}</span></div><header class="infra-hero"><div><span class="eyebrow">{t.eyebrow}</span><h1>{t.title}</h1><p>{t.summary}</p><a class="text-link" href="#explore">先动手探索 ↓</a></div><figure><img src={base+t.visual.replace(/^\//,'')} alt={t.title+'教学结构示意图'} width="720" height="360"/><figcaption>原创结构示意 · 不按实际比例 · 不作为工程图纸</figcaption></figure></header><nav class="infra-local-nav" aria-label="专题目录"><a href="#intro">先分清</a><a href="#explore">动手探索</a><a href="#chapters">知识脉络</a><a href="#handoffs">岗位交接</a><a href="#misconceptions">常见误解</a><a href="#sources">来源与边界</a></nav><section class="infra-section" id="intro"><span class="eyebrow">START HERE</span><h2>先把几个关键概念分开。</h2><div class="infra-intro-grid">{t.intro.map(i=><article><h3>{i.title}</h3><p>{i.text}</p></article>)}</div></section><div id="explore" class="infra-section">{t.id==='bay'&&<BayExplorer/>}{t.id==='yard'&&<><YardLab/><section class="infra-section" data-choice-scope><span class="eyebrow">YARD ORGANIZATION / 多种方式可以并存</span><h2>设备换了，堆场怎样组织？</h2><nav class="infra-choice-nav" aria-label="选择堆场组织方式">{yardModes.map(m=><a href={'#yard-mode-'+m.id} data-choice={'yard-mode-'+m.id}>{m.name}</a>)}</nav><p class="infra-choice-status" data-choice-status role="status" aria-live="polite"></p>{yardModes.map(m=><article id={'yard-mode-'+m.id} data-choice-panel class="infra-detail"><h3>{m.name}</h3><dl class="infra-detail-grid">{[['典型设备',m.equipment],['空间与交通',m.layout],['适用价值',m.advantages],['需要付出的代价',m.tradeoffs],['系统怎样配合',m.system],['改造时看什么',m.transition]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></article>)}</section></>}{t.id==='it-room'&&<section class="infra-lab" data-choice-scope><div class="infra-lab-heading"><span class="eyebrow">HARDWARE FIELD GUIDE / 点击认识硬件</span><h2>从闸口的一条消息，看机房里谁在工作。</h2><p>选一个部件，看看它解决什么问题、对港口有什么作用，以及故障会影响哪一环。</p></div><div class="infra-message-path"><span>闸口采集</span><b>→</b><span>网络与安全边界</span><b>→</b><span>应用服务器</span><b>↔</b><span>数据库与存储</span><b>→</b><span>执行结果</span></div><div class="hardware-layout"><nav class="hardware-grid" aria-label="选择机房硬件">{hardware.map((h,i)=><a href={'#hardware-'+h.id} data-choice={'hardware-'+h.id}><HardwareSymbol id={h.id}/><small>{h.category}</small><strong>{h.name}</strong><span class="hardware-index">{String(i+1).padStart(2,'0')}</span></a>)}</nav><div class="hardware-panels"><p class="infra-choice-status" data-choice-status role="status" aria-live="polite"></p>{hardware.map(h=><article class="hardware-detail" id={'hardware-'+h.id} data-choice-panel><span class="eyebrow">{h.category}</span><h3>{h.name}</h3><p class="hardware-analogy">{h.analogy}</p><dl>{[['解决什么问题',h.role],['港口里的例子',h.portExample],['出问题会怎样',h.failure],['理解边界',h.boundary]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></article>)}</div></div><p class="infra-boundary">图中是逻辑关系，不是实际网络拓扑。业务是否放行仍由有效权限、业务状态和现场条件共同决定，不能因为服务器有响应就自动抬杆。</p></section>}</div><section class="infra-section" id="chapters"><span class="eyebrow">THE KNOWLEDGE MAP</span><h2>从概念到业务，把关键环节串起来。</h2><nav class="infra-chapter-nav" aria-label="知识章节">{t.chapters.map((c,i)=><a href={'#chapter-'+c.id}><span>0{i+1}</span>{chapterTitle(c.title)}</a>)}</nav>{t.chapters.map((c,i)=><article class="infra-chapter" id={'chapter-'+c.id}><header><span>0{i+1}</span><div><h3>{chapterTitle(c.title)}</h3><p>{c.summary}</p></div></header><div class="infra-points">{c.points.map(p=><section><h4>{p.title}</h4><p>{p.text}</p></section>)}</div></article>)}</section><section class="infra-section" id="handoffs"><span class="eyebrow">WHO HANDS OVER WHAT</span><h2>部门之间，交出去的到底是什么？</h2><div class="infra-handoffs">{t.handoffs.map(h=><article><div><strong>{h.from}</strong><span>↓</span><strong>{h.to}</strong></div><dl><dt>交接记录</dt><dd>{h.record}</dd><dt>接收方核对</dt><dd>{h.check}</dd></dl></article>)}</div></section><section class="infra-section" id="misconceptions"><span class="eyebrow">COMMON MISREADINGS</span><h2>容易混在一起的几件事。</h2><div class="infra-intro-grid">{t.misconceptions.map(m=><article><h3>{m.title}</h3><p>{m.text}</p></article>)}</div></section><section class="infra-section infra-related"><h2>继续沿着业务走。</h2>{t.links.map(l=><a href={base+l.path.replace(/^\//,'')}>{l.label} →</a>)}{infrastructureTopics.filter(o=>o.id!==t.id).map(o=><a href={base+'infrastructure/'+o.id+'/'}>{o.title} →</a>)}</section><section class="infra-section" id="sources"><span class="eyebrow">SOURCES & SCOPE</span><h2>依据与适用范围</h2><p class="infra-boundary">{t.scope}</p><div class="infra-sources">{sources.map(s=><article id={'source-'+s.id}><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><span>{s.org} · 核查 {s.checked}</span><p>{s.scope}</p></article>)}</div></section></div><script>import '../../scripts/cargo-choices';</script></Layout>
