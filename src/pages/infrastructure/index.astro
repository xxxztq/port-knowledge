---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import {infrastructureTopics} from '../../data/infrastructure.js';
import '../../styles/infrastructure.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="贝位、堆场与IT机房" active="systems" description="从船上贝位、堆场演进到服务器与机房，用互动图解认识港口作业的空间组织与数字基础。"><PageIntro eyebrow="PORT INFRASTRUCTURE / 从位置到运行基础" title="一只箱的背后，还有一整套组织方式。" description="贝位帮助找到船上位置，堆场把空间与作业排在一起，机房让业务系统持续处理任务与实绩。沿着这三层关系，把港口看得更立体。"/><div class="container infra-page"><div class="infra-overview-line"><span>船上位置</span><b>→</b><span>场内位置与移箱</span><b>↔</b><span>任务、网络与硬件</span></div><div class="infra-topic-grid">{infrastructureTopics.map((t,i)=><a href={base+'infrastructure/'+t.id+'/'}><figure><img src={base+t.visual.replace(/^\//,'')} alt={t.title+'原创教学示意'} width="720" height="360"/></figure><div><span class="eyebrow">0{i+1} / FIELD NOTES</span><h2>{t.title}</h2><p>{t.summary}</p><strong>{['打开箱位定位器','试一次堆场移箱','翻开硬件图鉴'][i]} →</strong></div></a>)}</div><section class="infra-section"><span class="eyebrow">FOLLOW THE RECORD</span><h2>沿着一条作业记录，认识它们的关系。</h2><div class="infra-record-flow">{[['船舶计划','明确箱号、船上位置与作业要求'],['现场装卸','设备执行任务，确认真实动作'],['堆场入位','记录箱区、位置与库存变化'],['系统处理','应用、数据库、网络共同处理记录'],['下一次交接','提箱与闸口核对相应任务和有效状态']].map(([title,text],i)=><article><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div><p class="infra-boundary">这条链用于理解关系。实际消息先后、接口、位置编码和岗位划分由具体码头与船舶确定；现场执行条件与监管、商业授权仍要分别核对。</p></section><section class="infra-section infra-related"><h2>接着把货物与设备也放进来。</h2><a href={base+'containers/'}>认识 12 种集装箱 →</a><a href={base+'cargo/'}>货类与运输方式 →</a><a href={base+'equipment/'}>港口作业设备 →</a><a href={base+'systems/'}>港口系统与外部协作 →</a><a href={base+'gate/'}>闸口校验与抬杆 →</a></section></div></Layout>
