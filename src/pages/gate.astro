---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import {gateTasks} from '../data/scenarios.js';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="闸口与监管" active="gate" description="通过五类任务和交互演示，理解进出闸校验、海关与电子口岸信息，以及授权、抬杆、通行和回执的区别。"><div class="container"><PageIntro eyebrow="GATE & INFORMATION" title="杆为什么抬，也为什么不抬？" description="先辨认业务，再核对条件，最后确认实际通行。闸口是实物、任务、授权和设备状态汇合的地方。"/><div class="page-content">
<div class="notice">交互教学 · 下方全部是虚构任务与模拟状态，不连接海关、电子口岸或真实闸机。各港口实际校验项、接口路径和处理权限不同。</div>
<section class="gate-simulator" aria-labelledby="sim-title"><div class="sim-top"><div><span class="eyebrow">TRY A GATE VISIT</span><h2 id="sim-title">模拟一趟集卡进出场</h2></div><button class="button outline" id="reset-gate">重置演示</button></div>
<div class="sim-selectors"><label>业务类型<select id="gate-task">{gateTasks.map(t=><option value={t.id}>{t.title}</option>)}</select></label><fieldset><legend>观察的闸口方向</legend><label><input type="radio" name="gate-stage" value="arrival" checked/> 进闸</label><label><input type="radio" name="gate-stage" value="departure"/> 出闸</label></fieldset></div>
<div class="gate-story"><div><span>01 · 进场</span><p id="task-arrival"></p></div><div><span>02 · 场内</span><p id="task-inside"></p></div><div><span>03 · 出场</span><p id="task-departure"></p></div></div>
<p class="external-note" id="task-description"></p><div class="sim-grid"><div class="check-panel"><div class="sim-label"><h3 id="checks-title">业务校验项</h3><button id="satisfy-checks" class="text-button">填入全部满足的示例</button></div><p class="small-copy">勾选表示该项已核对通过；未勾选代表未满足或未知。可取消任意项观察阻断原因。</p><div id="gate-checks"></div></div>
<div class="gate-console"><div class="console-heading"><span class="eyebrow">SIMULATED LANE 01</span><span class="pill" id="gate-state">待校验</span></div><div class="lane-visual" aria-hidden="true"><div class="road-line"></div><div class="truck-shape">集卡<div></div></div><div class="barrier-base"><span class="barrier-arm"></span></div><div class="lane-stop"></div></div>
<div class="device-controls"><label><input type="checkbox" id="device-ready" checked/> 设备与通道就绪，可反馈抬杆／通行</label><label><input type="checkbox" id="receipt-ready" checked/> 通行记录回执正常</label></div>
<ol class="gate-progress"><li data-state="authorized">业务授权</li><li data-state="opened">抬杆反馈</li><li data-state="passed">实际通过</li><li data-state="recorded">记录确认</li></ol>
<div class="gate-buttons"><button class="button primary" data-event="authorize">1. 校验并授权</button><button class="button outline" data-event="open" disabled>2. 模拟抬杆</button><button class="button outline" data-event="pass" disabled>3. 确认车辆通过</button><button class="button outline" data-event="record" disabled>4. 确认记录回执</button></div>
<div id="gate-result" role="status" aria-live="polite">选择业务和方向后，点击“校验并授权”。</div><p class="small-copy">这是教学分步操作。真实现场由设备、系统和岗位按权限协同，不能把按钮当作人工绕过监管的流程。</p></div></div></section>
<section class="section"><div class="section-heading"><div><div class="eyebrow">DATA HAS A JOURNEY</div><h2>电子口岸、海关和码头，怎么衔接？</h2></div></div><div class="info-flow"><div><span>01</span><h3>业务主体形成信息</h3><p>承运人、代理、场站等按适用职责形成舱单、运抵、理货等信息。来源、版本与业务对象必须明确。</p></div><div><span>02</span><h3>通过适用渠道交换</h3><p>可能经国际贸易“单一窗口”、地方电子口岸或获准的对接系统。不同业务、地方和企业的连接方式不同。</p></div><div><span>03</span><h3>监管处理与反馈</h3><p>发送成功、平台接收、业务受理、查验与放行是不同状态。回执异常应追溯对应报文和对象。</p></div><div><span>04</span><h3>码头按任务判断</h3><p>把有效监管状态与商业授权、场内实绩等分别关联，再结合闸机状态完成适用通行判断。</p></div></div><div class="notice">这张图表达信息责任关系，不代表全国统一接口拓扑。电子口岸不是海关的同义词；海关放行也不会直接替代船公司放货、码头作业确认和道闸反馈。</div></section>
<div class="two-column"><div class="panel"><h2>正常链路之外，也要讲异常</h2><p>识别错箱：比对实物与来源记录，修正责任方明确后重核。回执超时：查询接收结果，避免重复报送。设备故障：保留业务状态并处理设备。已经实际通过但回写失败：保留真实事件，补核记录。</p></div><div class="panel"><h2>深入阅读与资料</h2><p>基础校验、任务差异、异常回执与费用各有独立知识卡，企业资料只说明其自身流程。</p><a class="text-link" href={base+'library/?q=闸口'}>查看闸口专题 <Icon name="arrow"/></a><ul class="source-list"><li><a href="https://online.customs.gov.cn/static/pages/guides/000629018002/000629018002.html" target="_blank" rel="noopener noreferrer">海关总署：进出境运输工具舱单及相关电子数据传输服务</a></li><li><a href="https://www.nbsinglewindow.cn/plinfo/index.do" target="_blank" rel="noopener noreferrer">宁波国际贸易“单一窗口”（地方示例）</a></li><li><a href="https://ups.portshanghai.com.cn/Home/OperatingGuide" target="_blank" rel="noopener noreferrer">上港集团操作指南（企业示例）</a></li></ul></div></div>
</div></div></Layout>
<script>
import {gateTasks} from '../data/scenarios.js';import {gateChecks,gateTransition} from '../lib/gate-model.mjs';
const taskSelect=document.querySelector<HTMLSelectElement>('#gate-task')!;let state='idle';
const $=(id:string)=>document.getElementById(id)!;const names:Record<string,string>={idle:'待校验',authorized:'已授权',opened:'已抬杆',passed:'已通过 · 待回执',recorded:'记录已确认'};
const stage=()=>document.querySelector<HTMLInputElement>('input[name="gate-stage"]:checked')!.value;
function context(){const checks:Record<string,boolean>={};document.querySelectorAll<HTMLInputElement>('[data-check]').forEach(i=>checks[i.dataset.check!]=i.checked);return {task:taskSelect.value,stage:stage(),checks,deviceReady:($('device-ready') as HTMLInputElement).checked,receiptReady:($('receipt-ready') as HTMLInputElement).checked};}
function renderState(){ $('gate-state').textContent=names[state];const order=['idle','authorized','opened','passed','recorded'];document.querySelectorAll<HTMLElement>('.gate-progress li').forEach(li=>li.classList.toggle('done',order.indexOf(li.dataset.state!)<=order.indexOf(state)));const expected:Record<string,string>={authorize:'idle',open:'authorized',pass:'opened',record:'passed'};document.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(b=>b.disabled=expected[b.dataset.event!]!==state);document.querySelector('.lane-visual')!.classList.toggle('is-open',state==='opened');document.querySelector('.lane-visual')!.classList.toggle('is-passed',['passed','recorded'].includes(state));const locked=['passed','recorded'].includes(state);document.querySelectorAll<HTMLInputElement>('[data-check]').forEach(i=>i.disabled=locked);($('satisfy-checks') as HTMLButtonElement).disabled=locked;($('device-ready') as HTMLInputElement).disabled=locked; }
function reset(){state='idle';const t=gateTasks.find(t=>t.id===taskSelect.value)!;['arrival','inside','departure','description'].forEach(key=>{$('task-'+key).textContent=t[key as keyof typeof t] as string;});$('checks-title').textContent=(stage()==='arrival'?'进闸':'出闸')+' · 业务校验项';const host=$('gate-checks');host.replaceChildren();gateChecks(taskSelect.value,stage()).forEach(r=>{const label=document.createElement('label');label.className='check-row';const input=document.createElement('input');input.type='checkbox';input.dataset.check=r.id;input.checked=true;const span=document.createElement('span');const strong=document.createElement('strong');strong.textContent=r.label;const small=document.createElement('small');small.textContent=r.detail;span.append(strong,small);label.append(input,span);host.append(label);input.addEventListener('change',()=>{state='idle';$('gate-result').textContent='校验项已变化，重新判断业务授权。';renderState();});});($('device-ready') as HTMLInputElement).checked=true;($('receipt-ready') as HTMLInputElement).checked=true;$('gate-result').textContent='已载入正常业务示例。可取消一项校验或模拟设备故障，再尝试通行。';renderState();}
taskSelect.addEventListener('change',reset);document.querySelectorAll('[name="gate-stage"]').forEach(i=>i.addEventListener('change',reset));$('reset-gate').addEventListener('click',reset);$('satisfy-checks').addEventListener('click',()=>{document.querySelectorAll<HTMLInputElement>('[data-check]').forEach(i=>i.checked=true);state='idle';$('gate-result').textContent='全部业务项已填为满足；设备与回执状态仍独立判断。';renderState();});document.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(b=>b.addEventListener('click',()=>{const result=gateTransition(state,b.dataset.event!,context());state=result.state;$('gate-result').textContent=result.message;renderState();}));reset();
</script>
