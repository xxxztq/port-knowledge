---
import VesselEntry from '../../components/VesselEntry.astro';
import RiskEntry from '../../components/RiskEntry.astro';
import InfrastructureEntry from '../../components/InfrastructureEntry.astro';
import Layout from '../../layouts/Layout.astro';import EquipmentFigure from '../../components/EquipmentFigure.astro';import KnowledgeDiagram from '../../components/KnowledgeDiagram.astro';import ReadingProgress from '../../components/ReadingProgress.astro';import Icon from '../../components/Icon.astro';
import TopicTrail from '../../components/TopicTrail.astro';
import { articles, domains, sources } from '../../data/knowledge.js';
export function getStaticPaths(){return articles.map(article=>({params:{id:article.id},props:{article}}))}
const { article: a } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const domain = domains.find((d) => d.id === a.domain);
const references = sources.filter((s) => a.sourceIds.includes(s.id));
const related = articles.filter((x) => a.related.includes(x.id));
const articleIndex = articles.findIndex((x) => x.id === a.id);
const previous = articleIndex > 0 ? articles[articleIndex - 1] : null;
const next = articleIndex >= 0 && articleIndex < articles.length - 1 ? articles[articleIndex + 1] : null;
---
<Layout title={a.title} description={a.summary} active="library"><ReadingProgress/><div class="container"><div class="breadcrumbs"><a href={base}>首页</a><Icon name="chevron" size={12}/><a href={base+'library/'}>知识百科</a><Icon name="chevron" size={12}/><a href={base+'library/?domain='+a.domain}>{domain?.title}</a></div><div class="article-layout"><article class="article-body" data-article={a.id}><div class="article-meta"><span class="tag">{a.kind}</span><span>{a.level}</span><span>阅读约 {Math.max(2,Math.ceil(a.sections.reduce((n,s)=>n+s.body.length,0)/350))} 分钟</span></div><h1 id="article-title" class="article-title" data-article-title tabindex="-1" aria-describedby="article-subtitle article-summary">{a.title}</h1><p id="article-subtitle" class="article-subtitle">{a.subtitle}</p><p id="article-summary" class="article-summary">{a.summary}</p><details class="article-mobile-toc"><summary>本篇导航</summary><nav aria-label="本篇导航链接"><a href="#visual-explainer">先看一张图</a>{a.sections.map((s,i)=><a href={'#section-'+i}>{s.title}</a>)}<a href="#check">需要核对什么</a><a href="#pitfalls">容易混淆的地方</a><a href="#sources">参考来源</a></nav></details>{['k10','k21'].includes(a.domain)&&<InfrastructureEntry compact/>}{['k18-overview','k19-overview','k21-overview','job-it','gate-messages'].includes(a.id)&&<div class="systems-article-entry"><h2>继续看港口系统全景</h2><p>集装箱与件杂货系统怎样分工，业务信息如何连接设备、闸口和外部主体。</p><a href={base+'systems/'}>打开系统图谱与信息交互案例 →</a></div>}{['k10','k12','k14','k15'].includes(a.domain)&&<div class="cargo-inline-entry"><h2>从概念继续走到具体货物</h2><p>看看 12 种箱型，以及新能源汽车、储能柜、风电叶片、木材、卷钢等货物的运输、系统、交接与费用。</p><a href={base+'cargo/'}>打开箱型与货类业务图谱 →</a></div>}{['k08','k11','k13','k14'].includes(a.domain)&&<VesselEntry compact/>}<div id="visual-explainer">{a.kind==='设备'?<EquipmentFigure articleId={a.id}/>:<KnowledgeDiagram articleId={a.id}/>}</div>{a.sections.map((s,i)=><section class="article-section" id={'section-'+i}><h2>{s.title}</h2><p>{s.body}</p></section>)}<section class="article-section" id="check"><h2>把这件事核对清楚</h2><ul>{a.checks.map(c=><li>{c}</li>)}</ul></section><section class="article-section" id="pitfalls"><h2>容易混淆的地方</h2><ul>{a.pitfalls.map(p=><li>{p}</li>)}</ul></section><div class="notice"><strong>适用范围</strong><br/>{a.scope}</div>{['k20','k21','k22','k23','k24'].includes(a.domain)&&<RiskEntry compact/>}<section class="article-section" id="sources"><h2>参考来源</h2><p class="external-note">用于核对概念和示例。来源的地区、时间与用途不等于全国统一操作规程。</p><ol class="source-list">{references.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>{s.org} · {s.scope} · 核查 {s.checked}</small></li>)}</ol></section><TopicTrail article={a} related={related} previous={previous} next={next} base={base}/></article><aside class="article-aside" aria-label="文章侧栏"><div class="aside-box"><h3>本篇导航</h3><a href="#visual-explainer">先看一张图</a>{a.sections.map((s,i)=><a href={'#section-'+i}>{s.title}</a>)}<a href="#check">需要核对什么</a><a href="#pitfalls">容易混淆的地方</a><a href="#sources">参考来源</a></div><div class="aside-box"><h3>沿着关系继续看</h3>{related.map(r=><a href={base+'knowledge/'+r.id+'/'}>{r.title} →</a>)}</div><div class="aside-box"><h3>回到完整业务</h3><a href={base+'flows/'}>跟着业务走 →</a><a href={base+'gate/'}>体验闸口交互 →</a><a href={base+'economics/'}>看看费用与经营 →</a></div></aside></div></div></Layout>
<style>
  .article-mobile-toc { display: none; }
  @media (max-width: 700px) {
    .article-mobile-toc { display: block; margin: 0 0 28px; border: 1px solid var(--line); border-radius: 10px; background: #fff; overflow: clip; }
    .article-mobile-toc summary { cursor: pointer; padding: 14px 16px; color: var(--deep); font-size: 14px; font-weight: 700; list-style-position: inside; }
    .article-mobile-toc nav { display: grid; gap: 1px; padding: 0 16px 12px; border-top: 1px solid var(--line); }
    .article-mobile-toc nav a { padding: 9px 0; color: #66816e; font-size: 13px; line-height: 1.6; border-bottom: 1px solid #edf1eb; }
    .article-mobile-toc nav a:last-child { border-bottom: 0; }
    .article-mobile-toc nav a:hover { color: var(--teal); }
    .article-aside .aside-box:first-child { display: none; }
  }
</style>
