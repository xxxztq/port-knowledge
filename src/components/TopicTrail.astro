---
import Icon from './Icon.astro';

const {
  article,
  related = [],
  previous = null,
  next = null,
  base = '/'
} = Astro.props;

const articleHref = (id) => `${base}knowledge/${id}/`;
const pageHref = (path) => `${base}${String(path).replace(/^\/+/, '')}`;

const cargoDomains = new Set(['k10', 'k11', 'k12', 'k13', 'k14', 'k15', 'k16']);
const systemIds = new Set(['k18-overview', 'k19-overview', 'k21-overview', 'gate-messages', 'gate-passage', 'job-it']);
const exceptionIds = new Set(['incident-recovery', 'dispute-evidence', 'container-inspection']);

const groupDefinitions = [
  {
    id: 'roles',
    label: '相关岗位',
    eyebrow: 'PEOPLE / 角色协作',
    intro: '看看谁接手、收到什么，以及怎样把现场动作交回计划和中控。',
    landing: { label: '打开岗位协作全景', href: pageHref('roles/') },
    icon: 'people',
    matches: (item) => item.kind === '岗位' || item.id.startsWith('job-') || item.domain === 'k07'
  },
  {
    id: 'equipment',
    label: '相关设备',
    eyebrow: 'ASSETS / 设备能力',
    intro: '把业务动作落到具体设备，理解设备能力、作业边界和维护关系。',
    landing: { label: '打开设备图鉴', href: pageHref('equipment/') },
    icon: 'crane',
    matches: (item) => item.kind === '设备' || item.id.startsWith('eq-') || item.domain === 'k20'
  },
  {
    id: 'cargo',
    label: '相关货类',
    eyebrow: 'CARGO / 货物路线',
    intro: '换一种货物或箱型，看看运输方式、交接校验和风险为什么会变化。',
    landing: { label: '查看箱型与货类全景', href: pageHref('cargo/') },
    icon: 'route',
    matches: (item) => cargoDomains.has(item.domain) || item.id.startsWith('container-')
  },
  {
    id: 'exceptions',
    label: '相关异常',
    eyebrow: 'EXCEPTIONS / 异常恢复',
    intro: '流程卡住时，先定位哪一个条件没满足，再找到负责判断和恢复的人。',
    landing: { label: '进入风险与异常专题', href: pageHref('risks/') },
    icon: 'warning',
    matches: (item) => exceptionIds.has(item.id) || item.domain === 'k22' || /故障|异常|恢复|争议|查验|应急/.test(item.title)
  },
  {
    id: 'systems',
    label: '相关系统',
    eyebrow: 'SYSTEMS / 信息与授权',
    intro: '分清消息、业务状态和真正的授权，看看它们怎样连接港口内部与外部平台。',
    landing: { label: '打开港口系统图谱', href: pageHref('systems/') },
    icon: 'chart',
    matches: (item) => systemIds.has(item.id) || item.domain === 'k21' || item.id === 'k19-overview'
  }
];

const isCurrentTopic = (definition) => definition.matches(article);
const groups = groupDefinitions
  .map((definition) => ({
    ...definition,
    items: related.filter((item) => definition.matches(item)),
    relevant: isCurrentTopic(definition) || related.some((item) => definition.matches(item))
  }))
  .filter((definition) => definition.relevant);

const groupedIds = new Set(groups.flatMap((group) => group.items.map((item) => item.id)));
const ungrouped = related.filter((item) => !groupedIds.has(item.id));
const hasTrail = groups.length > 0 || ungrouped.length > 0 || previous || next;
---
{hasTrail && <section class="topic-trail" aria-labelledby="topic-trail-title">
  <div class="topic-trail-heading">
    <div>
      <span class="eyebrow">KEEP LEARNING / 下一步</span>
      <h2 id="topic-trail-title">沿着关系继续看</h2>
    </div>
    <p>从当前概念向岗位、设备、货物、系统和异常展开；每一张卡都回到同一条港口业务链。</p>
  </div>

  {(groups.length > 0 || ungrouped.length > 0) && <div class="topic-trail-grid">
    {groups.map((group) => <section class="topic-trail-group" aria-labelledby={'topic-trail-'+group.id}>
      <div class="topic-trail-group-heading">
        <span class="topic-trail-icon"><Icon name={group.icon} size={19}/></span>
        <div>
          <span class="topic-trail-eyebrow">{group.eyebrow}</span>
          <h3 id={'topic-trail-'+group.id}>{group.label}</h3>
        </div>
      </div>
      <p class="topic-trail-intro">{group.intro}</p>
      {group.items.length > 0 && <ul class="topic-trail-links">
        {group.items.map((item) => <li><a href={articleHref(item.id)}>{item.title}<span aria-hidden="true">→</span></a></li>)}
      </ul>}
      <a class="topic-trail-landing" href={group.landing.href}>{group.landing.label}<span aria-hidden="true">↗</span></a>
    </section>)}

    {ungrouped.length > 0 && <section class="topic-trail-group topic-trail-group--related" aria-labelledby="topic-trail-related">
      <div class="topic-trail-group-heading">
        <span class="topic-trail-icon"><Icon name="book" size={19}/></span>
        <div>
          <span class="topic-trail-eyebrow">RELATED / 关联知识</span>
          <h3 id="topic-trail-related">其他相关知识卡</h3>
        </div>
      </div>
      <p class="topic-trail-intro">这些概念与当前主题有关，但不属于上面的岗位、设备、货类、异常或系统分组。</p>
      <ul class="topic-trail-links">
        {ungrouped.map((item) => <li><a href={articleHref(item.id)}>{item.title}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </section>}
  </div>}

  {(previous || next) && <nav class="topic-trail-pager" aria-label="知识卡前后导航">
    {previous ? <a class="topic-trail-pager-link topic-trail-pager-link--previous" href={articleHref(previous.id)}>
      <span class="topic-trail-pager-label"><span aria-hidden="true">←</span> 上一张知识卡</span>
      <strong>{previous.title}</strong>
    </a> : <span class="topic-trail-pager-placeholder" aria-hidden="true"></span>}
    {next ? <a class="topic-trail-pager-link topic-trail-pager-link--next" href={articleHref(next.id)}>
      <span class="topic-trail-pager-label">下一张知识卡 <span aria-hidden="true">→</span></span>
      <strong>{next.title}</strong>
    </a> : <span class="topic-trail-pager-placeholder" aria-hidden="true"></span>}
  </nav>}
</section>}

<style>
.topic-trail{margin-top:42px;padding:30px 0 0;border-top:1px solid var(--line)}
.topic-trail-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:22px}
.topic-trail-heading h2{margin:7px 0 0;font-size:clamp(24px,3vw,34px);letter-spacing:-.03em}
.topic-trail-heading p{max-width:390px;margin:0;color:var(--muted);font-size:13px;line-height:1.8}
.topic-trail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.topic-trail-group{display:flex;flex-direction:column;min-width:0;padding:20px;border:1px solid var(--line);background:linear-gradient(145deg,#fbfcf8,#f3f5ef);border-radius:14px}
.topic-trail-group-heading{display:flex;align-items:center;gap:11px}
.topic-trail-icon{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border:1px solid #b8c8bd;border-radius:11px;background:#edf3ed;color:var(--deep)}
.topic-trail-eyebrow{display:block;color:var(--muted);font-size:9px;letter-spacing:1.1px;line-height:1.3}
.topic-trail-group h3{margin:4px 0 0;font-size:18px;line-height:1.25}
.topic-trail-intro{margin:15px 0 13px;color:var(--muted);font-size:12px;line-height:1.75}
.topic-trail-links{display:grid;gap:7px;margin:0;padding:0;list-style:none}
.topic-trail-links a{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:10px 11px;border:1px solid transparent;border-radius:8px;color:var(--ink);font-size:13px;line-height:1.45;text-decoration:none;background:#fff8}
.topic-trail-links a span{flex:0 0 auto;color:var(--accent);font-size:16px;line-height:1.1;transition:transform .18s ease}
.topic-trail-links a:hover,.topic-trail-links a:focus-visible{border-color:#b8c8bd;background:#fff;outline:none}
.topic-trail-links a:hover span,.topic-trail-links a:focus-visible span{transform:translateX(3px)}
.topic-trail-landing{display:inline-flex;align-items:center;gap:8px;align-self:flex-start;margin-top:15px;color:var(--deep);font-size:12px;font-weight:700;text-decoration:none}
.topic-trail-landing span{font-size:15px;color:var(--accent)}
.topic-trail-landing:hover,.topic-trail-landing:focus-visible{text-decoration:underline;text-underline-offset:3px;outline:none}
.topic-trail-pager{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin-top:30px}
.topic-trail-pager-link{display:flex;flex-direction:column;justify-content:space-between;min-height:91px;padding:17px 19px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink);text-decoration:none}
.topic-trail-pager-link--next{text-align:right;background:#edf3ed;border-color:#c5d3c9}
.topic-trail-pager-link:hover,.topic-trail-pager-link:focus-visible{border-color:var(--deep);outline:3px solid color-mix(in srgb,var(--deep) 18%,transparent);outline-offset:2px}
.topic-trail-pager-label{color:var(--muted);font-size:10px;letter-spacing:.8px;text-transform:uppercase}
.topic-trail-pager-label span{color:var(--accent);font-size:17px;vertical-align:-2px}
.topic-trail-pager strong{margin-top:12px;font-size:14px;line-height:1.45}
.topic-trail-pager-placeholder{display:block}
@media(max-width:700px){
  .topic-trail{margin-top:34px;padding-top:25px}
  .topic-trail-heading{display:block;margin-bottom:18px}
  .topic-trail-heading h2{font-size:26px}
  .topic-trail-heading p{margin-top:10px;font-size:12px}
  .topic-trail-grid{grid-template-columns:1fr;gap:10px}
  .topic-trail-group{padding:17px}
  .topic-trail-pager{grid-template-columns:1fr;gap:10px;margin-top:22px}
  .topic-trail-pager-link--next{text-align:left}
  .topic-trail-pager-placeholder{display:none}
}
@media(prefers-reduced-motion:reduce){.topic-trail-links a span{transition:none}}
</style>
