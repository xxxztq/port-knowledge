---
import Icon from './Icon.astro';import {equipmentVisuals} from '../data/equipment-visuals.js';
const {article,compact=false}=Astro.props;const v=equipmentVisuals.find(v=>v.id===article.id);const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{v&&<a class:list={['equipment-card',{'compact':compact}]} href={base+'knowledge/'+article.id+'/'} data-equipment-category={v.category} data-search-card data-kind={article.kind} data-domain={article.domain} data-search={[article.title,article.summary,...article.tags].join(' ')} data-id={article.id}><div class="equipment-card-art"><span class="art-code">{v.english}</span><img src={base+v.image} width="800" height="480" alt={v.shortName+'黑白结构示意'} loading="lazy" decoding="async"/><span class="art-caption">结构示意 / SCHEMATIC</span><span class="art-open" aria-hidden="true">↗</span></div><div class="equipment-card-copy"><div class="card-top"><span class="tag">{v.category}</span><span class="small-copy">3 个观察点</span></div><h3>{v.shortName}</h3><p>{v.summary}</p><div class="card-bottom"><span>认识结构与业务位置</span><Icon name="arrow" size={17}/></div></div></a>}
