<g transform="translate(826 475)"><rect width="90" height="7" fill="#386765"/><path d="M0 0v50m90-50v50" stroke="#386765" stroke-width="6"/><rect x="12" y="25" width="6" height="25" fill="#ce9956"/><path d="M15 26h55" stroke="#ce9956" stroke-width="5"/><path d="M26 23v6m12-6v6m12-6v6m12-6v6" stroke="#fff9e8" stroke-width="4"/></g>
<g fill="#477c7d"><rect x="453" y="362" width="40" height="15" rx="2"/><rect x="494" y="365" width="15" height="12" rx="2"/><rect x="756" y="544" width="42" height="15" rx="2"/><rect x="799" y="547" width="15" height="12" rx="2"/></g>
<g fill="#8eb5a1">{[[930,130],[935,195],[925,260],[914,330],[920,430],[520,92],[558,92]].map(([x,y])=><g><circle cx={x} cy={y} r="12"/><circle cx={x+7} cy={y-8} r="9"/></g>)}</g>
<g fill="#507774" font-size="13" letter-spacing="3"><text x="70" y="160">水域 · 航道</text><text x="570" y="207">集装箱堆场</text><text x="606" y="526">仓储与配套</text><text x="778" y="595">陆侧集疏运 →</text></g></svg>
{spots.map(s=><a class="map-hotspot" style={'left:'+s.x+'%;top:'+s.y+'%'} href={base+s.url} aria-label={s.name+'：'+s.text}><span>{s.n}</span><strong>{s.name}<small>{s.text}</small></strong></a>)}
<div class="map-legend"><span><i class="water"></i>水域</span><span><i class="land"></i>陆域</span><span><i class="operation"></i>作业节点</span><small>通用布局示意</small></div></div>