---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const spots = [{x:20,y:71,n:'01',name:'船舶与泊位',text:'靠泊、装卸与离港',url:'flows/'},{x:37,y:40,n:'02',name:'岸桥与装卸',text:'船与岸之间的第一棒',url:'equipment/'},{x:62,y:53,n:'03',name:'堆场与运输',text:'箱位、翻箱与场内衔接',url:'flows/'},{x:77,y:20,n:'04',name:'计划与中控',text:'协调人员、设备与计划',url:'roles/'},{x:86,y:76,n:'05',name:'闸口与交接',text:'人、车、箱与授权核对',url:'gate/'}];
---
<div class="port-map"><div class="map-topline"><span><i></i>港口全景 · 交互示意</span><span>点击编号，开始探索 ↗</span></div>
<svg class="port-scene" viewBox="0 0 1000 620" role="img" aria-label="港口示意图：左侧船舶水域，中间岸桥，右侧堆场、中控和闸口。"><defs><pattern id="waves" width="54" height="28" patternUnits="userSpaceOnUse"><path d="M0 16q8-5 16 0t16 0" stroke="#83b8bb" stroke-width="1.2" fill="none" opacity=".4"/></pattern><filter id="shadow"><feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#16454a" flood-opacity=".1"/></filter></defs>
<rect width="1000" height="620" fill="#e8eee3"/><path d="M0 0h340l-35 175 55 170-110 275H0z" fill="#9cc9cc"/><path d="M0 0h340l-35 175 55 170-110 275H0z" fill="url(#waves)"/><path d="M342 0l-35 175 55 170-110 275" fill="none" stroke="#f6f3e8" stroke-width="22"/>
<path d="M420 60l-37 116 55 170-82 210h563M467 175h450M479 380h440" stroke="#d4dbd1" stroke-width="28" fill="none"/><path d="M420 60l-37 116 55 170-82 210h563M467 175h450M479 380h440" stroke="#fffdf2" stroke-dasharray="10 12" stroke-width="2" fill="none"/>
<g filter="url(#shadow)">{[0,1,2,3,4].map(col=>[0,1,2].map(row=><g transform={'translate('+(486+col*75)+','+(222+row*36)+')'}><path d="M0 8l12-7h51l-12 7z" fill={col%2?'#e2ac67':'#649d99'}/><path d="M0 8h51v21H0z" fill={col%2?'#c58c4b':'#467d7c'}/><path d="M51 8l12-7v21l-12 7z" fill={col%2?'#ac7542':'#386765'}/><path d="M8 12v13m8-13v13m8-13v13m8-13v13m8-13v13" stroke={col%2?'#dfac72':'#76aaa4'} stroke-width="1"/></g>))}</g>
<g transform="translate(560 420)"><path d="M0 20l30-20h180l-30 20z" fill="#c7d5cc"/><path d="M0 20h180v65H0z" fill="#f5f5e9"/><path d="M180 20l30-20v65l-30 20z" fill="#bacdc2"/><path d="M12 40h155v5H12z" fill="#89aaa0"/><path d="M20 58h30v27H20zm50 0h30v27H70zm50 0h30v27h-30z" fill="#70938b"/></g>
<g transform="translate(714 60)"><path d="M0 28l30-20h115l-30 20z" fill="#b5d1c8"/><path d="M0 28h115v80H0z" fill="#fcfbef"/><path d="M115 28l30-20v80l-30 20z" fill="#c9ddd0"/><path d="M10 40h95v16H10zm0 28h95v16H10z" fill="#5b9290"/><path d="M29 40v44m24-44v44m24-44v44" stroke="#edf5e8" stroke-width="4"/><path d="M55 8v-20m-9 6h18" stroke="#527c77" stroke-width="3"/></g>
<g transform="translate(133 335) rotate(-20 65 80)"><path d="M0 10l58-35 82 35v189l-70 50L0 199z" fill="#264e57"/><path d="M10 13l48-25 70 25v174l-58 41-60-41z" fill="#e8e7cf"/><rect x="20" y="20" width="37" height="63" fill="#c58c4b"/><rect x="66" y="20" width="42" height="63" fill="#65988d"/><rect x="20" y="92" width="37" height="60" fill="#4b7c7b"/><rect x="66" y="92" width="42" height="60" fill="#c58c4b"/><rect x="21" y="167" width="86" height="22" fill="#fcfcf1"/><path d="M30 174h8m8 0h8m8 0h8m8 0h8" stroke="#4e7779" stroke-width="4"/></g>
