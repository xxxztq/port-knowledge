---
import {equipmentVisuals} from '../data/equipment-visuals.js';
const {articleId}=Astro.props;const visual=equipmentVisuals.find(v=>v.id===articleId);const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{visual&&<figure class="equipment-figure" data-equipment-figure><figcaption class="figure-heading"><div><span class="eyebrow">FIELD NOTES / {visual.english}</span><h2>先看懂它的结构</h2></div><a class="text-link" href={base+visual.image} target="_blank" rel="noopener noreferrer">打开原图 ↗</a></figcaption><div class="equipment-canvas"><img src={base+visual.image} width="800" height="480" alt={visual.shortName+'结构示意，编号与下方部位说明对应'} loading="lazy" decoding="async"/>{visual.points.map((p,i)=><button class="figure-hotspot" style={'left:'+p.x+'%;top:'+p.y+'%'} data-point={i} aria-label={'部位'+p.n+'：'+p.title} aria-pressed={i===0?'true':'false'}>{p.n}</button>)}</div><div class="figure-points" aria-label="设备部位说明">{visual.points.map((p,i)=><button class="figure-point" data-point={i} aria-pressed={i===0?'true':'false'}><span>0{p.n}</span><span class="figure-point-copy"><strong>{p.title}</strong><small>{p.description}</small></span></button>)}</div><p class="figure-active" role="status" aria-live="polite">{visual.points[0].description}</p><dl class="figure-facts">{visual.facts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl><p class="figure-note">原创教学示意 · 不按比例绘制，不代表具体设备型号或工程尺寸。部位概念与下方正文、参考资料配合阅读。</p></figure>}
<script>
document.querySelectorAll<HTMLElement>('[data-equipment-figure]').forEach(root=>{const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-point]')];buttons.forEach(b=>b.addEventListener('click',()=>{buttons.forEach(other=>other.setAttribute('aria-pressed',String(other.dataset.point===b.dataset.point)));const description=root.querySelector('.figure-point[data-point="'+b.dataset.point+'"] small')?.textContent||'';root.querySelector('.figure-active')!.textContent=description;}));});
</script>
