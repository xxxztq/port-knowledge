---
import {portRisks} from '../data/port-risks.js';
import {cargoRiskMap} from '../data/risk-learning.js';
const {cargoId, riskIds, compact=false}=Astro.props;
const ids=riskIds??cargoRiskMap[cargoId]??[];
const risks=portRisks.filter(r=>ids.includes(r.id));
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class:list={['risk-entry',{'risk-entry-compact':compact}]} aria-label="相关风险与预防">
  <div><span class="eyebrow">RISK & PREVENTION / 每一棒都要接稳</span><h2>{cargoId?'这种货，哪些地方容易出问题？':'从风险发生的位置，找到负责下一步的人。'}</h2><p>把预防、异常信号、处理责任和恢复记录放到同一条线上。</p><a class="text-link" href={base+'risks/'}>打开港口风险与预防 →</a></div>
  {risks.length>0&&<div class="risk-entry-links">{risks.map(r=><a href={base+'risks/'+r.id+'/'}>{r.title}<span aria-hidden="true">↗</span></a>)}</div>}
</section>
<style>
.risk-entry{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;padding:32px;border:1px solid var(--line,#d9ded8);background:#f1f2ed;border-radius:14px;margin:44px 0}.risk-entry h2{font-size:25px;line-height:1.45;margin:10px 0}.risk-entry p{font-size:14px;line-height:1.8;color:#526266}.risk-entry-links{display:grid;gap:7px;align-content:center}.risk-entry-links a{display:flex;justify-content:space-between;gap:15px;background:#fffdf8;border:1px solid #d9ded8;border-radius:5px;padding:11px 15px;font-size:14px}.risk-entry-links a:hover{border-color:#245963}.risk-entry-compact{padding:26px;margin:28px 0}.risk-entry-compact h2{font-size:23px}@media(max-width:700px){.risk-entry{grid-template-columns:1fr;padding:22px;gap:20px}.risk-entry h2{font-size:23px}}
</style>
