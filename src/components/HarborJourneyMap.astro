---
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const stops=[{id:'arrival',name:'船舶与泊位',x:12,y:49},{id:'unload',name:'船岸卸箱',x:31,y:37},{id:'yard',name:'堆场管理',x:52,y:34},{id:'pickup',name:'装车交接',x:55,y:61},{id:'gate',name:'出闸核对',x:77,y:61},{id:'delivery',name:'工厂拆箱',x:88,y:87},{id:'return',name:'空箱归还',x:53,y:87}];
const equipments=[{id:'eq-sts',label:'岸桥',x:30,y:31},{id:'eq-rtg',label:'场桥',x:52,y:24},{id:'eq-truck',label:'集卡',x:56,y:55},{id:'eq-gate',label:'闸口设备',x:78,y:57}];
const systems=[{id:'container-tos',label:'集装箱 TOS',x:55,y:15},{id:'gate',label:'闸口系统',x:77,y:61},{id:'data-exchange',label:'数据交换',x:82,y:15},{id:'single-window',label:'外部业务与口岸',x:86,y:37}];
---
<div class="journey-map" data-journey-map data-layer="cargo">
<div class="journey-map-kicker"><span><i></i>港口到内陆 · 教学地图</span><span>布局与距离不按比例</span></div>
<svg class="journey-landscape" viewBox="0 0 1200 720" fill="none" role="img" aria-label="进口集装箱教学地图：船舶经岸桥进入堆场，装车后通过闸口前往工厂，拆箱后箱体送到指定空箱堆场。">
<defs><pattern id="journey-water" x="0" y="0" width="46" height="27" patternUnits="userSpaceOnUse"><path d="M4 15q7-4 14 0t14 0" stroke="#9eaeb0" stroke-width=".8"/></pattern><pattern id="journey-grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".6" fill="#c7cec5"/></pattern><marker id="journey-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="m1 1 7 4-7 4" stroke="#315c5c" stroke-width="1.5"/></marker></defs>
<rect width="1200" height="720" fill="#f4f4ed"/><path d="M0 0h270l-12 125 37 130-27 235H0z" fill="#e2e9e7"/><path d="M0 0h270l-12 125 37 130-27 235H0z" fill="url(#journey-water)"/><path d="m270 0-12 125 37 130-27 235" stroke="#fffdf4" stroke-width="17"/>
<path d="M0 565h1200" stroke="#afb9b0" stroke-dasharray="5 7"/><path d="M0 566h1200v154H0z" fill="#ecefe6"/>
<path d="M400 70v80l-40 140 30 175h600V75M445 150h540M445 350h540M865 465l170 146H650" stroke="#dce1d9" stroke-width="29" stroke-linejoin="round"/><path d="M400 70v80l-40 140 30 175h600V75M445 150h540M445 350h540M865 465l170 146H650" stroke="#fffdf8" stroke-width="2" stroke-dasharray="9 11" stroke-linejoin="round"/>
<rect x="455" y="175" width="395" height="140" fill="url(#journey-grid)"/>
<g class="map-drawing" stroke="#52625e" stroke-width="1.4" stroke-linejoin="round">
<g transform="translate(85 292) rotate(-13 60 90)"><path d="M0 3 53-28 116 5v165l-57 40L0 170z" fill="#4b5e60"/><path d="m10 10 43-23 52 23v153l-47 32-48-32z" fill="#fafaf4"/>{[0,1].map(c=>[0,1].map(r=><g transform={'translate('+(19+c*42)+','+(15+r*58)+')'}><rect width="35" height="49" fill={c===r?'#bac7be':'#d4d9d0'}/><path d="M8 3v43M16 3v43M24 3v43" stroke="#7d8d85" stroke-width=".8"/></g>))}<path d="M20 140h75v28H20z" fill="#d9e1d7"/><path d="M27 148h61" stroke-width="5"/></g>
{[0,1].map(i=><g transform={'translate(265 '+(140+i*127)+')'}><path d="M0 160V40h92v120M-10 160h26m68 0h24" stroke-width="5"/><path d="M-90 40h216v-9H-90z" fill="#e6e9df"/><path d="M42-14v45m-132 0L42-14l84 45M2 40l43 120m43-120L45 160" stroke-width="2"/><path d="M-45 42v64m15-64v64M-52 106h30" stroke-width="2"/><rect x="-59" y="112" width="44" height="29" fill="#d2ddd3"/><path d="M-49 117v20m9-20v20m9-20v20"/></g>)}
{[0,1,2,3,4].map(c=>[0,1].map(r=><g transform={'translate('+(470+c*70)+','+(190+r*51)+')'}><path d="M0 9 14 0h46l-14 9z" fill="#e5e9df"/><path d="M0 9h46v32H0z" fill={(c+r)%2?'#d0d8ce':'#c0cec4'}/><path d="m46 9 14-9v32l-14 9z" fill="#aebfb4"/><path d="M8 14v22m9-22v22m9-22v22m9-22v22" stroke-width=".7"/></g>))}
<g transform="translate(517 157)"><path d="M0 155V0h225v155M11 155V13h202v142" stroke-width="3"/><path d="M-4 0h234v13H-4z" fill="#f7f8f1"/><rect x="94" y="14" width="37" height="11" fill="#9eafa5"/><path d="M111 25v60"/><path d="M91 85h40" stroke-width="3"/>{[0,12,214,226].map(x=><circle cx={x} cy="156" r="5" fill="#52625e"/>)}</g>
<g transform="translate(592 403)"><path d="M0 15h83v34H0z" fill="#d4dcd1"/><path d="M83 28h31l17 20v13H83z" fill="#fafbf5"/><path d="M91 32h18l9 12H91z" fill="#c4d1c7"/><path d="M0 53h85" stroke-width="4"/>{[10,25,91,118].map(x=><circle cx={x} cy="61" r="6" fill="#52625e"/>)}<path d="M8 20v24m12-24v24m12-24v24m12-24v24m12-24v24m12-24v24" stroke-width=".8"/></g>
<g transform="translate(883 385)"><path d="M0 77V0h115v77M-5-4h125v11H-5z" fill="#eef0e8" stroke-width="3"/><rect x="-43" y="40" width="29" height="38" fill="#fafbf5"/><path d="M-37 47h17v13h-17z" fill="#acbfb6"/><path d="M15 57v22m0-22h77" stroke-width="5"/><path d="m22 54 8 7m7-7 8 7m7-7 8 7m7-7 8 7" stroke="#f7f8f1" stroke-width="3"/><rect x="10" y="8" width="14" height="7" fill="#52625e"/><rect x="82" y="8" width="14" height="7" fill="#52625e"/></g>
<g transform="translate(902 48)"><path d="M0 18 24 0h123l-24 18z" fill="#d5dfd4"/><path d="M0 18h123v66H0z" fill="#fafbf5"/><path d="m123 18 24-18v66l-24 18z" fill="#c3d2c5"/>{[0,1,2,3].map(i=><path d={'M'+(12+i*26)+' 33h15v14h-15zM'+(12+i*26)+' 55h15v14h-15z'} fill="#819e92"/>)}<path d="M55 0v-18m-9 7h18"/></g>
<g transform="translate(969 575)"><path d="M0 30 30 5v25L60 5v25L90 5v25h58v73H0z" fill="#f6f7f0"/><path d="M100 30V0h14v30" fill="#b7c8bc"/><path d="M12 45h115v20H12z" fill="#c1cec1"/><path d="M22 45v20m23-20v20m23-20v20m23-20v20m23-20v20"/><path d="M58 79h37v24H58z" fill="#8fa697"/></g>
<g transform="translate(512 582)">{[0,1,2].map(c=><g transform={'translate('+(c*55)+' 0)'}><rect y="10" width="49" height="38" fill="#f4f6ed"/><path d="m0 10 12-9h49l-12 9m0 0 12-9v38l-12 9" fill="#cad6c9"/><path d="M8 15v27m9-27v27m9-27v27m9-27v27"/></g>)}<path d="M-20 70h216" stroke="#a4b8a5"/></g>
</g>
<g fill="#6a8074" font-size="13" font-family="sans-serif"><text x="62" y="128" letter-spacing="3">水域 · 航道</text><text x="640" y="332" letter-spacing="2">集装箱箱区</text><text x="919" y="145">计划 / 中控</text><text x="28" y="548">码头范围示意</text><text x="28" y="602">港外陆运</text><text x="28" y="628">货物与箱体继续分流</text></g>
<g class="journey-cargo-lines"><path d="M144 353 372 266 624 245 660 439H924L1056 626H636" stroke="#315c5c" stroke-width="3" stroke-dasharray="6 8" stroke-linejoin="round" opacity=".7" marker-end="url(#journey-arrow)"/></g>
<g class="journey-system-lines" stroke="#355e5a" stroke-width="2" stroke-dasharray="5 7"><path d="M372 266 660 108M624 245 660 108M660 439 660 108H984V266M924 439 984 108"/></g>
</svg>
<div class="journey-moving-box" style="left:12%;top:49%" aria-hidden="true"><span>示例箱 A</span><svg viewBox="0 0 50 36" fill="none"><path d="m2 10 11-8h34l-11 8H2v23h34l11-8V2M36 10v23" fill="#244e50" stroke="#fff" stroke-width="1.5"/><path d="M8 15v13m7-13v13m7-13v13m7-13v13" stroke="#cee0d2" stroke-width="1"/></svg></div>
<div class="journey-step-spots">{stops.map((s,i)=><button class="journey-spot" data-journey-step={i} data-map-x={s.x} data-map-y={s.y} style={'left:'+s.x+'%;top:'+s.y+'%'} aria-label={'地图第'+(i+1)+'站：'+s.name} aria-pressed={i===0?'true':'false'}><span>{String(i+1).padStart(2,'0')}</span><strong>{s.name}</strong></button>)}</div>
<div class="journey-equipment-spots">{equipments.map(e=><a class="journey-layer-spot" href={base+'knowledge/'+e.id+'/'} style={'left:'+e.x+'%;top:'+e.y+'%'}>{e.label}<span>看结构 ↗</span></a>)}</div>
<div class="journey-system-spots">{systems.map(s=><a class="journey-layer-spot system" href={base+'systems/#system-'+s.id} style={'left:'+s.x+'%;top:'+s.y+'%'}>{s.label}<span>看职责 ↗</span></a>)}</div>
</div>
